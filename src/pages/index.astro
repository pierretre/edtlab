---
// For static sites, we'll redirect to English by default
// Client-side language detection will handle browser preferences
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>EDT Research Program - Redirecting</title>
        <meta
            name="description"
            content="Redirecting to EDT Research Program website"
        />
        <meta name="robots" content="noindex" />
        <link rel="canonical" href="/en/" />

        <!-- Accessible redirect without meta refresh -->
        <script>
            // Immediate client-side language detection for static sites
            (function () {
                const userLang =
                    navigator.language || navigator.languages?.[0] || "en";
                const preferredLang = userLang.startsWith("fr") ? "fr" : "en";

                // Immediate redirect for better accessibility
                if (window.location.pathname === "/") {
                    window.location.replace(`/${preferredLang}/`);
                }
            })();
        </script>

        <!-- Fallback meta refresh with longer delay for accessibility compliance -->
        <meta http-equiv="refresh" content="2;url=/en/" />

        <style>
            body {
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    sans-serif;
                max-width: 600px;
                margin: 2rem auto;
                padding: 1rem;
                text-align: center;
                line-height: 1.6;
            }

            .redirect-message {
                background: #f0f9ff;
                border: 1px solid #0ea5e9;
                border-radius: 0.5rem;
                padding: 1.5rem;
                margin: 2rem 0;
            }

            .language-links {
                display: flex;
                gap: 1rem;
                justify-content: center;
                margin-top: 1rem;
            }

            .language-links a {
                display: inline-block;
                padding: 0.75rem 1.5rem;
                background: #0ea5e9;
                color: white;
                text-decoration: none;
                border-radius: 0.375rem;
                font-weight: 500;
                transition: background-color 0.2s;
            }

            .language-links a:hover,
            .language-links a:focus {
                background: #0284c7;
                outline: 2px solid #0ea5e9;
                outline-offset: 2px;
            }

            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }
        </style>
    </head>
    <body>
        <main>
            <h1>EDT Research Program</h1>

            <div class="redirect-message">
                <p>
                    <span class="sr-only"
                        >Automatic redirection in progress.</span
                    >
                    You are being redirected to the EDT Research Program website.
                </p>

                <p>
                    If you are not redirected automatically, please choose your
                    language:
                </p>

                <div class="language-links">
                    <a href="/en/" hreflang="en">
                        English
                        <span class="sr-only"
                            >(English version of the website)</span
                        >
                    </a>
                    <a href="/fr/" hreflang="fr">
                        Français
                        <span class="sr-only"
                            >(Version française du site web)</span
                        >
                    </a>
                </div>
            </div>

            <p>
                <small>
                    Redirecting from <code>/</code> to <code>/en/</code>
                </small>
            </p>
        </main>
    </body>
</html>
