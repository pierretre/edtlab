---
// For static sites, we'll redirect to English by default
// Client-side language detection will handle browser preferences
---

<html>
    <head>
        <meta charset="utf-8" />
        <title>EDT Research Program</title>
        <meta http-equiv="refresh" content="0; url=/en/" />
        <script>
            // Client-side language detection for static sites
            const userLang = navigator.language || navigator.languages[0];
            const preferredLang = userLang.startsWith("fr") ? "fr" : "en";
            window.location.href = `/${preferredLang}/`;
        </script>
    </head>
    <body>
        <p>
            Redirecting... <a href="/en/">English</a> | <a href="/fr/"
                >Français</a>
        </p>
    </body>
</html>
