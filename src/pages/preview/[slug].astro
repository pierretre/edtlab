---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations } from "@i18n/utils";

// SSR — no prerender, token is verified on every request
const { slug } = Astro.params;
const token = Astro.url.searchParams.get('token');

// Find the UC by slug (partial match — e.g. slug=uc-05 matches uc-05-r0.1-fr)
const allUCs = await getCollection("use-cases");
const uc = allUCs.find(u => u.slug.includes(slug || ''));

// 404 if not found, no token, or wrong token
if (!uc || !token || !uc.data.previewToken || token !== uc.data.previewToken) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

const { Content } = await uc.render();
const lang = (uc.data.lang || 'fr') as "en" | "fr";
const t = useTranslations(lang);
---

<BaseLayout
    title={`[PREVIEW] ${uc.data.title}`}
    description={uc.data.summary}
    lang={lang}
    showBreadcrumb={false}
    noindex={true}
>
    <!-- Draft banner — fixed above navbar -->
    <div id="preview-banner" style="position:fixed; top:0; left:0; right:0; z-index:100; background:#f59e0b; color:white; text-align:center; padding:12px 16px; font-weight:bold; font-size:16px; box-shadow:0 2px 8px rgba(0,0,0,0.2);">
        DOCUMENT EN COURS DE VALIDATION — NON PUBLIÉ
    </div>

    <!-- Push content below the banner -->
    <style>
        #navigation { margin-top: 48px !important; }
    </style>

    <!-- Content wrapper (mirrors PageLayout structure) -->
    <div class="container mx-auto px-8 lg:px-4 max-w-6xl mb-16">
        <div class="flex flex-col lg:flex-row gap-8">
            <main class="flex-1 min-w-0">

                <!-- Back link -->
                <div class="mb-6">
                    <a
                        href={`/${lang}/use-cases`}
                        class="inline-flex items-center text-primary-600 hover:text-primary-800 text-sm font-medium"
                    >
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                        {lang === 'fr' ? 'Retour aux cas d\'utilisation' : 'Back to Use Cases'}
                    </a>
                </div>

                <!-- Header -->
                <header class="mb-8">
                    {uc.data.photo && (
                        <div class="uc-cover-image mb-6 rounded-lg overflow-hidden">
                            <img
                                src={uc.data.photo}
                                alt={uc.data.title}
                                class="w-full h-64 object-cover"
                                loading="lazy"
                            />
                        </div>
                    )}

                    <div class="flex items-baseline justify-between mb-2">
                        <h1 class="text-4xl font-bold text-gray-900">
                            {uc.data.title}
                        </h1>
                        {uc.data.version && <span class="text-sm text-gray-400">v{uc.data.version}</span>}
                    </div>

                    <!-- Authors / Contacts — academic style -->
                    {uc.data.contacts && uc.data.contacts.length > 0 && (
                        <p class="text-base text-gray-600 mb-1 uc-contacts-line">
                            {uc.data.contacts.map((c: any, i: number) => (
                                <span>
                                    <span class="font-medium text-gray-800">{c.name}</span>
                                    {c.org && <span class="text-gray-500"> ({c.org})</span>}
                                    {c.email && <a href={`mailto:${c.email}`} class="text-primary-600 hover:underline text-sm ml-1">{c.email}</a>}
                                    {i < uc.data.contacts.length - 1 && <span class="text-gray-400 mx-1">·</span>}
                                </span>
                            ))}
                        </p>
                    )}

                    {uc.data.approvedBy && (
                        <p class="text-sm text-gray-500 italic mb-4">
                            Autorisation de mise à disposition accordée par {uc.data.approvedBy.name}, {uc.data.approvedBy.title}, {uc.data.approvedBy.org}, le {uc.data.approvedBy.date instanceof Date ? uc.data.approvedBy.date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB') : uc.data.approvedBy.date}.
                        </p>
                    )}

                    <div class="flex flex-wrap gap-4 text-sm text-gray-500 mb-4">
                        <span class="uc-domain-badge inline-flex items-center px-2 py-0.5 rounded bg-gray-100 text-gray-700 cursor-pointer" title="Double-cliquez pour changer le domaine" data-field="domain" data-value={uc.data.domain || ''}>
                            {uc.data.domain || 'Domaine ?'}
                        </span>
                        <span class="uc-maturity-badge inline-flex items-center px-2 py-0.5 rounded bg-blue-100 text-blue-800 cursor-pointer" title="Double-cliquez pour changer la maturité" data-field="maturity" data-value={uc.data.maturity || ''}>
                            {uc.data.maturity || 'Maturité ?'}
                        </span>
                    </div>

                </header>

                <!-- Body content -->
                <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline">
                    <Content />

                    <!-- References from frontmatter — displayed after body markdown -->
                    {uc.data.references && uc.data.references.length > 0 && (
                        <section id="references-section">
                            <h2>Références</h2>
                            <ul data-ref-zone="true" style="cursor: pointer; border: 1px dashed transparent; border-radius: 6px; padding: 4px 8px; margin: 4px 0; transition: all 0.15s;">
                                {uc.data.references.map((ref: any) => (
                                    <li>
                                        <strong>{ref.title}</strong>
                                        {ref.venue && <span> — {ref.venue}</span>}
                                        {ref.url && (
                                            <span>
                                                {' '}
                                                <a href={ref.url} target="_blank" rel="noopener noreferrer">lien</a>
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )}
                </div>

                <!-- Contacts section removed — displayed under title in academic style -->

                <!-- Approval / Correction section -->
                <section class="mt-12 border-t-2 border-gray-200 pt-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Validation</h2>

                    <!-- Approval form -->
                    <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6" id="approval-form">
                        <h3 class="text-lg font-semibold text-green-800 mb-4">Approuver la mise à disposition</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Nom complet</label>
                                <input type="text" id="approve-name" placeholder="Nom Prénom" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                <input type="email" id="approve-email" placeholder="prenom.nom@org.fr" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Poste / Fonction</label>
                                <input type="text" id="approve-title" placeholder="Responsable Projet" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Organisation</label>
                                <input type="text" id="approve-org" placeholder="Cetim" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mb-4">Un email de confirmation sera envoyé à l'adresse indiquée. La publication ne sera effective qu'après confirmation.</p>
                        <div class="flex items-center gap-2 mb-4">
                            <input type="checkbox" id="approve-checkbox" class="w-4 h-4" />
                            <label for="approve-checkbox" class="text-sm text-gray-700">J'autorise la mise à disposition de ce cas d'usage sur le site edtlab.fr</label>
                        </div>
                        <button id="approve-btn" disabled style="padding:10px 24px; background:#d1d5db; color:#6b7280; border:none; border-radius:8px; font-weight:600; font-size:15px; cursor:not-allowed;">
                            Signer et approuver
                        </button>
                    </div>


                </section>

            </main>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const proseDiv = document.querySelector('.prose');
        if (!proseDiv) return;

        const urlParts = window.location.pathname.split('/');
        const slug = urlParts[urlParts.length - 1];
        const token = new URLSearchParams(window.location.search).get('token');

        const sectionHelps: Record<string, string> = {
            'Résumé': 'Décrivez en 3-5 phrases le cas d\'usage : quel système physique, quel jumeau numérique, quels objectifs.',
            'MC1': 'Décrivez le système physique étudié (le jumeau physique), son environnement et les agents/opérateurs présents.',
            'MC2': 'Listez les actionneurs et mécanismes par lesquels le jumeau numérique peut agir sur le système physique.',
            'MC3': 'Listez les capteurs et mécanismes par lesquels le système physique transmet des données au jumeau numérique.',
            'MC4': 'Décrivez les données transmises du système physique vers le jumeau numérique : protocoles, fréquences, types de données.',
            'MC5': 'Décrivez les données transmises du jumeau numérique vers le système physique : commandes, alertes, paramètres.',
            'MC6': 'Listez les services fournis par le jumeau numérique : simulation, optimisation, détection, visualisation, etc.',
            'MC7': 'Précisez les échelles de temps : synchronisation temps réel, plus rapide, plus lent que le système physique.',
            'MC8': 'Le JN est-il composé de sous-jumeaux ? Architecture centralisée ou décentralisée ?',
            'MC9': 'Quelles phases du cycle de vie sont couvertes ? Conception, fabrication, exploitation, maintenance ?',
            'MC10': 'Décrivez les modèles utilisés (physiques, données, hybrides) et les données d\'entrée/sortie.',
            'MC11': 'Listez les outils, frameworks et plateformes utilisés pour réaliser les services du JN.',
            'MC12': 'Comment les modèles, données, outils et services sont-ils orchestrés ensemble ?',
            'MC13': 'Décrivez la méthodologie de développement du JN, ses jalons et ses évolutions prévues.',
            'MC14': 'Quelle est la précision des modèles ? Comment sont-ils validés et calibrés ?',
            'MC15': 'Quels protocoles réseau et architectures de communication sont utilisés entre le physique et le virtuel ?',
            'MC16': 'Où est hébergé le JN ? Local, cloud, plateforme dédiée ?',
            'MC17': 'Quels insights et aides à la décision le JN fournit-il aux opérateurs ?',
            'MC18': 'Le JN échange-t-il des données avec d\'autres systèmes (SCADA, autres JN, SI) ?',
            'MC19': 'Y a-t-il des considérations de propriété ou confidentialité des données ?',
            'MC20': 'Quelles normes sont suivies (FMI, AAS, ISO-23247, etc.) ?',
            'MC21': 'Y a-t-il des considérations de cybersécurité ou de sûreté de fonctionnement ?',
            'Données': 'Listez les liens vers les jeux de données, dépôts de code, APIs associés à ce cas d\'usage.',
            'Références': 'Listez les publications scientifiques et rapports liés à ce cas d\'usage spécifiquement.',
        };

        // Intro/résumé — first elements before any h2 or hr
        const introNodes: Element[] = [];
        let child = proseDiv.firstElementChild;
        while (child && child.tagName !== 'H2' && child.tagName !== 'HR') {
            introNodes.push(child);
            child = child.nextElementSibling;
        }

        if (introNodes.length > 0) {
            // Guide
            const introGuide = document.createElement('div');
            introGuide.style.cssText = 'background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:10px 14px; margin:0 0 8px; font-size:13px; color:#1e40af;';
            introGuide.innerHTML = '<strong>Guide :</strong> Décrivez en 3-5 phrases le cas d\'usage : quel système physique, quel jumeau numérique, quels objectifs.';
            proseDiv.insertBefore(introGuide, introNodes[0]);

            // Wrap intro in editable zone
            const introZone = document.createElement('div');
            introZone.style.cssText = 'cursor:pointer; border:1px dashed transparent; border-radius:6px; padding:4px 8px; margin:4px 0; transition:all 0.15s;';
            introZone.title = 'Double-cliquez pour modifier le résumé';
            introZone.addEventListener('mouseenter', () => { introZone.style.borderColor = '#93c5fd'; introZone.style.background = '#f8fafc'; });
            introZone.addEventListener('mouseleave', () => { introZone.style.borderColor = 'transparent'; introZone.style.background = 'transparent'; });

            proseDiv.insertBefore(introZone, introNodes[0]);
            introNodes.forEach(n => introZone.appendChild(n));

            introZone.addEventListener('dblclick', async () => {
                let markdown = '';
                try {
                    const res = await fetch(`/api/uc-section?slug=${slug}&token=${token}&sectionId=intro`);
                    if (res.ok) {
                        const data = await res.json();
                        markdown = data.markdown || '';
                    }
                } catch (e) {}

                introZone.style.display = 'none';

                const editor = document.createElement('div');
                editor.style.cssText = 'margin:8px 0;';

                const hint = document.createElement('p');
                hint.textContent = 'Édition en Markdown';
                hint.style.cssText = 'font-size:12px; color:#6b7280; margin-bottom:6px;';

                const textarea = document.createElement('textarea');
                textarea.value = markdown;
                textarea.style.cssText = 'width:100%; min-height:120px; padding:12px; border:2px solid #3b82f6; border-radius:8px; font-family:ui-monospace,monospace; font-size:14px; line-height:1.6; resize:vertical;';

                const btnContainer = document.createElement('div');
                btnContainer.style.cssText = 'display:flex; gap:8px; margin-top:8px;';

                const saveBtn = document.createElement('button');
                saveBtn.textContent = 'Enregistrer';
                saveBtn.style.cssText = 'padding:8px 20px; background:#2563eb; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600; font-size:14px;';

                const cancelBtn = document.createElement('button');
                cancelBtn.textContent = 'Annuler';
                cancelBtn.style.cssText = 'padding:8px 20px; background:#e5e7eb; color:#374151; border:1px solid #d1d5db; border-radius:6px; cursor:pointer; font-size:14px;';

                btnContainer.appendChild(saveBtn);
                btnContainer.appendChild(cancelBtn);
                editor.appendChild(hint);
                editor.appendChild(textarea);
                editor.appendChild(btnContainer);
                introZone.after(editor);
                textarea.focus();

                cancelBtn.addEventListener('click', () => { editor.remove(); introZone.style.display = ''; });

                saveBtn.addEventListener('click', async () => {
                    saveBtn.textContent = 'Enregistrement...';
                    saveBtn.disabled = true;
                    try {
                        const res = await fetch('/api/uc-edit', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ slug, token, sectionId: 'intro', content: textarea.value })
                        });
                        if (res.ok) {
                            saveBtn.textContent = '✓ Enregistré';
                            saveBtn.style.background = '#10b981';
                            setTimeout(() => window.location.reload(), 1500);
                        } else {
                            const err = await res.json();
                            alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                            saveBtn.textContent = 'Enregistrer'; saveBtn.disabled = false;
                        }
                    } catch (e) { alert('Erreur réseau'); saveBtn.textContent = 'Enregistrer'; saveBtn.disabled = false; }
                });
            });
        }

        // Headings to skip (section titles that are not editable sections)
        const SKIP_HEADINGS = ['Caractérisation du Jumeau Numérique'];

        // Process h2 and h3 headings in .prose
        const headings = proseDiv.querySelectorAll('h2, h3');

        headings.forEach(heading => {
            const text = (heading.textContent || '').trim();

            // Skip non-editable headings
            if (SKIP_HEADINGS.some(skip => text.includes(skip))) return;

            // Determine sectionId
            let sectionId: string;
            if (heading.tagName === 'H3') {
                const mcMatch = text.match(/^(MC\d+)/);
                if (!mcMatch) return;
                sectionId = mcMatch[1];
            } else {
                // h2 — use heading text as-is (Résumé, Données, Références)
                sectionId = text;
            }

            // Collect content nodes until the next heading or HR
            const contentNodes: Element[] = [];
            let sibling = heading.nextElementSibling;
            while (sibling && sibling.tagName !== 'H3' && sibling.tagName !== 'H2' && sibling.tagName !== 'HR') {
                contentNodes.push(sibling);
                sibling = sibling.nextElementSibling;
            }

            // Insert help hint after the heading (before content)
            const helpText = sectionHelps[sectionId];
            if (helpText) {
                const helpDiv = document.createElement('div');
                helpDiv.style.cssText = 'background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:10px 14px; margin:8px 0 4px; font-size:13px; color:#1e40af;';
                helpDiv.innerHTML = `<strong>Guide :</strong> ${helpText}`;
                heading.after(helpDiv);
            }

            // Wrap content nodes in an editable zone with hover effect
            const editZone = document.createElement('div');
            editZone.style.cssText = 'cursor:pointer; border:1px dashed transparent; border-radius:6px; padding:4px 8px; margin:4px 0; transition:all 0.15s;';
            editZone.title = 'Double-cliquez pour modifier';
            
            // Mark Références zone with data-attribute for T004 custom handler
            if (sectionId === 'Références') {
                editZone.setAttribute('data-ref-zone', 'true');
            }
            
            editZone.addEventListener('mouseenter', () => {
                editZone.style.borderColor = '#93c5fd';
                editZone.style.background = '#f8fafc';
            });
            editZone.addEventListener('mouseleave', () => {
                editZone.style.borderColor = 'transparent';
                editZone.style.background = 'transparent';
            });

            // Move content nodes into the edit zone
            const parent = contentNodes[0]?.parentNode;
            if (parent && contentNodes.length > 0) {
                parent.insertBefore(editZone, contentNodes[0]);
                contentNodes.forEach(n => editZone.appendChild(n));
            }

            // Double-click to edit
            editZone.addEventListener('dblclick', async () => {
                // Fetch markdown source from API
                let markdown = '';
                try {
                    const res = await fetch(`/api/uc-section?slug=${slug}&token=${token}&sectionId=${encodeURIComponent(sectionId)}`);
                    if (res.ok) {
                        const data = await res.json();
                        markdown = data.markdown || '';
                    }
                } catch (e) { /* fallback to empty */ }

                editZone.style.display = 'none';

                const editor = document.createElement('div');
                editor.style.cssText = 'margin:8px 0;';

                const hint = document.createElement('p');
                hint.textContent = 'Édition en Markdown — le gras (**texte**), les listes (- item) et les liens sont supportés.';
                hint.style.cssText = 'font-size:12px; color:#6b7280; margin-bottom:6px;';

                const textarea = document.createElement('textarea');
                textarea.value = markdown;
                textarea.style.cssText = 'width:100%; min-height:180px; padding:12px; border:2px solid #3b82f6; border-radius:8px; font-family:ui-monospace,monospace; font-size:14px; line-height:1.6; resize:vertical;';

                const btnContainer = document.createElement('div');
                btnContainer.style.cssText = 'display:flex; gap:8px; margin-top:8px;';

                const saveBtn = document.createElement('button');
                saveBtn.textContent = 'Enregistrer';
                saveBtn.style.cssText = 'padding:8px 20px; background:#2563eb; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600; font-size:14px;';

                const cancelBtn = document.createElement('button');
                cancelBtn.textContent = 'Annuler';
                cancelBtn.style.cssText = 'padding:8px 20px; background:#e5e7eb; color:#374151; border:1px solid #d1d5db; border-radius:6px; cursor:pointer; font-size:14px;';

                btnContainer.appendChild(saveBtn);
                btnContainer.appendChild(cancelBtn);
                editor.appendChild(hint);
                editor.appendChild(textarea);
                editor.appendChild(btnContainer);

                editZone.after(editor);
                textarea.focus();

                cancelBtn.addEventListener('click', () => {
                    editor.remove();
                    editZone.style.display = '';
                });

                saveBtn.addEventListener('click', async () => {
                    saveBtn.textContent = 'Enregistrement...';
                    saveBtn.disabled = true;

                    try {
                        const res = await fetch('/api/uc-edit', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ slug, token, sectionId, content: textarea.value })
                        });

                        if (res.ok) {
                            saveBtn.textContent = '✓ Enregistré';
                            saveBtn.style.background = '#10b981';
                            setTimeout(() => window.location.reload(), 1500);
                        } else {
                            const err = await res.json();
                            alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                            saveBtn.textContent = 'Enregistrer';
                            saveBtn.disabled = false;
                        }
                    } catch (e) {
                        alert('Erreur réseau');
                        saveBtn.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                    }
                });
            });
        });

        // Image upload — icon overlay on double-click
        const imgSection = document.querySelector('.uc-cover-image') as HTMLElement;
        if (imgSection) {
            imgSection.style.position = 'relative';
            imgSection.style.cursor = 'pointer';

            // Camera icon overlay
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:absolute; top:0; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0); transition:background 0.2s; pointer-events:none;';
            const icon = document.createElement('div');
            icon.innerHTML = '📷';
            icon.style.cssText = 'font-size:32px; opacity:0; transition:opacity 0.2s; background:rgba(255,255,255,0.85); border-radius:50%; width:56px; height:56px; display:flex; align-items:center; justify-content:center;';
            overlay.appendChild(icon);
            imgSection.appendChild(overlay);

            imgSection.addEventListener('mouseenter', () => {
                overlay.style.background = 'rgba(0,0,0,0.15)';
                icon.style.opacity = '1';
            });
            imgSection.addEventListener('mouseleave', () => {
                overlay.style.background = 'rgba(0,0,0,0)';
                icon.style.opacity = '0';
            });

            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = 'image/*';
            fileInput.style.display = 'none';
            document.body.appendChild(fileInput);

            imgSection.addEventListener('dblclick', () => fileInput.click());

            fileInput.addEventListener('change', async () => {
                const file = fileInput.files?.[0];
                if (!file) return;

                icon.innerHTML = '⏳';

                const formData = new FormData();
                formData.append('image', file);
                formData.append('slug', slug);
                formData.append('token', token || '');

                try {
                    const res = await fetch('/api/uc-upload-image', { method: 'POST', body: formData });
                    if (res.ok) {
                        icon.innerHTML = '✓';
                        icon.style.background = '#10b981';
                        icon.style.color = 'white';
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        const err = await res.json();
                        alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                        icon.innerHTML = '📷';
                    }
                } catch (e) {
                    alert('Erreur réseau');
                    icon.innerHTML = '📷';
                }
            });
        }

        // Domain & Maturity badges — double-click to select from list
        const metaOptions: Record<string, {label: string, value: string}[]> = {
            domain: [
                { label: 'Energy', value: 'energy' },
                { label: 'Geospatial', value: 'geospatial' },
                { label: 'Industrial Engineering', value: 'industrial-engineering' },
                { label: 'Maritime', value: 'maritime' },
                { label: 'Telecommunications', value: 'telecommunications' },
                { label: 'Environment', value: 'environment' },
                { label: 'Health', value: 'health' },
                { label: 'Robotics', value: 'robotics' },
                { label: 'Agriculture', value: 'agriculture' },
                { label: 'Other', value: 'other' },
            ],
            maturity: [
                { label: 'Concept', value: 'concept' },
                { label: 'Proof of Concept (PoC)', value: 'poc' },
                { label: 'Prototype', value: 'prototype' },
                { label: 'Operational', value: 'operational' },
            ]
        };

        document.querySelectorAll('.uc-domain-badge, .uc-maturity-badge').forEach(badge => {
            badge.addEventListener('dblclick', () => {
                const field = (badge as HTMLElement).dataset.field || '';
                const currentValue = (badge as HTMLElement).dataset.value || '';
                const options = metaOptions[field];
                if (!options) return;

                const dropdown = document.createElement('select');
                dropdown.style.cssText = 'padding:4px 8px; border:2px solid #3b82f6; border-radius:6px; font-size:13px; background:white;';
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt.value;
                    option.textContent = opt.label;
                    if (opt.value === currentValue) option.selected = true;
                    dropdown.appendChild(option);
                });

                badge.replaceWith(dropdown);
                dropdown.focus();

                const save = async () => {
                    const newValue = dropdown.value;
                    try {
                        const res = await fetch('/api/uc-edit-meta', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ slug, token, field, value: newValue })
                        });
                        if (res.ok) {
                            setTimeout(() => window.location.reload(), 500);
                        } else {
                            alert('Erreur lors de la sauvegarde');
                        }
                    } catch (e) {
                        alert('Erreur réseau');
                    }
                };

                dropdown.addEventListener('change', save);
                dropdown.addEventListener('blur', () => {
                    // If no change, reload to restore badge
                    setTimeout(() => { if (document.contains(dropdown)) window.location.reload(); }, 200);
                });
            });
        });

        // Approval checkbox enables button
        const approveCheckbox = document.getElementById('approve-checkbox') as HTMLInputElement;
        const approveBtn = document.getElementById('approve-btn') as HTMLButtonElement;
        if (approveCheckbox && approveBtn) {
            approveCheckbox.addEventListener('change', () => {
                if (approveCheckbox.checked) {
                    approveBtn.disabled = false;
                    approveBtn.style.cssText = 'padding:10px 24px; background:#16a34a; color:white; border:none; border-radius:8px; font-weight:600; font-size:15px; cursor:pointer;';
                } else {
                    approveBtn.disabled = true;
                    approveBtn.style.cssText = 'padding:10px 24px; background:#d1d5db; color:#6b7280; border:none; border-radius:8px; font-weight:600; font-size:15px; cursor:not-allowed;';
                }
            });

            approveBtn.addEventListener('click', async () => {
                const name = (document.getElementById('approve-name') as HTMLInputElement).value.trim();
                const email = (document.getElementById('approve-email') as HTMLInputElement).value.trim();
                const title = (document.getElementById('approve-title') as HTMLInputElement).value.trim();
                const org = (document.getElementById('approve-org') as HTMLInputElement).value.trim();

                if (!name || !email || !title || !org) {
                    alert('Veuillez remplir tous les champs (nom, email, poste, organisation).');
                    return;
                }

                approveBtn.textContent = 'Signature en cours...';
                approveBtn.disabled = true;

                try {
                    const res = await fetch('/api/uc-approve', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ slug, token, name, email, title, org })
                    });
                    if (res.ok) {
                        approveBtn.textContent = '✓ Signé — Email de confirmation envoyé';
                        approveBtn.style.background = '#10b981';
                        // Hide the banner after a delay
                        const banner = document.getElementById('preview-banner');
                        if (banner) {
                            banner.textContent = '✓ DOCUMENT SIGNÉ — EN ATTENTE DE CONFIRMATION PAR EMAIL';
                            banner.style.background = '#2563eb';
                        }
                        setTimeout(() => window.location.reload(), 2000);
                    } else {
                        const err = await res.json();
                        alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                        approveBtn.textContent = 'Signer et approuver';
                        approveBtn.disabled = false;
                    }
                } catch (e) {
                    alert('Erreur réseau');
                    approveBtn.textContent = 'Signer et approuver';
                    approveBtn.disabled = false;
                }
            });
        }

        // Contacts edit — double-click on authors line
        const contactsSection = document.querySelector('.uc-contacts-line');
        if (contactsSection) {
            (contactsSection as HTMLElement).style.cursor = 'pointer';
            (contactsSection as HTMLElement).title = 'Double-cliquez pour modifier les contacts';
            contactsSection.addEventListener('mouseenter', () => {
                (contactsSection as HTMLElement).style.background = '#f8fafc';
                (contactsSection as HTMLElement).style.borderRadius = '6px';
            });
            contactsSection.addEventListener('mouseleave', () => {
                (contactsSection as HTMLElement).style.background = '';
            });

            contactsSection.addEventListener('dblclick', async () => {
                // Fetch current contacts
                let contacts: any[] = [];
                try {
                    const res = await fetch(`/api/uc-edit-contacts?slug=${slug}&token=${token}`);
                    if (res.ok) {
                        const data = await res.json();
                        contacts = data.contacts || [];
                    }
                } catch (e) {}

                // Ensure at least one empty row
                if (contacts.length === 0) contacts.push({ name: '', org: '', email: '', role: '' });

                const editor = document.createElement('div');
                editor.style.cssText = 'margin-top:12px;';

                function renderRows() {
                    editor.innerHTML = '';
                    contacts.forEach((c: any, i: number) => {
                        const row = document.createElement('div');
                        row.style.cssText = 'display:grid; grid-template-columns:1fr 1fr 1fr 1fr auto; gap:6px; margin-bottom:8px; align-items:center;';
                        row.innerHTML = `
                            <input type="text" placeholder="Nom" value="${c.name || ''}" data-field="name" data-idx="${i}" style="padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:13px;">
                            <input type="text" placeholder="Organisation" value="${c.org || ''}" data-field="org" data-idx="${i}" style="padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:13px;">
                            <input type="email" placeholder="Email" value="${c.email || ''}" data-field="email" data-idx="${i}" style="padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:13px;">
                            <input type="text" placeholder="Rôle" value="${c.role || ''}" data-field="role" data-idx="${i}" style="padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:13px;">
                            <button data-remove="${i}" style="padding:4px 8px; background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:4px; cursor:pointer; font-size:12px;">✕</button>
                        `;
                        editor.appendChild(row);

                        // Listen for changes
                        row.querySelectorAll('input').forEach(inp => {
                            inp.addEventListener('input', (e) => {
                                const target = e.target as HTMLInputElement;
                                const idx = parseInt(target.dataset.idx || '0');
                                const field = target.dataset.field || '';
                                contacts[idx][field] = target.value;
                            });
                        });
                        row.querySelector(`[data-remove="${i}"]`)?.addEventListener('click', () => {
                            contacts.splice(i, 1);
                            if (contacts.length === 0) contacts.push({ name: '', org: '', email: '', role: '' });
                            renderRows();
                        });
                    });

                    // Add row button
                    const addBtn = document.createElement('button');
                    addBtn.textContent = '+ Ajouter un contact';
                    addBtn.style.cssText = 'padding:6px 14px; background:#e5e7eb; color:#374151; border:1px solid #d1d5db; border-radius:6px; cursor:pointer; font-size:13px; margin-bottom:10px;';
                    addBtn.addEventListener('click', () => {
                        contacts.push({ name: '', org: '', email: '', role: '' });
                        renderRows();
                    });
                    editor.appendChild(addBtn);

                    // Save / Cancel
                    const btnContainer = document.createElement('div');
                    btnContainer.style.cssText = 'display:flex; gap:8px; margin-top:4px;';

                    const saveBtn = document.createElement('button');
                    saveBtn.textContent = 'Enregistrer';
                    saveBtn.style.cssText = 'padding:8px 20px; background:#2563eb; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600; font-size:14px;';

                    const cancelBtn = document.createElement('button');
                    cancelBtn.textContent = 'Annuler';
                    cancelBtn.style.cssText = 'padding:8px 20px; background:#e5e7eb; color:#374151; border:1px solid #d1d5db; border-radius:6px; cursor:pointer; font-size:14px;';

                    btnContainer.appendChild(saveBtn);
                    btnContainer.appendChild(cancelBtn);
                    editor.appendChild(btnContainer);

                    cancelBtn.addEventListener('click', () => {
                        editor.remove();
                        if (contactsSection) {
                            contactsSection.querySelectorAll('.space-y-3').forEach(el => (el as HTMLElement).style.display = '');
                        }
                    });

                    saveBtn.addEventListener('click', async () => {
                        saveBtn.textContent = 'Enregistrement...';
                        saveBtn.disabled = true;
                        try {
                            const res = await fetch('/api/uc-edit-contacts', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ slug, token, contacts: contacts.filter((c: any) => c.name) })
                            });
                            if (res.ok) {
                                saveBtn.textContent = '✓ Enregistré';
                                saveBtn.style.background = '#10b981';
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                const err = await res.json();
                                alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                                saveBtn.textContent = 'Enregistrer';
                                saveBtn.disabled = false;
                            }
                        } catch (e) {
                            alert('Erreur réseau');
                            saveBtn.textContent = 'Enregistrer';
                            saveBtn.disabled = false;
                        }
                    });
                }

                // Hide existing display, show editor
                contactsSection.querySelectorAll('.space-y-3').forEach(el => (el as HTMLElement).style.display = 'none');
                contactsSection.appendChild(editor);
                renderRows();
            });
        }

        // References edit — double-click on Références section
        const refZoneElement = proseDiv.querySelector('[data-ref-zone="true"]') as HTMLElement | null;

        if (refZoneElement) {
            // Clone the zone to remove generic dblclick handler, then replace original
            const newZone = refZoneElement.cloneNode(true) as HTMLElement;
            refZoneElement.parentNode?.replaceChild(newZone, refZoneElement);
            
            const zone = newZone;
            
            zone.addEventListener('dblclick', async (e) => {
                e.stopPropagation();
                
                // Fetch current references from frontmatter via API
                let references: any[] = [];
                try {
                    const res = await fetch(`/api/uc-references-get?slug=${slug}&token=${token}`);
                    if (res.ok) {
                        const data = await res.json();
                        references = data.references || [];
                    }
                } catch (e) {}

                zone.style.display = 'none';

                const editor = document.createElement('div');
                editor.style.cssText = 'margin:12px 0;';

                const hint = document.createElement('p');
                hint.textContent = 'Ajouter des références : liens URL ou documents PDF.';
                hint.style.cssText = 'font-size:13px; color:#6b7280; margin-bottom:12px; font-weight:600;';
                editor.appendChild(hint);

                // References list
                const refList = document.createElement('div');
                refList.style.cssText = 'margin-bottom:12px; padding:8px; border:1px solid #e5e7eb; border-radius:6px; background:#f9fafb; max-height:300px; overflow-y:auto;';

                function renderReferences() {
                    refList.innerHTML = '';
                    if (references.length === 0) {
                        const empty = document.createElement('p');
                        empty.textContent = 'Aucune référence';
                        empty.style.cssText = 'color:#9ca3af; font-size:13px;';
                        refList.appendChild(empty);
                        return;
                    }

                    references.forEach((ref: any, i: number) => {
                        const refItem = document.createElement('div');
                        refItem.style.cssText = 'padding:8px; margin-bottom:6px; background:white; border:1px solid #d1d5db; border-radius:4px; display:flex; justify-content:space-between; align-items:center;';
                        
                        const refText = document.createElement('div');
                        refText.style.cssText = 'flex:1; font-size:12px;';
                        refText.innerHTML = `
                            <strong>${ref.title || 'Titre manquant'}</strong><br>
                            ${ref.venue ? `<em>${ref.venue}</em> · ` : ''}
                            <a href="${ref.url}" target="_blank" rel="noopener" style="color:#3b82f6; text-decoration:underline;">${ref.url}</a>
                        `;
                        
                        const removeBtn = document.createElement('button');
                        removeBtn.textContent = '✕';
                        removeBtn.style.cssText = 'padding:2px 6px; background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:3px; cursor:pointer; font-size:12px; margin-left:8px;';
                        removeBtn.addEventListener('click', () => {
                            references.splice(i, 1);
                            renderReferences();
                        });
                        
                        refItem.appendChild(refText);
                        refItem.appendChild(removeBtn);
                        refList.appendChild(refItem);
                    });
                }

                renderReferences();
                editor.appendChild(refList);

                // Form to add new reference
                const formContainer = document.createElement('div');
                formContainer.style.cssText = 'margin:12px 0; padding:12px; border:1px solid #bfdbfe; border-radius:6px; background:#eff6ff;';

                const formHint = document.createElement('p');
                formHint.textContent = 'Ajouter une nouvelle référence:';
                formHint.style.cssText = 'font-weight:600; font-size:13px; margin-bottom:8px; color:#1e40af;';
                formContainer.appendChild(formHint);

                // Tabs for URL vs PDF
                const tabContainer = document.createElement('div');
                tabContainer.style.cssText = 'display:flex; gap:4px; margin-bottom:8px;';
                
                const urlTab = document.createElement('button');
                urlTab.textContent = 'Lien URL';
                urlTab.style.cssText = 'padding:4px 12px; border:none; border-radius:4px; background:#3b82f6; color:white; cursor:pointer; font-size:12px; font-weight:600;';
                
                const pdfTab = document.createElement('button');
                pdfTab.textContent = 'Upload PDF';
                pdfTab.style.cssText = 'padding:4px 12px; border:none; border-radius:4px; background:#e5e7eb; color:#374151; cursor:pointer; font-size:12px;';
                
                tabContainer.appendChild(urlTab);
                tabContainer.appendChild(pdfTab);
                formContainer.appendChild(tabContainer);

                // URL form
                const urlForm = document.createElement('div');
                urlForm.style.cssText = 'display:flex; flex-direction:column; gap:6px;';
                
                const titleInput = document.createElement('input');
                titleInput.type = 'text';
                titleInput.placeholder = 'Titre de la référence';
                titleInput.style.cssText = 'padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:12px;';
                
                const venueInput = document.createElement('input');
                venueInput.type = 'text';
                venueInput.placeholder = 'Venue (optionnel) — ex: ASME IDETC-CIE 2025';
                venueInput.style.cssText = 'padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:12px;';
                
                const urlInput = document.createElement('input');
                urlInput.type = 'text';
                urlInput.placeholder = 'URL';
                urlInput.style.cssText = 'padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:12px;';
                
                const addUrlBtn = document.createElement('button');
                addUrlBtn.textContent = 'Ajouter';
                addUrlBtn.style.cssText = 'padding:6px 12px; background:#10b981; color:white; border:none; border-radius:4px; cursor:pointer; font-size:12px; font-weight:600;';
                addUrlBtn.addEventListener('click', () => {
                    if (!titleInput.value.trim() || !urlInput.value.trim()) {
                        alert('Titre et URL requis');
                        return;
                    }
                    const ref: any = {
                        title: titleInput.value.trim(),
                        url: urlInput.value.trim()
                    };
                    if (venueInput.value.trim()) ref.venue = venueInput.value.trim();
                    references.push(ref);
                    titleInput.value = '';
                    venueInput.value = '';
                    urlInput.value = '';
                    renderReferences();
                });
                
                urlForm.appendChild(titleInput);
                urlForm.appendChild(venueInput);
                urlForm.appendChild(urlInput);
                urlForm.appendChild(addUrlBtn);

                // PDF form
                const pdfForm = document.createElement('div');
                pdfForm.style.cssText = 'display:none; flex-direction:column; gap:6px;';
                
                const pdfTitleInput = document.createElement('input');
                pdfTitleInput.type = 'text';
                pdfTitleInput.placeholder = 'Titre du document PDF';
                pdfTitleInput.style.cssText = 'padding:6px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:12px;';
                
                const pdfFileInput = document.createElement('input');
                pdfFileInput.type = 'file';
                pdfFileInput.accept = '.pdf';
                pdfFileInput.style.cssText = 'padding:4px 8px; border:1px solid #d1d5db; border-radius:4px; font-size:12px;';
                
                const uploadPdfBtn = document.createElement('button');
                uploadPdfBtn.textContent = 'Upload et ajouter';
                uploadPdfBtn.style.cssText = 'padding:6px 12px; background:#f59e0b; color:white; border:none; border-radius:4px; cursor:pointer; font-size:12px; font-weight:600;';
                uploadPdfBtn.addEventListener('click', async () => {
                    const pdfFile = pdfFileInput.files?.[0];
                    if (!pdfTitleInput.value.trim() || !pdfFile) {
                        alert('Titre et fichier PDF requis');
                        return;
                    }

                    uploadPdfBtn.textContent = 'Upload en cours...';
                    uploadPdfBtn.disabled = true;

                    const formData = new FormData();
                    formData.append('file', pdfFile);
                    formData.append('slug', slug);
                    formData.append('token', token || '');

                    try {
                        const res = await fetch('/api/uc-upload-pdf', { method: 'POST', body: formData });
                        if (res.ok) {
                            const data = await res.json();
                            references.push({
                                title: pdfTitleInput.value.trim(),
                                url: data.url
                            });
                            pdfTitleInput.value = '';
                            pdfFileInput.value = '';
                            uploadPdfBtn.textContent = 'Upload et ajouter';
                            uploadPdfBtn.disabled = false;
                            renderReferences();
                        } else {
                            const err = await res.json();
                            alert('Erreur upload: ' + (err.error || 'Erreur inconnue'));
                            uploadPdfBtn.textContent = 'Upload et ajouter';
                            uploadPdfBtn.disabled = false;
                        }
                    } catch (e) {
                        alert('Erreur réseau');
                        uploadPdfBtn.textContent = 'Upload et ajouter';
                        uploadPdfBtn.disabled = false;
                    }
                });
                
                pdfForm.appendChild(pdfTitleInput);
                pdfForm.appendChild(pdfFileInput);
                pdfForm.appendChild(uploadPdfBtn);

                // Tab switching
                urlTab.addEventListener('click', () => {
                    urlForm.style.display = 'flex';
                    pdfForm.style.display = 'none';
                    urlTab.style.background = '#3b82f6';
                    urlTab.style.color = 'white';
                    pdfTab.style.background = '#e5e7eb';
                    pdfTab.style.color = '#374151';
                });
                
                pdfTab.addEventListener('click', () => {
                    urlForm.style.display = 'none';
                    pdfForm.style.display = 'flex';
                    urlTab.style.background = '#e5e7eb';
                    urlTab.style.color = '#374151';
                    pdfTab.style.background = '#3b82f6';
                    pdfTab.style.color = 'white';
                });

                formContainer.appendChild(urlForm);
                formContainer.appendChild(pdfForm);
                editor.appendChild(formContainer);

                // Save / Cancel buttons
                const btnContainer = document.createElement('div');
                btnContainer.style.cssText = 'display:flex; gap:8px; margin-top:8px;';

                const saveBtn = document.createElement('button');
                saveBtn.textContent = 'Enregistrer';
                saveBtn.style.cssText = 'padding:8px 20px; background:#2563eb; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600; font-size:14px;';

                const cancelBtn = document.createElement('button');
                cancelBtn.textContent = 'Annuler';
                cancelBtn.style.cssText = 'padding:8px 20px; background:#e5e7eb; color:#374151; border:1px solid #d1d5db; border-radius:6px; cursor:pointer; font-size:14px;';

                btnContainer.appendChild(saveBtn);
                btnContainer.appendChild(cancelBtn);
                editor.appendChild(btnContainer);

                zone.after(editor);

                cancelBtn.addEventListener('click', () => {
                    editor.remove();
                    zone.style.display = '';
                });

                saveBtn.addEventListener('click', async () => {
                    saveBtn.textContent = 'Enregistrement...';
                    saveBtn.disabled = true;
                    try {
                        const res = await fetch('/api/uc-references', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                slug, 
                                token, 
                                action: 'bulk-update',
                                references 
                            })
                        });
                        if (res.ok) {
                            saveBtn.textContent = '✓ Enregistré';
                            saveBtn.style.background = '#10b981';
                            setTimeout(() => window.location.reload(), 1500);
                        } else {
                            const err = await res.json();
                            alert('Erreur: ' + (err.error || 'Erreur inconnue'));
                            saveBtn.textContent = 'Enregistrer';
                            saveBtn.disabled = false;
                        }
                    } catch (e) {
                        alert('Erreur réseau');
                        saveBtn.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                    }
                });
            });
        }
    });
    </script>
</BaseLayout>
