---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import PageLayout from "../../layouts/PageLayout.astro";
import {
    generatePageKeywords,
    generateArticleSection,
    generateArticleTags,
} from "../../utils/keywords";

export async function getStaticPaths() {
    const allPages = await getCollection("pages");

    return allPages.map((page: CollectionEntry<"pages">) => {
        const { lang, href } = page.data;

        return {
            params: {
                lang: lang,
                slug: href,
            },
            props: { page },
        };
    });
}

const { page } = Astro.props as { page: CollectionEntry<"pages"> };
const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await page.render();

// Generate SEO metadata using utility functions
const pageKeywords = generatePageKeywords(page.data.href, lang as "en" | "fr");
const articleSection = generateArticleSection(page.data.href);
const articleTags = generateArticleTags(page.data.href, lang as "en" | "fr");
---

<PageLayout
    title={page.data.title}
    description={page.data.description || t("site.description")}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
    showToc={page.data.toc}
    keywords={pageKeywords}
    modifiedTime={page.data.lastModified?.toISOString()}
    articleSection={articleSection}
    articleTag={articleTags}
>
    <!-- Page Title -->
    <!-- <header class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {page.data.title}
        </h1>
        {
            page.data.description && (
                <p class="text-xl text-gray-600 leading-relaxed">
                    {page.data.description}
                </p>
            )
        }
    </header> -->

    <!-- Page Content -->
    <Content />

    <!-- Last Modified Date -->
    <!-- {
        page.data.lastModified && (
            <footer class="mt-12 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-500">
                    {t('page.last-updated')}
                    <time datetime={page.data.lastModified.toISOString()}>
                        {page.data.lastModified.toLocaleDateString(
                            lang === "en" ? "en-US" : "fr-FR",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            },
                        )}
                    </time>
                </p>
            </footer>
        )
    } -->
</PageLayout>
