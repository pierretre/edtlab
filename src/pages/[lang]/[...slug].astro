---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import PageLayout from "../../layouts/PageLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const allPages = await getCollection("pages");

    return allPages.map((page: CollectionEntry<"pages">) => {
        const { lang, href, layout } = page.data;

        return {
            params: {
                lang: lang,
                slug: href,
                layout: layout ?? "tests",
            },
            props: {
                page,
            },
        };
    });
}

const { page } = Astro.props as { page: CollectionEntry<"pages"> };
const { lang, layout } = Astro.params;
console.log(Astro.params);
const t = useTranslations(lang as "en" | "fr");

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

const layoutSetting = page.data.layout;
// Get the rendered content
const { Content } = await page.render();
---

<BaseLayout
    title={page.data.title}
    description={page.data.description || t("site.description")}
    canonical={page.data.canonical}
    noindex={page.data.noindex}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
>
    {
        layoutSetting ? (
            <Content />
        ) : (
            <PageLayout
                title={page.data.title}
                lang={lang as "en" | "fr"}
                showToc={page.data.toc ?? false}
            >
                <Content />
            </PageLayout>
        )
    }
</BaseLayout>
