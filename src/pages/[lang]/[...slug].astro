---
import { type CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getLayoutFromTemplateOrCollection,
    generateAllPagesStaticPaths,
} from "../../utils";

export async function getStaticPaths() {
    return await generateAllPagesStaticPaths();
}

const { page, template } = Astro.props as {
    page: CollectionEntry<"pages">;
    template: string;
};

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await page.render();
const Layout: any = getLayoutFromTemplateOrCollection(
    page.collection,
    template,
);
// Triage: cast page.data to unknown->any to avoid type union conflicts during check
const pageDataAny = page.data as unknown as any;
---

<BaseLayout
    title={page.data.title}
    description={page.data.description || t("site.description")}
    canonical={pageDataAny.canonical}
    noindex={pageDataAny.noindex}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
>
    <Layout frontmatter={page.data}>
        <Content />
    </Layout>
</BaseLayout>
