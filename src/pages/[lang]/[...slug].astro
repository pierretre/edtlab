---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLayoutFromType } from "../../utils";

export async function getStaticPaths() {
    const allPages = await getCollection("pages");

    return allPages.map((page: CollectionEntry<"pages">) => {
        const { lang, href, type } = page.data;

        return {
            params: {
                lang: lang,
                slug: href,
            },
            props: {
                page,
                type,
            },
        };
    });
}

const { page, type } = Astro.props as {
    page: CollectionEntry<"pages">;
    type: string;
};
const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await page.render();
const Layout = getLayoutFromType(type);
---

<BaseLayout
    title={page.data.title}
    description={page.data.description || t("site.description")}
    canonical={page.data.canonical}
    noindex={page.data.noindex}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
>
    <Layout frontmatter={page.data}>
        <Content />
    </Layout>
</BaseLayout>
