---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import PageLayout from "../../components/PageLayout.astro";

export async function getStaticPaths() {
    const allPages = await getCollection("pages");

    return allPages.map((page: CollectionEntry<"pages">) => {
        const { lang, href } = page.data;

        return {
            params: {
                lang: lang,
                slug: href,
            },
            props: { page },
        };
    });
}

const { page } = Astro.props as { page: CollectionEntry<"pages"> };
const { lang, slug } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

// Handle 404 for missing pages - this should not happen in getStaticPaths
// but we include it for safety
if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await page.render();

// Build breadcrumb items based on slug structure
const slugParts = slug?.split("/").filter((part) => part.length > 0) || [];
const breadcrumbItems: Array<{ name: string; href?: string }> = [
    { name: t("nav.home"), href: `/${lang}/` },
];

// Build breadcrumb from slug parts
let currentHref = `/${lang}`;
for (let i = 0; i < slugParts.length; i++) {
    const part = slugParts[i];
    currentHref += `/${part}`;

    // Get translated name for common segments
    const segmentKey = `nav.${part}` as keyof typeof t;
    const segmentName =
        t(segmentKey) ||
        part.charAt(0).toUpperCase() + part.slice(1).replace("-", " ");

    // Don't add href for the last item (current page)
    const isLastItem = i === slugParts.length - 1;
    if (isLastItem) {
        breadcrumbItems.push({
            name: segmentName,
        });
    } else {
        breadcrumbItems.push({
            name: segmentName,
            href: currentHref,
        });
    }
}
---

<PageLayout
    title={page.data.title}
    description={page.data.description || t("site.description")}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
    showToc={page.data.toc}
    breadcrumbItems={breadcrumbItems}
>
    <!-- Page Title -->
    <header class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {page.data.title}
        </h1>
        {
            page.data.description && (
                <p class="text-xl text-gray-600 leading-relaxed">
                    {page.data.description}
                </p>
            )
        }
    </header>

    <!-- Page Content -->
    <Content />

    <!-- Last Modified Date -->
    {
        page.data.lastModified && (
            <footer class="mt-12 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-500">
                    {lang === "en" ? "Last updated:" : "Dernière mise à jour :"}
                    <time datetime={page.data.lastModified.toISOString()}>
                        {page.data.lastModified.toLocaleDateString(
                            lang === "en" ? "en-US" : "fr-FR",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            },
                        )}
                    </time>
                </p>
            </footer>
        )
    }
</PageLayout>
