---
export const prerender = true;
import { type CollectionEntry, render } from "astro:content";
import { linkHelpers, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
    getLayoutFromTemplateOrCollection,
    generateAllPagesStaticPaths,
} from "@utils/.";
import mdxComponents from "@components/exported-components";

export async function getStaticPaths() {
    return await generateAllPagesStaticPaths();
}

const { page, template } = Astro.props as {
    page: CollectionEntry<"pages">;
    template: string;
};
const pageDataAny = page.data as any;
const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content, headings } = await render(page);

const Layout: any = getLayoutFromTemplateOrCollection(
    page.collection,
    template,
);
---

{
    pageDataAny.redirectTo ? (
        <html lang={lang} dir="ltr">
            <head>
                <meta charset="utf-8" />

                <meta
                    http-equiv="refresh"
                    content={
                        "0;url=" +
                        (await linkHelpers.redirect(pageDataAny.redirectTo))
                    }
                />
            </head>
        </html>
    ) : (
        <BaseLayout
            title={page.data.title}
            description={page.data.description || t("site.description")}
            canonical={pageDataAny.canonical}
            noindex={pageDataAny.noindex}
            lang={lang as "en" | "fr"}
            showBreadcrumb={true}
        >
            <Layout frontmatter={page.data} headings={headings}>
                <Content components={mdxComponents} />
            </Layout>
        </BaseLayout>
    )
}
