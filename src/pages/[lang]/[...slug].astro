---
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../components/BaseLayout.astro";

export function getStaticPaths() {
    // This will be populated when content collections are set up
    // For now, return basic paths for testing
    const paths = [];
    const langs = ["en", "fr"];
    const pages = [
        "about",
        "contact",
        "program",
        "projects",
        "production",
        "demo-center",
        "resources",
        "news",
        "join-us",
    ];

    for (const lang of langs) {
        for (const page of pages) {
            paths.push({
                params: { lang, slug: page },
            });
        }
    }

    return paths;
}

const { lang, slug } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

// Create a more descriptive title
const pageTitle = `${slug?.charAt(0).toUpperCase()}${slug?.slice(1).replace("-", " ")}`;
---

<BaseLayout
    title={pageTitle}
    description={t("site.description")}
    lang={lang as "en" | "fr"}
>
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-6">
            {slug} ({lang?.toUpperCase()})
        </h1>
        <p class="text-gray-600">
            This is the {slug} page in {lang === "en" ? "English" : "French"}.
        </p>
    </div>
</BaseLayout>
