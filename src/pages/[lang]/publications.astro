---
export const prerender = false;
import { getEntry } from "astro:content";
import { getLangFromUrl } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageLayout from "@layouts/PageLayout.astro";
import PublicationList from "@components/PublicationList.astro";

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const page = await getEntry("pages", `publications/${lang}`);

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}
---

<BaseLayout
    title={page.data.title}
    description={page.data.description}
    lang={lang}
    showBreadcrumb={true}
>
    <PageLayout frontmatter={page.data as any}>
        <h1>{page.data.title}</h1>
        <PublicationList lang={lang} origin="edt" />
    </PageLayout>
</BaseLayout>
