---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { useTranslations } from "../../../i18n/utils";

export const getStaticPaths: GetStaticPaths = async () => {
    const jobOffers = await getCollection("job-offers");

    return jobOffers.map((jobOffer) => ({
        params: {
            lang: jobOffer.data.lang,
            slug: jobOffer.slug,
        },
        props: {
            jobOffer,
        },
    }));
};

const { jobOffer } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "fr");

const { Content } = await jobOffer.render();

// Helper function to get project color
const getProjectColor = (project: string) => {
    switch (project) {
        case "PC1":
            return "bg-blue-100 text-primary-600 border-blue-200";
        case "PC2":
            return "bg-green-100 text-green-800 border-green-200";
        case "PC3":
            return "bg-yellow-100 text-yellow-800 border-yellow-200";
        case "PC4":
            return "bg-purple-100 text-purple-800 border-purple-200";
        case "PC5":
            return "bg-red-100 text-red-800 border-red-200";
        case "General":
            return "bg-gray-100 text-gray-800 border-gray-200";
        default:
            return "bg-gray-100 text-gray-800 border-gray-200";
    }
};

// Helper function to get type color
const getTypeColor = (type: string) => {
    switch (type) {
        case "postdoc":
            return "bg-indigo-100 text-indigo-800 border-indigo-200";
        case "phd":
            return "bg-emerald-100 text-emerald-800 border-emerald-200";
        case "engineer":
            return "bg-orange-100 text-orange-800 border-orange-200";
        case "intern":
            return "bg-pink-100 text-pink-800 border-pink-200";
        default:
            return "bg-gray-100 text-gray-800 border-gray-200";
    }
};

// Format deadline date
const formatDate = (date: Date) => {
    return date.toLocaleDateString(lang === "fr" ? "fr-FR" : "en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};

// Check if deadline has passed
const isDeadlinePassed = (deadline: Date) => {
    const now = new Date();
    return deadline < now;
};

// Check if deadline is approaching (within 30 days)
const isDeadlineApproaching = (deadline: Date) => {
    const now = new Date();
    const timeDiff = deadline.getTime() - now.getTime();
    const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24));
    return daysDiff <= 30 && daysDiff > 0;
};

const breadcrumbs = [
    { name: t("nav.home"), href: `/${lang}` },
    { name: t("nav.join-us"), href: `/${lang}/join-us` },
    { name: jobOffer.data.title, href: `/${lang}/job-offers/${jobOffer.slug}` },
];
---

<BaseLayout
    title={jobOffer.data.title}
    description={jobOffer.data.description}
    lang={lang as "en" | "fr"}
    breadcrumbs={breadcrumbs}
>
    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <!-- Badges -->
            <div class="flex flex-wrap gap-3 mb-4">
                <span
                    class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium border ${getProjectColor(jobOffer.data.project)}`}
                >
                    {jobOffer.data.project}
                </span>
                <span
                    class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium border ${getTypeColor(jobOffer.data.type)}`}
                >
                    {t(`job-offers.type.${jobOffer.data.type}`)}
                </span>
                {
                    isDeadlineApproaching(jobOffer.data.deadline) && (
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                            <svg
                                class="w-4 h-4 mr-1"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                            {t("job-offers.deadline-approaching")}
                        </span>
                    )
                }
                {
                    isDeadlinePassed(jobOffer.data.deadline) && (
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 border border-red-200">
                            <svg
                                class="w-4 h-4 mr-1"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                            {t("job-offers.deadline-passed")}
                        </span>
                    )
                }
            </div>

            <!-- Title -->
            <h1 class="text-3xl font-bold text-gray-900 mb-4">
                {jobOffer.data.title}
            </h1>

            <!-- Key Information -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6 bg-gray-50 rounded-lg border"
            >
                <div class="flex items-center text-gray-700">
                    <svg
                        class="w-5 h-5 mr-3 text-gray-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <div>
                        <div class="text-sm text-gray-500">
                            {t("job-offers.location")}
                        </div>
                        <div class="font-medium">{jobOffer.data.location}</div>
                    </div>
                </div>
                <div class="flex items-center text-gray-700">
                    <svg
                        class="w-5 h-5 mr-3 text-gray-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                    </svg>
                    <div>
                        <div class="text-sm text-gray-500">
                            {t("job-offers.deadline")}
                        </div>
                        <div
                            class={`font-medium ${isDeadlinePassed(jobOffer.data.deadline) ? "text-red-600" : ""}`}
                        >
                            {formatDate(jobOffer.data.deadline)}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Requirements Section -->
        {
            jobOffer.data.requirements.length > 0 && (
                <div class="mb-8 p-6 bg-blue-50 rounded-lg border border-blue-200">
                    <h2 class="text-xl font-semibold text-blue-900 mb-4 flex items-center">
                        <svg
                            class="w-5 h-5 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                        {t("job-offers.requirements")}
                    </h2>
                    <ul class="space-y-2">
                        {jobOffer.data.requirements.map((requirement) => (
                            <li class="flex items-start text-primary-600">
                                <svg
                                    class="w-4 h-4 mr-3 mt-0.5 text-primary-600 flex-shrink-0"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                                {requirement}
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }

        <!-- Content Section -->
        <div class="prose prose-lg max-w-none mb-8">
            <Content />
        </div>

        <!-- Action Section -->
        <div class="border-t pt-8">
            <div
                class="flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center"
            >
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">
                        {t("job-offers.interested")}
                    </h3>
                    <p class="text-gray-600">
                        {
                            isDeadlinePassed(jobOffer.data.deadline)
                                ? t("job-offers.position-closed")
                                : t("job-offers.apply-instructions")
                        }
                    </p>
                </div>
                <div class="flex gap-3">
                    <a
                        href={`/${lang}/join-us`}
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-gray-200 transition-colors duration-200"
                    >
                        <svg
                            class="w-4 h-4 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        {t("job-offers.back-to-positions")}
                    </a>
                    {
                        !isDeadlinePassed(jobOffer.data.deadline) && (
                            <a
                                href={`mailto:careers@edt-program.fr?subject=${encodeURIComponent(`Application: ${jobOffer.data.title}`)}`}
                                class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-blue-300 transition-colors duration-200"
                            >
                                <svg
                                    class="w-4 h-4 mr-2"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    />
                                </svg>
                                {t("job-offers.apply-now")}
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .prose {
        @apply text-gray-700;
    }

    .prose h1,
    .prose h2,
    .prose h3,
    .prose h4,
    .prose h5,
    .prose h6 {
        @apply text-gray-900;
    }

    .prose a {
        @apply text-primary-600 hover:text-primary-600;
    }
</style>
