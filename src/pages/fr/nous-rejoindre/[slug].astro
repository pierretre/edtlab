---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import {
    formatDate,
    isDeadlinePassed,
    isDeadlineApproaching,
    getJobTypeColor,
} from "../../../utils";
import PageLayout from "../../../layouts/PageLayout.astro";
import ProjectTag from "../../../components/ProjectTag.astro";

export async function getStaticPaths() {
    const frenchJobOffers = await getCollection("job-offers", ({ data }) => {
        return data.lang === "fr";
    });

    return frenchJobOffers.map((jobOffer: CollectionEntry<"job-offers">) => {
        return {
            params: {
                slug: jobOffer.slug.replace("-fr", ""), // Remove language suffix from slug
            },
            props: { jobOffer },
        };
    });
}

const { jobOffer } = Astro.props as { jobOffer: CollectionEntry<"job-offers"> };
const lang = "fr";
const t = useTranslations(lang);

if (!jobOffer) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await jobOffer.render();
---

<PageLayout
    title={jobOffer.data.title}
    description={jobOffer.data.description || t("site.description")}
    lang={lang}
    showBreadcrumb={true}
    showToc={false}
>
    <!-- Back to Join Us link -->
    <div class="mb-6">
        <a
            href="/fr/nous-rejoindre"
            class="inline-flex items-center text-primary-600 hover:text-primary-800 text-sm font-medium"
        >
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            {t("job-offers.back-to-careers")}
        </a>
    </div>

    <!-- Job Offer Header -->
    <header class="mb-8">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-4">
            <ProjectTag project={jobOffer.data.project} />
            <span
                class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium border ${getJobTypeColor(jobOffer.data.type)}`}
            >
                {t(`job-offers.type.${jobOffer.data.type}`)}
            </span>
            {
                isDeadlineApproaching(jobOffer.data.deadline) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                        {t("job-offers.deadline-approaching")}
                    </span>
                )
            }
            {
                isDeadlinePassed(jobOffer.data.deadline) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 border border-red-200">
                        {t("job-offers.deadline-passed")}
                    </span>
                )
            }
        </div>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {jobOffer.data.title}
        </h1>

        <!-- Meta Information -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6 bg-gray-50 rounded-lg border"
        >
            <div class="flex items-center text-gray-700">
                <svg
                    class="w-5 h-5 mr-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <div>
                    <span class="text-sm font-medium text-gray-500"
                        >{t("job-offers.location")}</span
                    >
                    <p class="font-medium">{jobOffer.data.location}</p>
                </div>
            </div>
            <div class="flex items-center text-gray-700">
                <svg
                    class="w-5 h-5 mr-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <div>
                    <span class="text-sm font-medium text-gray-500"
                        >{t("job-offers.deadline")}</span
                    >
                    <p
                        class={`font-medium ${isDeadlinePassed(jobOffer.data.deadline) ? "text-red-600" : ""}`}
                    >
                        {formatDate(jobOffer.data.deadline, lang)}
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- Job Offer Content -->
    <div class="prose prose-lg max-w-none">
        <Content />
    </div>

    <!-- Requirements Section -->
    {
        jobOffer.data.requirements && jobOffer.data.requirements.length > 0 && (
            <section class="mt-8 p-6 bg-primary-50 rounded-lg border border-primary-200">
                <h2 class="text-xl font-semibold text-primary-800 mb-4">
                    {t("job-offers.requirements")}
                </h2>
                <ul class="space-y-2">
                    {jobOffer.data.requirements.map((requirement) => (
                        <li class="flex items-start">
                            <svg
                                class="w-5 h-5 text-primary-600 mr-3 mt-0.5 flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                            <span class="text-gray-700">{requirement}</span>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <!-- Application CTA -->
    <section
        class="mt-8 p-6 bg-gradient-to-r from-primary-600 to-primary-700 rounded-lg text-white"
    >
        <h2 class="text-xl font-semibold mb-3">
            {t("job-offers.ready-to-apply")}
        </h2>
        <p class="mb-4 text-primary-100">
            {t("job-offers.application-instructions")}
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
            <a
                href={`mailto:careers@edt-program.fr?subject=${encodeURIComponent(`Candidature: ${jobOffer.data.title}`)}`}
                class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-700 font-medium rounded-lg hover:bg-gray-50 transition-colors duration-200"
            >
                <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                {t("job-offers.apply-now")}
            </a>
            <a
                href="/fr/nous-rejoindre"
                class="inline-flex items-center justify-center px-6 py-3 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-400 transition-colors duration-200"
            >
                {t("job-offers.view-all-positions")}
            </a>
        </div>
    </section>
</PageLayout>
