---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../../../i18n/utils";
import PageLayout from "../../../../layouts/PageLayout.astro";

export async function getStaticPaths() {
    const frenchPressReleases = await getCollection(
        "press-releases",
        ({ data }) => {
            return data.lang === "fr";
        },
    );

    return frenchPressReleases.map(
        (pressRelease: CollectionEntry<"press-releases">) => {
            return {
                params: {
                    slug: pressRelease.slug.replace("-fr", ""), // Remove language suffix from slug
                },
                props: { pressRelease },
            };
        },
    );
}

const { pressRelease } = Astro.props as {
    pressRelease: CollectionEntry<"press-releases">;
};
const { slug } = Astro.params;
const lang = "fr";
const t = useTranslations(lang);

if (!pressRelease) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await pressRelease.render();

// Helper function to get press release type color
const getTypeColor = (type: string) => {
    switch (type) {
        case "announcement":
            return "bg-blue-100 text-primary-600 border-blue-200";
        case "partnership":
            return "bg-green-100 text-green-800 border-green-200";
        case "award":
            return "bg-yellow-100 text-yellow-800 border-yellow-200";
        case "milestone":
            return "bg-purple-100 text-purple-800 border-purple-200";
        case "general":
            return "bg-gray-100 text-gray-800 border-gray-200";
        default:
            return "bg-red-100 text-red-800 border-red-200";
    }
};

// Helper function to get type translation
const getTypeTranslation = (type: string) => {
    switch (type) {
        case "announcement":
            return "Annonce";
        case "partnership":
            return "Partenariat";
        case "award":
            return "Prix";
        case "milestone":
            return "Étape";
        case "general":
            return "Général";
        default:
            return type.charAt(0).toUpperCase() + type.slice(1);
    }
};

// Format press release date
const formatDate = (date: Date) => {
    return date.toLocaleDateString("fr-FR", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};

// Check if press release is recent (within 30 days)
const isRecent = (date: Date) => {
    const now = new Date();
    const timeDiff = now.getTime() - date.getTime();
    const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24));
    return daysDiff <= 30;
};
---

<PageLayout
    title={pressRelease.data.title}
    description={pressRelease.data.description || t("site.description")}
    lang={lang}
    showBreadcrumb={true}
    showToc={false}
>
    <!-- Back to News link -->
    <div class="mb-6">
        <a
            href="/fr/actualites"
            class="inline-flex items-center text-primary-600 hover:text-primary-800 text-sm font-medium"
        >
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            Retour aux Actualités
        </a>
    </div>

    <!-- Press Release Header -->
    <header class="mb-8">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-4">
            <span
                class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 border border-red-200"
            >
                Communiqué de Presse
            </span>
            <span
                class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium border ${getTypeColor(pressRelease.data.type)}`}
            >
                {getTypeTranslation(pressRelease.data.type)}
            </span>
            {
                isRecent(pressRelease.data.date) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 border border-green-200">
                        Récent
                    </span>
                )
            }
        </div>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {pressRelease.data.title}
        </h1>

        <!-- Meta Information -->
        <div class="p-6 bg-gray-50 rounded-lg border">
            <div class="flex items-center text-gray-700">
                <svg
                    class="w-5 h-5 mr-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <div>
                    <span class="text-sm font-medium text-gray-500"
                        >Publié le</span
                    >
                    <p class="font-medium text-primary-600">
                        {formatDate(pressRelease.data.date)}
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- Press Release Content -->
    <div class="prose prose-lg max-w-none">
        <Content />
    </div>

    <!-- External Link Section -->
    {
        pressRelease.data.url && (
            <section class="mt-8 p-6 bg-gradient-to-r from-primary-600 to-primary-700 rounded-lg text-white">
                <h2 class="text-xl font-semibold mb-3">En Savoir Plus</h2>
                <p class="mb-4 text-primary-100">
                    Visitez la page officielle pour des détails et ressources
                    supplémentaires.
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a
                        href={pressRelease.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-700 font-medium rounded-lg hover:bg-gray-50 transition-colors duration-200"
                    >
                        <svg
                            class="w-5 h-5 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                        </svg>
                        {t("news.external-link")}
                    </a>
                    <a
                        href="/fr/actualites"
                        class="inline-flex items-center justify-center px-6 py-3 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-400 transition-colors duration-200"
                    >
                        Retour aux Actualités
                    </a>
                </div>
            </section>
        )
    }
</PageLayout>
