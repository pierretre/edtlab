---
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import {
    formatDate,
    isUpcoming,
    isToday,
    isSoon,
    getEventTypeColor,
} from "../../../utils";
import PageLayout from "../../../layouts/PageLayout.astro";

export async function getStaticPaths() {
    const frenchEvents = await getCollection("events", ({ data }) => {
        return data.lang === "fr";
    });

    return frenchEvents.map((event: CollectionEntry<"events">) => {
        return {
            params: {
                slug: event.slug.replace("-fr", ""), // Remove language suffix from slug
            },
            props: { event },
        };
    });
}

const { event } = Astro.props as { event: CollectionEntry<"events"> };

const lang = "fr";
const t = useTranslations(lang);

if (!event) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}

// Get the rendered content
const { Content } = await event.render();
---

<PageLayout
    title={event.data.title}
    description={event.data.description || t("site.description")}
    lang={lang}
    showBreadcrumb={true}
    showToc={false}
>
    <!-- Back to News link -->
    <div class="mb-6">
        <a
            href="/fr/actualites"
            class="inline-flex items-center text-primary-600 hover:text-primary-800 text-sm font-medium"
        >
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            {t("news.back-to-news")}
        </a>
    </div>

    <!-- Event Header -->
    <header class="mb-8">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-4">
            <span
                class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium border ${getEventTypeColor(event.data.type)}`}
            >
                {t(`events.type.${event.data.type}`)}
            </span>
            {
                isToday(event.data.date) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                        {t("events.today")}
                    </span>
                )
            }
            {
                isSoon(event.data.date) && !isToday(event.data.date) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-800 border border-orange-200">
                        {t("events.soon")}
                    </span>
                )
            }
            {
                !isUpcoming(event.data.date) && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800 border border-gray-200">
                        {t("events.past")}
                    </span>
                )
            }
        </div>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {event.data.title}
        </h1>

        <!-- Meta Information -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6 bg-gray-50 rounded-lg border"
        >
            <div class="flex items-center text-gray-700">
                <svg
                    class="w-5 h-5 mr-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <div>
                    <span class="text-sm font-medium text-gray-500"
                        >{t("events.date")}</span
                    >
                    <p
                        class={`font-medium ${isUpcoming(event.data.date) ? "text-primary-600" : ""}`}
                    >
                        {formatDate(event.data.date, lang)}
                    </p>
                </div>
            </div>
            {
                event.data.location && (
                    <div class="flex items-center text-gray-700">
                        <svg
                            class="w-5 h-5 mr-3 text-gray-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                        </svg>
                        <div>
                            <span class="text-sm font-medium text-gray-500">
                                {t("events.location")}
                            </span>
                            <p class="font-medium">{event.data.location}</p>
                        </div>
                    </div>
                )
            }
        </div>
    </header>

    <!-- Event Content -->
    <div class="prose prose-lg max-w-none">
        <Content />
    </div>

    <!-- External Link Section -->
    {
        event.data.url && (
            <section class="mt-8 p-6 bg-gradient-to-r from-primary-600 to-primary-700 rounded-lg text-white">
                <h2 class="text-xl font-semibold mb-3">
                    {isUpcoming(event.data.date)
                        ? t("news.ready-to-participate")
                        : t("events.learn-more")}
                </h2>
                <p class="mb-4 text-primary-100">
                    {isUpcoming(event.data.date)
                        ? t("news.register-event")
                        : t("news.visit-official-page")}
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a
                        href={event.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-700 font-medium rounded-lg hover:bg-gray-50 transition-colors duration-200"
                    >
                        <svg
                            class="w-5 h-5 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                        </svg>
                        {isUpcoming(event.data.date)
                            ? t("events.register")
                            : t("events.learn-more")}
                    </a>
                    <a
                        href="/fr/actualites"
                        class="inline-flex items-center justify-center px-6 py-3 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-400 transition-colors duration-200"
                    >
                        {t("events.view-all")}
                    </a>
                </div>
            </section>
        )
    }
</PageLayout>
