---
export const prerender = true;

// Import CSS - Astro will process it and inject it in <head>
// This styles the admin page itself
import "../styles/global.css";

// Import CSS again but capture the URL for Decap preview
// Vite will generate a hashed URL like /_astro/global.abc123.css
import globalCssUrl from "../styles/global.css?url";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex" />
        <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <title>EDT Content Manager</title>
    </head>
    <body>
        <!-- Dashboard script-->
        <script
            is:inline
            src="https://unpkg.com/decap-cms@3.9.0/dist/decap-cms.js"></script>

        <!-- Register preview styles with the processed CSS URL -->
        <script is:inline define:vars={{ globalCssUrl }}>
            // Register the Astro-processed CSS for Decap preview pane
            // The URL is generated by Vite and includes cache-busting hash
            CMS.registerPreviewStyle(globalCssUrl);
            console.log("✅ Preview styles registered:", globalCssUrl);
        </script>

        <!-- Decap CMS customizations for image handling -->
        <script is:inline src="/admin/decap-customizations.js"></script>
    </body>
</html>
