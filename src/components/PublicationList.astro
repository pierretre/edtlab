---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import { generatePublicationStructuredData } from "@utils/seo";
import PublicationCard from "./PublicationCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import { publicationsFilterConfig } from "@utils/filter-configs";
import { getPublicationsCollection } from "@utils/mongodb";
import type { Publication } from "@models/Publication.model";

export interface Props {
    lang: "en" | "fr";
    origin?: "edt" | "external";
}

const { lang, origin } = Astro.props as Props;
const t = useTranslations(lang);

type Pub = { id: string; data: Publication };

// Statically authored publications (content collection)
const staticPublications: Pub[] = (await getCollection("publications")).map(
    (p) => ({ id: p.id, data: p.data }),
);

// Publications synced from HAL into MongoDB. Best-effort: if Mongo is
// unreachable, the page still renders with just the static publications.
let halPublications: Pub[] = [];
try {
    const collection = await getPublicationsCollection();
    const docs = await collection.find().toArray();
    const staticDois = new Set(
        staticPublications.map((p) => p.data.doi?.toLowerCase()),
    );
    const staticTitles = new Set(
        staticPublications.map((p) => p.data.title.toLowerCase()),
    );

    console.log(
        `Loaded ${docs.length} HAL publications from MongoDB, filtering out ${staticDois.size} static DOIs and ${staticTitles.size} static titles`,
    );

    halPublications = docs
        .filter(
            (doc) =>
                !(doc.doi && staticDois.has(doc.doi.toLowerCase())) &&
                !staticTitles.has(doc.title.toLowerCase()),
        )
        .map((doc) => ({ id: doc.halId, data: doc }));
} catch (error) {
    console.error("Failed to load HAL publications from MongoDB:", error);
}

const allPublications = [...staticPublications, ...halPublications];

const sortByYearTitle = (a: Pub, b: Pub) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return (a.data.title || "").localeCompare(b.data.title || "");
};

// HAL-origin publications come from the lab's own HAL collection, so they
// count as "edt" for the purposes of this origin filter.
const publications = (
    origin
        ? allPublications.filter((p: Pub) =>
              origin === "edt"
                  ? p.data.origin === "edt" || p.data.origin === "hal"
                  : p.data.origin !== "edt" && p.data.origin !== "hal",
          )
        : allPublications
).sort(sortByYearTitle);

// Generate structured data for publications
const publicationStructuredData = publications.map((pub) =>
    generatePublicationStructuredData(
        pub.data.title,
        pub.data.authors,
        pub.data.year.toString(),
        pub.data.tags ?? [],
        pub.data.url,
        pub.data.doi,
        pub.data.venue,
        pub.data.type,
    ),
);
---

<div class="w-full">
    <div class="flex flex-col lg:flex-row gap-10">
        <FilterSidebar
            filters={publicationsFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <main class="flex-1">
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("publications.results-count")}
                >
                    {
                        t("publications.results-count").replace(
                            "{count}",
                            publications.length.toString(),
                        )
                    }
                </span>
            </div>

            <div
                id="publications-list"
                class="relative overflow-x-auto"
                role="region"
                aria-label={t("accessibility.table-caption")}
            >
                <div class="space-y-2">
                    {
                        publications.map((publication: Pub) => (
                            <PublicationCard
                                publication={publication.data}
                                t={t}
                            />
                        ))
                    }
                </div>
            </div>

            <div id="no-results" class="hidden text-center py-32">
                <div class="max-w-md mx-auto">
                    <h3 class="mt-4 text-lg font-medium text-gray-900">
                        {t("publications.no-results")}
                    </h3>
                    <p class="mt-2 text-gray-500">
                        {t("publications.no-results-description")}
                    </p>
                </div>
            </div>
        </main>
    </div>

    <!-- Structured Data for Publications -->
    {
        publicationStructuredData.map((data) => (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(data)}
            />
        ))
    }

    <script>
        import { FilterManagerImpl } from "@utils/filtering";
        import { publicationsFilterConfig } from "@utils/filter-configs";

        function initPublicationFilters() {
            const filterManager = new FilterManagerImpl(
                publicationsFilterConfig,
            );
            filterManager.initialize();
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initPublicationFilters,
            );
        } else {
            initPublicationFilters();
        }
    </script>

    <style>
        .publication-item.hidden {
            display: none;
        }
    </style>
</div>
