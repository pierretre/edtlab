---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import { generatePublicationStructuredData } from "@utils/seo";
import PublicationCard from "./PublicationCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import {
    publicationsFilterConfig,
    getAvailableYears,
} from "@utils/filter-configs";

export interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

// Get all publications for the current language
const allPublications = await getCollection("publications");

type Pub = (typeof allPublications)[number];
const sortByYearTitle = (a: Pub, b: Pub) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return a.data.title.localeCompare(b.data.title);
};

// Separate EDT and external publications
const edtPublications = allPublications
    .filter((p: Pub) => p.data.origin === "edt")
    .sort(sortByYearTitle);

const externalPublications = allPublications
    .filter((p: Pub) => p.data.origin !== "edt")
    .sort(sortByYearTitle);

// Combined for filters/structured data
const sortedPublications = [...edtPublications, ...externalPublications];

// Get unique years for filter options
const years = getAvailableYears(allPublications.map((p) => p.data));

// Update year filter options dynamically
const yearFilter = publicationsFilterConfig.filters.find(
    (f) => f.id === "year-filter",
);
if (yearFilter && yearFilter.options) {
    yearFilter.options = [
        {
            value: "",
            label: "All Years",
            translationKey: "publications.filter.all-years",
        },
        ...years.map((year) => ({
            value: year.toString(),
            label: year.toString(),
        })),
    ];
}

// Generate structured data for publications
const publicationStructuredData = sortedPublications.map((pub) =>
    generatePublicationStructuredData(
        pub.data.title,
        pub.data.authors,
        pub.data.year.toString(),
        pub.data.tags,
        pub.data.url,
        pub.data.doi,
        pub.data.venue,
        pub.data.type,
    ),
);
---

<div class="w-full">
    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Filter Sidebar -->
        <FilterSidebar
            filters={publicationsFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <main class="flex-1">
            <!-- Results Count -->
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("publications.results-count")}
                >
                    {
                        t("publications.results-count").replace(
                            "{count}",
                            sortedPublications.length.toString(),
                        )
                    }
                </span>
            </div>

            <div
                id="publications-list"
                class="relative overflow-x-auto"
                role="region"
                aria-label={t("accessibility.table-caption")}
            >
                {edtPublications.length > 0 && (
                    <div class="mb-8">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4 border-b border-primary-200 pb-2">
                            {t("publications.section.edt")}
                        </h3>
                        <div class="space-y-2">
                            {edtPublications.map((publication: Pub) => (
                                <PublicationCard publication={publication.data} t={t} />
                            ))}
                        </div>
                    </div>
                )}

                {externalPublications.length > 0 && (
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-4 border-b border-gray-200 pb-2">
                            {t("publications.section.external")}
                        </h3>
                        <div class="space-y-2">
                            {externalPublications.map((publication: Pub) => (
                                <PublicationCard publication={publication.data} t={t} />
                            ))}
                        </div>
                    </div>
                )}
            </div>

            <!-- No Results Message -->
            <div id="no-results" class="hidden text-center py-32">
                <div class="max-w-md mx-auto">
                    <h3 class="mt-4 text-lg font-medium text-gray-900">
                        {t("publications.no-results")}
                    </h3>
                    <p class="mt-2 text-gray-500">
                        {t("publications.no-results-description")}
                    </p>
                </div>
            </div>
        </main>
    </div>

    <!-- Structured Data for Publications -->
    {
        publicationStructuredData.map((data) => (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(data)}
            />
        ))
    }

    <script>
        import { FilterManagerImpl } from "@utils/filtering";
        import { publicationsFilterConfig } from "@utils/filter-configs";

        // Initialize filter manager when DOM is ready
        document.addEventListener("DOMContentLoaded", function () {
            const filterManager = new FilterManagerImpl(
                publicationsFilterConfig,
            );
            filterManager.initialize();
        });
    </script>

    <style>
        .publication-item.hidden {
            display: none;
        }
    </style>
</div>
