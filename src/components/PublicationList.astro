---
import { useTranslations } from "@i18n/utils";
import { generatePublicationStructuredData } from "@utils/seo";
import PublicationCard from "./PublicationCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import { publicationsFilterConfig } from "@utils/filter-configs";
import { getAllPublications } from "@utils/publications";
import type { Publication } from "~/models/Publication.model";

export interface Props {
    lang: "en" | "fr";
    origin?: "edt" | "external";
}

const { lang, origin } = Astro.props as Props;
const t = useTranslations(lang);

const publications = await getAllPublications(origin);

// Generate structured data for publications
const publicationStructuredData = publications.map((pub: Publication) =>
    generatePublicationStructuredData(
        pub.title,
        pub.authors,
        pub.year.toString(),
        pub.tags ?? [],
        pub.url,
        pub.doi,
        pub.venue,
        pub.type,
    ),
);
---

<div class="w-full">
    <div class="flex flex-col lg:flex-row gap-10">
        <FilterSidebar
            filters={publicationsFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <main class="flex-1">
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("publications.results-count")}
                >
                    {
                        t("publications.results-count").replace(
                            "{count}",
                            publications.length.toString(),
                        )
                    }
                </span>
            </div>

            <div
                id="publications-list"
                class="relative overflow-x-auto"
                role="region"
                aria-label={t("accessibility.table-caption")}
            >
                <div class="space-y-2">
                    {
                        publications.map((publication: Publication) => (
                            <PublicationCard publication={publication} t={t} />
                        ))
                    }
                </div>
            </div>

            <div id="no-results" class="hidden text-center py-32">
                <div class="max-w-md mx-auto">
                    <h3 class="mt-4 text-lg font-medium text-gray-900">
                        {t("publications.no-results")}
                    </h3>
                    <p class="mt-2 text-gray-500">
                        {t("publications.no-results-description")}
                    </p>
                </div>
            </div>
        </main>
    </div>

    <!-- Structured Data for Publications -->
    {
        publicationStructuredData.map((data) => (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(data)}
            />
        ))
    }

    <script>
        import { FilterManagerImpl } from "@utils/filtering";
        import { publicationsFilterConfig } from "@utils/filter-configs";

        function initPublicationFilters() {
            const filterManager = new FilterManagerImpl(
                publicationsFilterConfig,
            );
            filterManager.initialize();
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initPublicationFilters,
            );
        } else {
            initPublicationFilters();
        }
    </script>

    <style>
        .publication-item.hidden {
            display: none;
        }
    </style>
</div>
