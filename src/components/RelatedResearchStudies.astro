---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { linkHelpers } from "@i18n/links";

export interface Props {
    useCaseId?: string;
}

const { useCaseId } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

let related: any[] = [];
if (useCaseId) {
    try {
        const allUcs = await getCollection("use-cases");
        const slugToConceptualId = new Map(allUcs.map((uc) => [uc.id, uc.data.id]));

        const studies = await getCollection("research-studies");
        related = studies
            .filter((s) => !s.data.lang || s.data.lang === lang)
            .filter((s) =>
                (s.data.useCases || []).some(
                    (uc: any) => uc.ref && slugToConceptualId.get(uc.ref.id) === useCaseId,
                ),
            )
            .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
    } catch (error) {
        console.warn(`Could not load related research-studies: ${error}`);
    }
}
---

{
    related.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <h2 id="related-research-studies" class="font-semibold text-gray-900 mb-4 mt-0">
                {t("use-cases.related-research-studies")}
            </h2>
            <ul class="list-none pl-0 space-y-2">
                {related.map((s) => (
                    <li>
                        <a
                            href={linkHelpers.researchStudy(lang, s.id)}
                            class="text-primary-600 hover:underline font-medium"
                        >
                            {s.data.title}
                        </a>
                        <span class="text-gray-500 text-sm ml-2">
                            · {s.data.researcher.name} · {s.data.pc}
                        </span>
                    </li>
                ))}
            </ul>
        </div>
    )
}
