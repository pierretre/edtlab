---
interface Props {
    label: string;
    title: string;
    description: string;
}

const { label, title, description } = Astro.props;
---

<div
    class="h-full card bg-white border-2 border-primary-500 rounded-lg p-4 transition-all hover:border-primary-600"
>
    <div class="flex items-start gap-3">
        <div
            class="flex-shrink-0 w-12 h-12 bg-primary-500 text-white rounded-full flex items-center justify-center font-bold text-xl"
        >
            {label}
        </div>
        <div class="card-content flex-1">
            <h3 class="text-base font-semibold text-gray-900 mb-2">{title}</h3>
            <p class="text-gray-700 text-sm leading-relaxed">{description}</p>
        </div>
    </div>
</div>

<style>
    .outlined-card {
        height: 100%;
    }
</style>
