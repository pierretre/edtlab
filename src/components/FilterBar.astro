---
import { useTranslations } from "../i18n/utils";

interface FilterOption {
    value: string;
    label: string;
}

interface Props {
    lang: "en" | "fr";
    filters: {
        id: string;
        label: string;
        type: "select" | "search";
        options?: FilterOption[];
        placeholder?: string;
    }[];
    clearButtonId: string;
    compact?: boolean;
}

const { lang, filters, clearButtonId, compact = false } = Astro.props;
const t = useTranslations(lang);
---

<div
    class={`filter-bar ${compact ? "mb-4" : "mb-6"} ${compact ? "p-3" : "p-4"} bg-gray-50 rounded-lg border`}
>
    <div
        class={`grid gap-3 ${compact ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" : "grid-cols-1 md:grid-cols-3"}`}
    >
        {
            filters.map((filter) => (
                <div class="filter-item">
                    <label
                        for={filter.id}
                        class={`block ${compact ? "mb-1" : "mb-2"} text-xs font-medium text-gray-900`}
                    >
                        {filter.label}
                    </label>
                    {filter.type === "select" ? (
                        <select
                            id={filter.id}
                            class={`bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-300 focus:border-primary-300 block w-full ${compact ? "p-2" : "p-2.5"}`}
                        >
                            {filter.options?.map((option) => (
                                <option value={option.value}>
                                    {option.label}
                                </option>
                            ))}
                        </select>
                    ) : (
                        <input
                            type="text"
                            id={filter.id}
                            class={`bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-300 focus:border-primary-300 block w-full ${compact ? "p-2" : "p-2.5"}`}
                            placeholder={filter.placeholder}
                        />
                    )}
                </div>
            ))
        }

        <!-- Clear Filters Button -->
        <div class="filter-item flex items-end">
            <button
                id={clearButtonId}
                class={`text-primary-600 hover:text-primary-600 text-xs font-medium whitespace-nowrap ${compact ? "py-2" : "py-2.5"}`}
            >
                {t("filter.clear")}
            </button>
        </div>
    </div>
</div>

<style>
    .filter-bar {
        @apply w-full;
    }

    .filter-item {
        @apply min-w-0; /* Prevents flex items from overflowing */
    }

    /* Responsive adjustments for compact mode */
    @media (max-width: 640px) {
        .filter-bar.compact .grid {
            grid-template-columns: 1fr;
        }
    }

    @media (min-width: 641px) and (max-width: 1024px) {
        .filter-bar.compact .grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1025px) {
        .filter-bar.compact .grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>
