---
// @ts-nocheck
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import { getContentLink } from "@i18n/links";
import Badge from "@components/Badge.astro";

interface Props {
    lang: "en" | "fr";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Club members are the EDT programme PhD candidates: filled PhD positions with a
// named researcher. The list is maintained through the positions collection (see
// docs/editors/how-to/positions-guide.md) so it stays in sync automatically.
const members = (await getCollection("positions"))
    .filter(
        (position) =>
            position.data.type === "PhD" &&
            position.data.filled === true &&
            Boolean(position.data.researcher?.name),
    )
    .map((position) => ({
        name: position.data.researcher.name,
        pc: position.data.pc,
        host: position.data.host || position.data.location,
        title: position.data.title,
        href: `/${lang}${getContentLink(lang, "positions", position.id, true)}`,
        supervisors: (position.data.supervisors || [])
            .map((s) => s.name)
            .filter(Boolean),
    }))
    .sort(
        (a, b) =>
            (a.pc || "").localeCompare(b.pc || "") ||
            a.name.localeCompare(b.name),
    );
---

<div class="not-prose my-6">
    <p class="text-sm text-gray-600 mb-4">
        {t("phd-club.members.intro").replace("{count}", members.length.toString())}
    </p>

    {
        members.length === 0 ? (
            <p class="text-gray-500 italic">{t("phd-club.members.empty")}</p>
        ) : (
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0 m-0">
                {members.map((member) => (
                    <li class="card bg-white border shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h4 class="text-base font-semibold text-gray-900 mt-0 mb-1 leading-tight">
                                    {member.name}
                                </h4>
                                {member.host && (
                                    <p class="text-sm text-gray-600 m-0">{member.host}</p>
                                )}
                            </div>
                            {member.pc && <Badge key={member.pc} t={t} />}
                        </div>

                        <p class="text-sm mt-3 mb-1">
                            <a
                                href={member.href}
                                class="text-primary-700 hover:text-primary-800 underline"
                            >
                                {member.title}
                            </a>
                        </p>

                        {member.supervisors.length > 0 && (
                            <p class="text-xs text-gray-500 m-0">
                                {t("phd-club.members.supervised-by")}{" "}
                                {member.supervisors.join(", ")}
                            </p>
                        )}
                    </li>
                ))}
            </ul>
        )
    }
</div>
