---
export interface Props {
    icsPath: string;
    label?: string;
}

const { icsPath, label = "Ajouter \u00e0 mon calendrier" } = Astro.props;
---

<a
    href={icsPath}
    download
    class="btn-calendar inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-primary-600 text-primary-600 bg-white hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 text-sm font-medium transition-colors duration-200"
    aria-label={label + " (.ics)"}
>
    <!-- Calendar icon -->
    <svg
        class="w4 h-4 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
    </svg>
    {label}
</a>
