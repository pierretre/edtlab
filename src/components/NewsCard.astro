---
import { formatDate } from "../utils";
import { linkHelpers } from "../i18n/links";
import type { Event } from "../models/Event.model";
import type { PressRelease } from "../models/PressRelease.model";
import Badge from "./Badge.astro";
import { NewsCategory } from "../models/NewsCategory.model";
import { Picture } from "astro:assets";

export interface Props {
    item: Event | PressRelease;
    lang: "en" | "fr";
    category: NewsCategory;
    coverImage: ImageMetadata;
    t: any;
    slug: string;
}

const { item, lang, category, coverImage, t, slug } = Astro.props;
---

<div
    class="news-item card relative p-0 bg-white border border-gray-200 rounded-lg shadow"
    data-category={category}
    data-date={item.date.getTime()}
    data-project={item.project ?? ""}
    data-search-text={`${JSON.stringify(item)}`.toLowerCase()}
>
    <!-- Badges -->
    <div class="absolute top-2 left-2 z-10">
        {(<Badge key={category} t={t} />)}
        <!-- Tag badges -->
        {item.tags?.map((tag) => <Badge key={tag} t={t} />)}
        {item.project && <Badge key={item.project} t={t} />}
    </div>

    <a
        href={category === NewsCategory.PressRelease
            ? linkHelpers.press(lang, slug)
            : linkHelpers.event(lang, slug)}
        class="relative block h-48 overflow-hidden group rounded-t-lg"
    >
        <Picture
            class="h-full w-full object-cover transform transition duration-500 group-hover:scale-105"
            src={coverImage}
            alt={item.title}
        />
        <div
            class="absolute inset-0 bg-black bg-opacity-0 transition duration-500 group-hover:bg-opacity-30"
        >
        </div>
    </a>
    <div class="p-3">
        <div class="flex justify-between">
            <p class="text-sm">
                {formatDate(item.date, lang)}
            </p>
            <p class="text-sm">
                {category === "event" ? (item as any).location : ""}
            </p>
        </div>

        <h4 class="text-base">
            <a
                href={category === NewsCategory.PressRelease
                    ? linkHelpers.press(lang, slug)
                    : linkHelpers.event(lang, slug)}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.title}
            </a>
        </h4>
    </div>
</div>
