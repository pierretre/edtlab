---
import { formatDate } from "@utils/./";
import Badge from "@components/Badge.astro";
import type { NewsItem } from "@models/NewsItem.model";

export interface Props {
    item: NewsItem;
    lang: "en" | "fr";
    t: any;
    href: string;
}

const { item, lang, href, t } = Astro.props;

const badges = [
    item.newsType,
    ...(item.tags || []).filter((tag) => tag && tag.trim()),
];
---

<div
    class="news-item card hover:shadow-lg relative p-0 bg-white border border-gray-200 rounded-lg shadow max-w-sm w-full mx-auto h-full flex flex-col"
    data-date={item.date.getTime()}
    data-tags={item.tags?.join(",")}
    data-category={item.newsType}
    data-search-text={`${JSON.stringify(item)}`.toLowerCase()}
>
    <!-- Badges -->
    <div class="absolute top-2 left-2 z-10 gap-2 flex flex-wrap">
        {badges.map((badge) => <Badge key={badge} t={t} />)}
    </div>

    <a
        href={href}
        class="relative block h-48 overflow-hidden group rounded-t-lg flex-shrink-0"
    >
        <img
            class="h-full w-full object-contain transition-transform duration-200 ease-out group-hover:scale-105"
            src={item.photo}
            alt={item.title}
            loading="lazy"
            decoding="async"
        />
        <div
            class="absolute inset-0 bg-black bg-opacity-0 transition duration-200 group-hover:bg-opacity-30"
        >
        </div>
    </a>
    <div class="p-3 flex-grow flex flex-col">
        <div class="flex justify-between mb-2 text-sm">
            <span class="">
                {formatDate(item.date, lang)}
            </span>
            <span class="text-sm">
                {item.newsType === "event" ? (item as any).location : ""}
            </span>
        </div>

        <h4 class="text-base line-clamp-3 mt-0">
            <a
                href={href}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.title}
            </a>
        </h4>
    </div>
</div>
