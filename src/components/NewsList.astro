---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import NewsCard from "./NewsCard.astro";

interface Props {
    lang: "en" | "fr";
    pageSize?: number;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

// Load content
const news = await getCollection("news", (item) => item.data.lang === lang);

const covers = import.meta.glob<{ default: ImageMetadata }>(
    "@assets/images/news-covers/*.{svg,jpg,png,gif,webp}",
);

// Add cover images to feed items
const feedWithCovers = await Promise.all(
    news.map(async (item) => {
        try {
            const coverImagePath = item.data.photo;
            const coverImage = (await covers[coverImagePath]()).default;
            return { ...item, coverImage: coverImage };
        } catch (err) {
            throw new Error(
                `Could not load cover image for news item "${item.data.title}". Path attempted: ${item.data.photo}. Original error: ${err}`,
            );
        }
    }),
);
// Project filter options
const projects = ["PC1", "PC2", "PC3", "PC4", "PC5"] as const;
---

<div class="container mx-auto max-w-8xl">
    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
            <div class="grid grid-cols-1 gap-2 sticky lg:top-24">
                <!-- Project Filter -->
                <div>
                    <label
                        for="project-filter"
                        class="block mb-2 text-sm font-medium text-gray-900"
                    >
                        {t("news.filter.project")}
                    </label>
                    <select id="project-filter" class="w-full">
                        <option value="">
                            {t("news.filter.all-projects")}
                        </option>
                        {
                            projects.map((project) => (
                                <option value={project}>{project}</option>
                            ))
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                <div>
                    <label
                        for="category-filter"
                        class="block mb-2 text-sm font-medium text-gray-900"
                    >
                        {t("news.filter.category")}
                    </label>
                    <select id="category-filter" class="w-full">
                        <option value="">
                            {t("news.filter.all-categories")}
                        </option>
                        <option value="press-release"
                            >{t("badge.press-release")}</option
                        >
                        <option value="event">{t("badge.event")}</option>
                    </select>
                </div>

                <!-- Sort Filter -->
                <div>
                    <label
                        for="sort-filter"
                        class="block mb-2 text-sm font-medium text-gray-900"
                    >
                        {t("news.filter.sort")}
                    </label>
                    <select id="sort-filter" class="w-full">
                        <option value="date-desc">
                            {t("news.filter.sort.date-desc")}
                        </option>
                        <option value="date-asc">
                            {t("news.filter.sort.date-asc")}
                        </option>
                        <option value="title-asc">
                            {t("news.filter.sort.title-asc")}
                        </option>
                        <option value="title-desc">
                            {t("news.filter.sort.title-desc")}
                        </option>
                    </select>
                </div>

                <!-- Search -->
                <div>
                    <label
                        for="search-filter"
                        class="block mb-2 text-sm font-medium text-gray-900"
                    >
                        {t("news.filter.search")}
                    </label>
                    <input
                        id="search-filter"
                        type="text"
                        class="w-full"
                        placeholder={t("news.filter.search-placeholder")}
                    />
                </div>

                <!-- Clear Filters -->
                <div class="flex justify-center">
                    <button
                        id="clear-filters"
                        class="text-primary-600 hover:underline text-sm font-medium"
                    >
                        {t("filter.clear")}
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <main class="flex-1">
            <!-- Results Count -->
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("news.results-count")}
                >
                    {
                        t("news.results-count").replace(
                            "{count}",
                            news.length.toString(),
                        )
                    }
                </span>
            </div>

            <div
                id="unified-list"
                class="grid gap-6"
                style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))"
            >
                {
                    feedWithCovers.map((item) => (
                        <NewsCard
                            item={item.data}
                            lang={lang}
                            coverImage={item.coverImage}
                            t={t}
                            slug={item.slug}
                        />
                    ))
                }
            </div>

            <!-- Pagination -->
            <nav
                id="news-pagination"
                class="mt-6 flex items-center justify-center"
                aria-label="Pagination"
            >
            </nav>
            <!-- No Results Message -->
            <div id="no-results" class="hidden text-center py-32">
                <div class="max-w-md mx-auto">
                    <h3 class="mt-4 text-lg font-medium text-gray-900">
                        {t("news.no-results")}
                    </h3>
                    <p class="mt-2 text-gray-500">
                        {t("news.no-results-description")}
                    </p>
                </div>
            </div>
        </main>
    </div>
</div>

<script type="module" is:inline>
    const qs = (s, el = document) => el.querySelector(s);
    const qsa = (s, el = document) => Array.from(el.querySelectorAll(s));

    const PAGE_SIZE = 12;
    let currentPage = 1;

    function renderPagination(totalPages) {
        const container = qs("#news-pagination");
        if (!container) return;
        container.innerHTML = "";

        if (totalPages <= 1) {
            container.style.display = "none";
            return;
        }
        container.style.display = "";

        const ul = document.createElement("ul");
        ul.className = "inline-flex -space-x-px text-sm m-0 p-0";

        const makeItem = (label, disabled, onClick, extra = "") => {
            const li = document.createElement("li");
            const a = document.createElement("a");

            a.type = "a";
            a.href = "#";
            a.innerHTML = label;

            a.className = `flex items-center justify-center text-heading font-medium w-9 h-9 border border-gray-300 text-body hover:bg-gray-100 hover:text-gray-700 ${extra}`;

            if (disabled) {
                a.classList.add("hover:text-fg-brand");
            } else {
                a.addEventListener("click", onClick);
            }

            li.appendChild(a);
            return li;
        };

        // ◀ Previous
        ul.appendChild(
            makeItem(
                `<span class="sr-only">Previous</span>
             <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>`,
                currentPage === 1,
                () => {
                    currentPage--;
                    updatePageDisplay();
                },
                "rounded-s-lg",
            ),
        );

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            ul.appendChild(
                makeItem(
                    i,
                    false,
                    () => {
                        currentPage = i;
                        updatePageDisplay();
                    },
                    i === currentPage
                        ? "bg-gray-100 font-semibold"
                        : "bg-white",
                ),
            );
        }

        // ▶ Next
        ul.appendChild(
            makeItem(
                `<span class="sr-only">Next</span>
             <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>`,
                currentPage === totalPages,
                () => {
                    currentPage++;
                    updatePageDisplay();
                },
                "rounded-e-lg",
            ),
        );

        container.appendChild(ul);
    }

    function updatePageDisplay() {
        const list = qs("#unified-list");
        if (!list) return;
        const matched = qsa(".news-item", list).filter(
            (c) => c.dataset.matched === "1",
        );
        const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;

        qsa(".news-item", list).forEach((c) => {
            c.style.display = "none";
        });

        const start = (currentPage - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;
        matched.forEach((c, idx) => {
            if (idx >= start && idx < end) c.style.display = "";
        });

        renderPagination(totalPages);

        // Update results count and show/hide no-results message
        const noResults = qs("#no-results");
        const resultsCount = qs("#results-count");
        const visibleCount = matched.length;
        if (resultsCount) {
            const template = resultsCount.dataset.template || "{count}";
            resultsCount.textContent = template.replace(
                "{count}",
                visibleCount.toString(),
            );
        }

        if (noResults) {
            if (visibleCount === 0) {
                list.style.display = "none";
                noResults.style.display = "block";
            } else {
                list.style.display = "";
                noResults.style.display = "none";
            }
        }
    }

    function applyFilters() {
        const searchEl = qs("#search-filter");
        const search = (searchEl ? searchEl.value : "").trim().toLowerCase();
        const categoryEl = qs("#category-filter");
        const category = categoryEl ? categoryEl.value : "";
        const projectEl = qs("#project-filter");
        const project = projectEl ? projectEl.value : "";

        const list = qs("#unified-list");
        if (!list) return;

        qsa(".news-item", list).forEach((item) => {
            const itemCategory = item.dataset.category || "";
            const itemTags = item.dataset.tags.toLowerCase() || "";
            const itemSearchText = item.dataset.searchText || "";

            const matchesCategory =
                !category || category === "" || itemCategory === category;
            const matchesProject =
                !project ||
                project === "" ||
                itemTags.includes(project.toLowerCase());

            console.log(itemTags, project);
            const matchesSearch = !search || itemSearchText.includes(search);

            item.dataset.matched =
                matchesCategory && matchesSearch && matchesProject ? "1" : "0";
        });

        // Sorting
        const sortEl = qs("#sort-filter");
        const sortVal = sortEl ? sortEl.value : "date-desc";

        const children = qsa(".news-item", list).slice();
        children.sort((a, b) => {
            const ad = parseInt(a.dataset.date || "0", 10);
            const bd = parseInt(b.dataset.date || "0", 10);

            if (sortVal === "date-desc") return bd - ad;
            if (sortVal === "date-asc") return ad - bd;

            // title compares (dataset.title is lowercased in NewsCard)
            const at = (a.dataset.title || "").toLowerCase();
            const bt = (b.dataset.title || "").toLowerCase();
            if (sortVal === "title-asc") return at.localeCompare(bt);
            if (sortVal === "title-desc") return bt.localeCompare(at);

            // default fallback: newest first
            return bd - ad;
        });
        children.forEach((c) => list.appendChild(c));

        currentPage = 1;
        updatePageDisplay();
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Grab filter elements
        const projectFilter = qs("#project-filter");
        const categoryFilter = qs("#category-filter");
        const searchFilter = qs("#search-filter");
        const sortFilter = qs("#sort-filter");

        // Wire selects to change, search to debounced input
        if (projectFilter)
            projectFilter.addEventListener("change", applyFilters);
        if (categoryFilter)
            categoryFilter.addEventListener("change", applyFilters);

        let debounceTimer;
        if (searchFilter) {
            searchFilter.addEventListener("input", () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(applyFilters, 200);
            });
        }

        // Reset / clear button clears filters and reapplies
        const resetBtn = qs("#clear-filters");
        if (resetBtn) {
            resetBtn.addEventListener("click", () => {
                if (searchFilter) searchFilter.value = "";
                if (categoryFilter) categoryFilter.value = "";
                if (projectFilter) projectFilter.value = "";
                currentPage = 1;
                applyFilters();
                if (searchFilter) searchFilter.focus();
            });
        }

        // Default values from URL parameters (support both ?type= and ?category= for compatibility)
        const urlParams = new URLSearchParams(window.location.search);
        if (categoryFilter) {
            categoryFilter.value = urlParams.get("category") || "";
        }
        if (projectFilter) {
            projectFilter.value = urlParams.get("project") || "";
        }
        if (searchFilter) {
            searchFilter.value = urlParams.get("search") || "";
        }
        if (sortFilter) {
            sortFilter.value = urlParams.get("sort") || "date-desc";
        }

        // initial apply
        applyFilters();
    });
</script>
