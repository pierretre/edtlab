---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import NewsCard from "./NewsCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import { newsFilterConfig } from "@utils/filter-configs";
import { linkHelpers } from "@i18n/links";
import type { NewsItem } from "~/models/NewsItem.model";

interface Props {
    lang: "en" | "fr";
    pageSize?: number;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

// Load content
const allNews = await getCollection("news", (item) => item.data.lang === lang);

const filteredNews = allNews.map((item) => ({
    data: item.data,
    href: linkHelpers.news(lang, item.id),
}));
---

<div class="w-screen relative left-1/2 right-1/2 ml-[-50vw] mr-[-50vw]">
    <div
        class="flex flex-col lg:flex-row gap-10 max-w-384 mx-auto px-4 sm:px-6 lg:px-8"
    >
        <!-- Sidebar -->
        <FilterSidebar
            filters={newsFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <!-- Main content -->
        <main class="flex-1">
            <!-- Results Count -->
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("news.results-count")}
                >
                    {
                        t("news.results-count").replace(
                            "{count}",
                            filteredNews.length.toString(),
                        )
                    }
                </span>
            </div>

            <div
                id="unified-list"
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            >
                {
                    filteredNews.map((item) => (
                        <NewsCard
                            item={item.data as NewsItem}
                            lang={lang}
                            href={item.href}
                            t={t}
                        />
                    ))
                }
            </div>

            <!-- Pagination -->
            <nav
                id="news-pagination"
                class="mt-6 flex items-center justify-center"
                aria-label="Pagination"
            >
            </nav>
            <!-- No Results Message -->
            <div id="no-results" class="hidden text-center py-32">
                <div class="max-w-md mx-auto">
                    <h3 class="mt-4 text-lg font-medium text-gray-900">
                        {t("news.no-results")}
                    </h3>
                    <p class="mt-2 text-gray-500">
                        {t("news.no-results-description")}
                    </p>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
    import { FilterManagerImpl } from "@utils/filtering";
    import { newsFilterConfig } from "@utils/filter-configs";

    const PAGE_SIZE = 12;
    let currentPage = 1;
    let filterManager: FilterManagerImpl | null = null;

    function renderPagination(totalPages: number) {
        const container = document.querySelector("#news-pagination");
        if (!container) return;
        container.innerHTML = "";

        if (totalPages <= 1) {
            (container as HTMLElement).style.display = "none";
            return;
        }
        (container as HTMLElement).style.display = "";

        const ul = document.createElement("ul");
        ul.className = "inline-flex -space-x-px text-sm m-0 p-0";

        const makeItem = (
            label: string,
            disabled: boolean,
            onClick: () => void,
            extra = "",
        ) => {
            const li = document.createElement("li");
            const a = document.createElement("a");

            a.href = "#";
            a.innerHTML = label;

            a.className = `flex items-center justify-center text-heading font-medium w-9 h-9 border border-gray-300 text-body hover:bg-gray-100 hover:text-gray-700 ${extra}`;

            if (!disabled) {
                a.addEventListener("click", (e) => {
                    e.preventDefault();
                    onClick();
                });
            } else {
                a.classList.add("opacity-50", "cursor-not-allowed");
            }

            li.appendChild(a);
            return li;
        };

        // Previous button
        ul.appendChild(
            makeItem(
                `<span class="sr-only">Previous</span>
             <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>`,
                currentPage === 1,
                () => {
                    currentPage--;
                    updatePageDisplay();
                },
                "rounded-s-lg",
            ),
        );

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            ul.appendChild(
                makeItem(
                    i.toString(),
                    false,
                    () => {
                        currentPage = i;
                        updatePageDisplay();
                    },
                    i === currentPage
                        ? "bg-gray-100 font-semibold"
                        : "bg-white",
                ),
            );
        }

        // Next button
        ul.appendChild(
            makeItem(
                `<span class="sr-only">Next</span>
             <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>`,
                currentPage === totalPages,
                () => {
                    currentPage++;
                    updatePageDisplay();
                },
                "rounded-e-lg",
            ),
        );

        container.appendChild(ul);
    }

    function updatePageDisplay() {
        const list = document.querySelector("#unified-list");
        if (!list) return;

        const matched = Array.from(list.querySelectorAll(".news-item")).filter(
            (c) => !(c as HTMLElement).classList.contains("hidden"),
        );

        const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;

        // Remove pagination class from all items first
        Array.from(list.querySelectorAll(".news-item")).forEach((c) => {
            (c as HTMLElement).classList.remove("pagination-hidden");
        });

        // Add pagination class to items not on current page
        const start = (currentPage - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;
        matched.forEach((c, idx) => {
            if (idx < start || idx >= end) {
                (c as HTMLElement).classList.add("pagination-hidden");
            }
        });

        renderPagination(totalPages);
    }

    function applySorting() {
        const sortEl = document.getElementById(
            "sort-filter",
        ) as HTMLSelectElement;
        if (!sortEl) return;

        const sortVal = sortEl.value;
        const list = document.querySelector("#unified-list");
        if (!list) return;

        const children = Array.from(list.querySelectorAll(".news-item"));
        children.sort((a, b) => {
            const aEl = a as HTMLElement;
            const bEl = b as HTMLElement;
            const ad = parseInt(aEl.dataset.date || "0", 10);
            const bd = parseInt(bEl.dataset.date || "0", 10);

            if (sortVal === "date-desc") return bd - ad;
            if (sortVal === "date-asc") return ad - bd;

            const at = (aEl.dataset.title || "").toLowerCase();
            const bt = (bEl.dataset.title || "").toLowerCase();
            if (sortVal === "title-asc") return at.localeCompare(bt);
            if (sortVal === "title-desc") return bt.localeCompare(at);

            return bd - ad;
        });

        children.forEach((c) => list.appendChild(c));
    }

    function initNewsFilters() {
        // Initialize filter manager
        filterManager = new FilterManagerImpl(newsFilterConfig);

        // Override applyFilters to integrate with pagination
        const originalApplyFilters =
            filterManager.applyFilters.bind(filterManager);
        filterManager.applyFilters = function () {
            originalApplyFilters();
            applySorting();
            currentPage = 1;
            updatePageDisplay();
        };

        filterManager.initialize();

        // Handle sorting separately
        const sortFilter = document.getElementById("sort-filter");
        if (sortFilter) {
            sortFilter.addEventListener("change", () => {
                applySorting();
                currentPage = 1;
                updatePageDisplay();
            });
        }

        // Initial display
        applySorting();
        updatePageDisplay();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initNewsFilters);
    } else {
        initNewsFilters();
    }
</script>

<style>
    /* Break out of parent container - requires custom CSS for viewport calculations */
    .news-list-breakout {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    /* News item styles - using Tailwind @apply */
    .news-item {
        @apply w-full h-auto;
    }

    /* Hidden states for filtering and pagination */
    .news-item.hidden,
    .news-item.pagination-hidden {
        @apply !hidden;
    }
</style>
