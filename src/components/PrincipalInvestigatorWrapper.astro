---
import PrincipalInvestigator from "./PrincipalInvestigator.astro";

export interface Props {
    name: string;
    headline: string;
    picture?: string;
}

const { name, headline, picture } = Astro.props;

// Load the image if a path is provided
let imageMetadata: ImageMetadata | undefined;
if (picture) {
    try {
        const images = import.meta.glob<{ default: ImageMetadata }>(
            "/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}",
            { eager: false },
        );

        if (images[picture]) {
            imageMetadata = (await images[picture]()).default;
        }
    } catch (error) {
        console.warn(`Could not load image: ${picture}`, error);
    }
}
---

<PrincipalInvestigator name={name} headline={headline} picture={imageMetadata}>
    <slot />
</PrincipalInvestigator>
