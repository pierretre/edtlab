---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import PositionCard from "./PositionCard.astro";
import { linkHelpers } from "@i18n/links";
import { formatDate } from "@utils/date";

export interface Props {
    project?: string;
}

const { project } = Astro.props as Props;

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

let openPositions: any[] = [];
let ongoingPositions: any[] = [];
if (project) {
    try {
        const allPositions = await getCollection("positions");
        const forProject = allPositions.filter((p) => p.data.pc === project);

        openPositions = forProject.filter((p) => !p.data.filled).slice(0, 3);

        ongoingPositions = forProject
            .filter((p) => p.data.filled && p.data.researcher)
            .filter((p) => !p.data.lang || p.data.lang === lang)
            .sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0));
    } catch (error) {
        console.warn(`Could not load positions: ${error}`);
    }
}
---

<!-- Related Open Positions Section -->{
    openPositions.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <h2 id="related-positions" class="font-semibold text-gray-900 mb-4 mt-0">
                {t("projects.related-positions.title")}
            </h2>

            <div class="grid grid-cols-1 gap-4">
                {openPositions.map((position) => (
                    <PositionCard item={position.data} lang={lang} t={t} slug={position.id} />
                ))}
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100">
                <a
                    href={`${linkHelpers.careers(lang)}?project=${project}`}
                    class="text-sm text-primary-600 hover:text-primary-800 font-medium transition-colors"
                >
                    {t("projects.related-positions.view-all")} →
                </a>
            </div>
        </div>
    )
}

<!-- Ongoing Positions Section -->{
    ongoingPositions.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <h2 id="ongoing-positions" class="font-semibold text-gray-900 mb-4 mt-0">
                {t("positions.ongoing.title")}
            </h2>

            <div class="space-y-4">
                {ongoingPositions.map((p) => (
                    <a
                        href={linkHelpers.position(lang, p.id)}
                        class="block bg-gray-50 rounded-lg p-4 border border-gray-200 hover:bg-gray-100 hover:border-gray-300 transition-colors duration-200 group"
                    >
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-primary-100 text-primary-800">
                                {(t as any)(`positions.type.${p.data.type}`)}
                            </span>
                        </div>

                        <h3 class="font-bold tracking-tight text-gray-900 line-clamp-2 mt-0 group-hover:text-primary-600 transition-colors duration-200">
                            {p.data.title}
                        </h3>

                        <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600">
                            <div class="flex items-center">
                                <span class="font-medium text-gray-800">{p.data.researcher.name}</span>
                                {p.data.supervisors && p.data.supervisors.length > 0 && (
                                    <span class="text-gray-500 ml-1">
                                        {" "}
                                        · {t("positions.supervised-by")}{" "}
                                        {p.data.supervisors.map((sup: any) => sup.name).join(", ")}
                                    </span>
                                )}
                            </div>

                            <div class="flex items-center">
                                <span>{p.data.location}</span>
                            </div>

                            {p.data.startDate && (
                                <div class="flex items-center">
                                    <span>
                                        {t("positions.start-date")}: {formatDate(p.data.startDate, lang)}
                                    </span>
                                </div>
                            )}
                        </div>

                        {p.data.description && (
                            <p class="text-gray-700 text-sm line-clamp-2 my-0">{p.data.description}</p>
                        )}
                    </a>
                ))}
            </div>
        </div>
    )
}
