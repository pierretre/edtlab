---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
    id="cookie-consent-banner"
    class="fixed bottom-0 left-0 right-0 bg-white border-t-2 border-scampi-500 shadow-lg z-50 transform translate-y-full transition-transform duration-300 ease-in-out"
    role="dialog"
    aria-labelledby="cookie-consent-title"
    aria-describedby="cookie-consent-description"
    aria-hidden="true"
>
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
        <div
            class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        >
            <div class="flex-1">
                <h3
                    id="cookie-consent-title"
                    class="text-lg font-semibold text-gray-900 mb-2"
                >
                    {t("cookies.title")}
                </h3>
                <p
                    id="cookie-consent-description"
                    class="text-sm text-gray-600 leading-relaxed"
                >
                    {t("cookies.description")}
                    <a
                        href={`/${lang}/privacy-policy`}
                        class="text-scampi-600 hover:text-scampi-800 underline focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 rounded"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t("cookies.privacy-policy")}
                    </a>
                </p>
            </div>

            <div
                class="flex flex-col sm:flex-row gap-2 sm:gap-3 w-full sm:w-auto"
            >
                <button
                    id="cookie-consent-essential"
                    type="button"
                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 transition-colors duration-200"
                    aria-describedby="cookie-consent-description"
                >
                    {t("cookies.essential-only")}
                </button>

                <button
                    id="cookie-consent-accept"
                    type="button"
                    class="px-4 py-2 text-sm font-medium text-white bg-scampi-600 border border-transparent rounded-md hover:bg-scampi-700 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 transition-colors duration-200"
                    aria-describedby="cookie-consent-description"
                >
                    {t("cookies.accept-all")}
                </button>

                <button
                    id="cookie-consent-customize"
                    type="button"
                    class="px-4 py-2 text-sm font-medium text-scampi-600 bg-transparent border border-scampi-600 rounded-md hover:bg-scampi-50 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 transition-colors duration-200"
                    aria-describedby="cookie-consent-description"
                >
                    {t("cookies.customize")}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cookie Preferences Modal -->
<div
    id="cookie-preferences-modal"
    class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden"
    role="dialog"
    aria-labelledby="cookie-preferences-title"
    aria-modal="true"
>
    <div class="flex items-center justify-center min-h-screen px-4 py-6">
        <div
            class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto"
        >
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h2
                        id="cookie-preferences-title"
                        class="text-xl font-semibold text-gray-900"
                    >
                        {t("cookies.preferences-title")}
                    </h2>
                    <button
                        id="cookie-preferences-close"
                        type="button"
                        class="text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 rounded"
                        aria-label={t("cookies.close")}
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="px-6 py-4 space-y-6">
                <!-- Essential Cookies -->
                <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-lg font-medium text-gray-900">
                            {t("cookies.essential-title")}
                        </h3>
                        <span
                            class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded"
                        >
                            {t("cookies.always-active")}
                        </span>
                    </div>
                    <p class="text-sm text-gray-600">
                        {t("cookies.essential-description")}
                    </p>
                </div>

                <!-- Analytics Cookies -->
                <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-lg font-medium text-gray-900">
                            {t("cookies.analytics-title")}
                        </h3>
                        <label
                            class="relative inline-flex items-center cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                id="analytics-cookies-toggle"
                                class="sr-only peer"
                                aria-describedby="analytics-cookies-description"
                            />
                            <div
                                class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-scampi-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-scampi-600"
                            >
                            </div>
                            <span class="sr-only"
                                >{t("cookies.toggle-analytics")}</span
                            >
                        </label>
                    </div>
                    <p
                        id="analytics-cookies-description"
                        class="text-sm text-gray-600"
                    >
                        {t("cookies.analytics-description")}
                    </p>
                    <div class="mt-2 text-xs text-gray-500">
                        <strong>{t("cookies.data-collected")}:</strong>
                        <ul class="list-disc list-inside mt-1 space-y-1">
                            <li>{t("cookies.page-views")}</li>
                            <li>{t("cookies.user-interactions")}</li>
                            <li>{t("cookies.geographic-data")}</li>
                            <li>{t("cookies.language-preferences")}</li>
                            <li>{t("cookies.device-info")}</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div
                class="px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row gap-3 sm:justify-end"
            >
                <button
                    id="cookie-preferences-save"
                    type="button"
                    class="px-4 py-2 text-sm font-medium text-white bg-scampi-600 border border-transparent rounded-md hover:bg-scampi-700 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 transition-colors duration-200"
                >
                    {t("cookies.save-preferences")}
                </button>
                <button
                    id="cookie-preferences-cancel"
                    type="button"
                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-scampi-500 focus:ring-offset-2 transition-colors duration-200"
                >
                    {t("cookies.cancel")}
                </button>
            </div>
        </div>
    </div>
</div>

<script is:inline>
    // Cookie consent management
    (function () {
        const CONSENT_KEY = "cookie-consent";
        const ANALYTICS_KEY = "analytics-consent";
        const CONSENT_VERSION = "1.0";

        const banner = document.getElementById("cookie-consent-banner");
        const modal = document.getElementById("cookie-preferences-modal");
        const analyticsToggle = document.getElementById(
            "analytics-cookies-toggle",
        );

        // Check if consent has already been given
        function hasConsent() {
            const consent = localStorage.getItem(CONSENT_KEY);
            return consent && JSON.parse(consent).version === CONSENT_VERSION;
        }

        // Show banner if no consent
        function showBanner() {
            if (!hasConsent()) {
                banner.classList.remove("translate-y-full");
                banner.setAttribute("aria-hidden", "false");

                // Focus management for accessibility
                setTimeout(() => {
                    const firstButton = banner.querySelector("button");
                    if (firstButton) {
                        firstButton.focus();
                    }
                }, 300);
            }
        }

        // Hide banner
        function hideBanner() {
            banner.classList.add("translate-y-full");
            banner.setAttribute("aria-hidden", "true");
        }

        // Save consent preferences
        function saveConsent(analytics = false) {
            const consent = {
                version: CONSENT_VERSION,
                timestamp: Date.now(),
                analytics: analytics,
                essential: true,
            };

            localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
            localStorage.setItem(ANALYTICS_KEY, analytics.toString());

            // Enable/disable Matomo based on consent
            if (window.matomoTrack) {
                if (analytics) {
                    window.matomoTrack.enableCookies();
                } else {
                    window.matomoTrack.disableCookies();
                }
            }

            hideBanner();

            // Announce to screen readers
            if (window.announceToScreenReader) {
                window.announceToScreenReader(
                    analytics
                        ? "Cookie preferences saved. Analytics enabled."
                        : "Cookie preferences saved. Only essential cookies enabled.",
                    "polite",
                );
            }
        }

        // Show preferences modal
        function showModal() {
            modal.classList.remove("hidden");
            modal.setAttribute("aria-hidden", "false");

            // Set current analytics preference
            const currentConsent = localStorage.getItem(CONSENT_KEY);
            if (currentConsent) {
                const consent = JSON.parse(currentConsent);
                analyticsToggle.checked = consent.analytics;
            }

            // Focus first interactive element
            const firstButton = modal.querySelector("button");
            if (firstButton) {
                firstButton.focus();
            }

            // Trap focus within modal
            trapFocus(modal);
        }

        // Hide preferences modal
        function hideModal() {
            modal.classList.add("hidden");
            modal.setAttribute("aria-hidden", "true");

            // Return focus to customize button
            const customizeButton = document.getElementById(
                "cookie-consent-customize",
            );
            if (customizeButton) {
                customizeButton.focus();
            }
        }

        // Focus trap utility
        function trapFocus(element) {
            const focusableElements = element.querySelectorAll(
                'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
            );
            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            element.addEventListener("keydown", function (e) {
                if (e.key === "Tab") {
                    if (e.shiftKey) {
                        if (document.activeElement === firstElement) {
                            e.preventDefault();
                            lastElement.focus();
                        }
                    } else {
                        if (document.activeElement === lastElement) {
                            e.preventDefault();
                            firstElement.focus();
                        }
                    }
                }

                if (e.key === "Escape") {
                    hideModal();
                }
            });
        }

        // Event listeners
        document.addEventListener("DOMContentLoaded", function () {
            // Show banner on page load
            showBanner();

            // Banner buttons
            document
                .getElementById("cookie-consent-essential")
                ?.addEventListener("click", function () {
                    saveConsent(false);
                });

            document
                .getElementById("cookie-consent-accept")
                ?.addEventListener("click", function () {
                    saveConsent(true);
                });

            document
                .getElementById("cookie-consent-customize")
                ?.addEventListener("click", function () {
                    showModal();
                });

            // Modal buttons
            document
                .getElementById("cookie-preferences-close")
                ?.addEventListener("click", hideModal);
            document
                .getElementById("cookie-preferences-cancel")
                ?.addEventListener("click", hideModal);

            document
                .getElementById("cookie-preferences-save")
                ?.addEventListener("click", function () {
                    const analyticsEnabled = analyticsToggle.checked;
                    saveConsent(analyticsEnabled);
                    hideModal();
                });

            // Close modal on backdrop click
            modal?.addEventListener("click", function (e) {
                if (e.target === modal) {
                    hideModal();
                }
            });

            // Keyboard navigation
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    if (!modal.classList.contains("hidden")) {
                        hideModal();
                    }
                }
            });
        });

        // Expose consent status for other scripts
        window.cookieConsent = {
            hasConsent: hasConsent,
            hasAnalyticsConsent: function () {
                return localStorage.getItem(ANALYTICS_KEY) === "true";
            },
            showPreferences: showModal,
            revokeConsent: function () {
                localStorage.removeItem(CONSENT_KEY);
                localStorage.removeItem(ANALYTICS_KEY);
                if (window.matomoTrack) {
                    window.matomoTrack.disableCookies();
                }
                showBanner();
            },
        };
    })();
</script>

<style>
    /* Ensure banner is above other fixed elements */
    #cookie-consent-banner {
        z-index: 9999;
    }

    /* Smooth transitions */
    #cookie-consent-banner {
        transition: transform 0.3s ease-in-out;
    }

    /* Focus styles for better accessibility */
    #cookie-consent-banner button:focus,
    #cookie-preferences-modal button:focus {
        outline: 2px solid #665ba7;
        outline-offset: 2px;
    }

    /* Toggle switch styling */
    .peer:checked ~ .peer-checked\:bg-scampi-600 {
        background-color: #665ba7;
    }

    .peer:focus ~ .peer-focus\:ring-scampi-300 {
        box-shadow: 0 0 0 4px rgba(102, 91, 167, 0.3);
    }
</style>
