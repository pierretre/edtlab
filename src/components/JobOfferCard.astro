---
import { linkHelpers } from "../i18n/links";
import { formatDate, isDeadlineApproaching, isDeadlinePassed } from "../utils";
import Badge from "./Badge.astro";
import type { JobOffer } from "../models/JobOffer.model";

interface Props {
    item: JobOffer;
    lang: "en" | "fr";
    t: any;
    slug: string;
}

const { item, lang, t, slug } = Astro.props;
const isExpired = item.deadline < new Date();
---

<div
    class="job-offer-item card h-full flex flex-col"
    data-project={item.project}
    data-type={item.type}
    data-status={isExpired ? "expired" : "active"}
    data-search-text={`${JSON.stringify(item)}`.toLowerCase()}
>
    <!-- Header with badges -->
    <div class="flex flex-wrap gap-2 mb-3">
        <Badge key={item.project} t={t} />

        <Badge key={`job-offers.type.${item.type}`} t={t} />

        {
            isDeadlineApproaching(item.deadline) && (
                <Badge key="job-offers.deadline-approaching" t={t} />
            )
        }
        {
            isDeadlinePassed(item.deadline) && (
                <Badge key="job-offers.deadline-passed" t={t} />
            )
        }
    </div>

    <!-- Title -->
    <h3 class="mb-2 font-bold tracking-tight text-gray-900 line-clamp-2">
        {item.title}
    </h3>

    <!-- Description -->
    <p class="mb-3 text-gray-700 text-sm line-clamp-3">
        {item.description}
    </p>

    <!-- Location, Published Date, and Deadline -->
    <div class="mb-4 space-y-2">
        <div class="flex items-center text-sm text-gray-600">
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {item.location}
        </div>
        <div class="flex items-center text-sm text-gray-600">
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            {t("job-offers.published")}: {formatDate(item.publishedDate, lang)}
        </div>
        <div class="flex items-center text-sm text-gray-600">
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
            </svg>
            <span class={isDeadlinePassed(item.deadline) ? "text-red-600" : ""}>
                {t("job-offers.deadline")}: {formatDate(item.deadline, lang)}
            </span>
        </div>
    </div>

    <!-- Requirements preview -->
    {
        item.requirements.length > 0 && (
            <div>
                <div class="text-sm font-semibold text-gray-900 mb-2">
                    {t("job-offers.key-requirements")}
                </div>
                <ul class="text-sm text-gray-600 space-y-1">
                    {item.requirements.slice(0, 2).map((req) => (
                        <li class="flex items-start">
                            <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 mr-2 flex-shrink-0" />
                            <span class="line-clamp-1">{req}</span>
                        </li>
                    ))}
                    {item.requirements.length > 2 && (
                        <li class="text-gray-500 text-xs">
                            {t("job-offers.more-requirements").replace(
                                "{count}",
                                (item.requirements.length - 2).toString(),
                            )}
                        </li>
                    )}
                </ul>
            </div>
        )
    }

    <!-- Action button -->
    <a
        href={linkHelpers.jobOffer(lang, slug)}
        class="btn-primary inline-flex mt-auto mx-auto"
        aria-label={t("job-offers.view-details-aria").replace(
            "{title}",
            item.title,
        )}
    >
        {t("job-offers.view-details")}
        <svg
            class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
            aria-hidden="true"
            fill="none"
            viewBox="0 0 14 10"
        >
            <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg>
    </a>
</div>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
