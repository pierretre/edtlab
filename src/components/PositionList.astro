---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import PositionCard from "./PositionCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import { positionsFilterConfig } from "@utils/filter-configs";

interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get all open positions for the current language, excluding filled ones
// (filled/occupied positions are surfaced on the project (PC) pages instead)
const allPositions = (await getCollection("positions")).filter(
    (position) => !position.data.filled,
);

// Sort positions: EDT first, then external; within each group by date then title
const isExtern = (position: (typeof allPositions)[number]) =>
    (position.data.tags || []).some((t) => t.toLowerCase() === "extern");

const sortedPositions = allPositions.sort((a, b) => {
    // External offers go after EDT offers
    const aExt = isExtern(a) ? 1 : 0;
    const bExt = isExtern(b) ? 1 : 0;
    if (aExt !== bExt) return aExt - bExt;

    // Within same group, sort by published date (newest first)
    const aDate = a.data.publishedDate?.getTime() ?? 0;
    const bDate = b.data.publishedDate?.getTime() ?? 0;
    if (aDate !== bDate) {
        return bDate - aDate;
    }

    // Finally by title
    return (a.data.title || "").localeCompare(b.data.title || "");
});

---

<div class="w-full mb-12">
    <!-- Header with statistics -->
    <div class="mb-6 p-4 bg-primary-50 rounded-lg border border-primary-200">
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between"
        >
            <div>
                <h2 class="text-lg font-semibold text-primary-800 mb-1">
                    {t("positions.current-opportunities")}
                </h2>
                <p class="text-primary-600 text-sm font-bold mb-0">
                    {
                        t("positions.available-count").replace(
                            "{count}",
                            sortedPositions.length.toString(),
                        )
                    }
                </p>
            </div>
            <div class="mt-3 sm:mt-0">
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-100 text-primary-600"
                >
                    {
                        t("positions.total-positions").replace(
                            "{count}",
                            sortedPositions.length.toString(),
                        )
                    }
                </span>
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Filter Sidebar -->
        <FilterSidebar
            filters={positionsFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <main class="flex-1">
            <!-- Results Count -->
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("positions.results-count")}
                >
                    {
                        t("positions.results-count").replace(
                            "{count}",
                            sortedPositions.length.toString(),
                        )
                    }
                </span>
            </div>

            <!-- Positions Grid -->
            <div id="positions-grid" class="grid grid-cols-1 gap-6 min-h-48">
                {
                    sortedPositions.map((position) => (
                        <PositionCard
                            item={position.data}
                            body={position.body}
                            lang={lang}
                            slug={position.id}
                            t={t}
                        />
                    ))
                }
            </div>
        </main>

        <!-- No Results Message -->
        <div id="no-results" class="hidden text-center py-32">
            <div class="max-w-md mx-auto">
                <h3 class="mt-4 text-lg font-medium text-gray-900">
                    {t("positions.no-results")}
                </h3>
                <p class="mt-2 text-gray-500">
                    {t("positions.no-results-description")}
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    import { FilterManagerImpl } from "@utils/filtering";
    import { positionsFilterConfig } from "@utils/filter-configs";

    // Initialize filter manager - handle both cases where DOM might already be ready
    function initFilters() {
        const filterManager = new FilterManagerImpl(positionsFilterConfig);
        filterManager.initialize();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initFilters);
    } else {
        initFilters();
    }
</script>

<style>
    .position-item {
        transition: opacity 0.2s ease;
    }

    .position-item.hidden {
        display: none;
    }
</style>
