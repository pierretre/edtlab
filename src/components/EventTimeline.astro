---
import { getCollection } from "astro:content";
import { linkHelpers } from "@i18n/links";

interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props;

type TimelineItem = {
    date: Date;
    title: string;
    location?: string;
    isMilestone: boolean;
    slug?: string;
};

const allEvents = await getCollection("news", (item) =>
    item.data.newsType === "event" && item.data.lang === lang
);

const milestones: TimelineItem[] = lang === "fr" ? [
    { date: new Date("2026-01-01"), title: "T0 — Démarrage du programme", isMilestone: true },
    { date: new Date("2026-06-24"), title: "Réunion de lancement", isMilestone: true },
    { date: new Date("2031-12-31"), title: "Fin du programme", isMilestone: true },
] : [
    { date: new Date("2026-01-01"), title: "T0 — Program start", isMilestone: true },
    { date: new Date("2026-06-24"), title: "Kick Off Meeting", isMilestone: true },
    { date: new Date("2031-12-31"), title: "End of program", isMilestone: true },
];

const eventItems: TimelineItem[] = allEvents.map(e => ({
    date: e.data.date,
    title: e.data.title,
    location: e.data.location,
    isMilestone: false,
    slug: e.slug,
}));

const allItems = [...eventItems, ...milestones].sort((a, b) => a.date.getTime() - b.date.getTime());
const now = new Date();

function fmtDate(date: Date): string {
    return date.toLocaleDateString(lang === "fr" ? "fr-FR" : "en-US", {
        day: "numeric", month: "short", year: "numeric",
    });
}
---

<div class="timeline-wrapper relative my-8">
    <button id="tl-left" class="absolute left-0 top-[100px] z-10 w-9 h-9 bg-white/90 border border-gray-200 rounded-full shadow flex items-center justify-center hover:bg-gray-100" aria-label="Scroll left">
        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="tl-right" class="absolute right-0 top-[100px] z-10 w-9 h-9 bg-white/90 border border-gray-200 rounded-full shadow flex items-center justify-center hover:bg-gray-100" aria-label="Scroll right">
        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
    </button>

    <div id="tl-scroll" class="overflow-x-auto px-12 tl-scrollbar cursor-grab">
        <div class="relative min-w-max px-10">

            <!-- Labels above the line -->
            <div class="flex items-end" style="min-height: 160px; padding-bottom: 12px;">
                {allItems.map((item) => {
                    const past = item.date < now;
                    const href = !item.isMilestone && item.slug ? linkHelpers.event(lang, item.slug) : undefined;
                    return (
                        <div class="flex items-end justify-center w-[140px]">
                            <div class="-rotate-45 origin-bottom-left ml-8">
                                <time class={`text-[10px] font-mono block ${past ? 'text-gray-400' : 'text-gray-500'}`}>
                                    {fmtDate(item.date)}
                                </time>
                                {href ? (
                                    <a href={href} class={`text-xs font-semibold leading-tight hover:underline block ${past ? 'text-gray-500' : 'text-indigo-700'}`}>
                                        {item.title}
                                    </a>
                                ) : (
                                    <span class={`text-xs font-semibold leading-tight italic block ${past ? 'text-gray-400' : 'text-indigo-600'}`}>
                                        {item.title}
                                    </span>
                                )}
                                {item.location && (
                                    <span class="text-[10px] text-gray-500 block mt-0.5">{item.location}</span>
                                )}
                            </div>
                        </div>
                    );
                })}
            </div>

            <!-- Line + dots -->
            <div class="relative flex items-center h-6">
                <div class="absolute inset-x-0 top-1/2 h-0.5 bg-gradient-to-r from-gray-300 to-indigo-400"></div>
                <div class="relative flex w-full">
                    {allItems.map((item) => {
                        const past = item.date < now;
                        const color = past ? 'bg-gray-400' : 'bg-indigo-500';
                        const size = item.isMilestone ? 'w-3 h-3' : 'w-4 h-4';
                        return (
                            <div class="flex items-center justify-center w-[140px]">
                                <div class={`${size} rounded-full ${color} border-2 border-white shadow z-10`}></div>
                            </div>
                        );
                    })}
                </div>
            </div>

        </div>
    </div>

    {allItems.length === 0 && (
        <p class="text-center text-gray-500 py-8">
            {lang === "fr" ? "Aucun événement pour le moment." : "No events yet."}
        </p>
    )}
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const c = document.getElementById('tl-scroll');
        const l = document.getElementById('tl-left');
        const r = document.getElementById('tl-right');
        if (!c || !l || !r) return;

        l.addEventListener('click', () => c.scrollBy({ left: -320, behavior: 'smooth' }));
        r.addEventListener('click', () => c.scrollBy({ left: 320, behavior: 'smooth' }));

        const updateBtns = () => {
            l.style.opacity = c.scrollLeft <= 0 ? '0.3' : '1';
            r.style.opacity = c.scrollLeft >= c.scrollWidth - c.clientWidth - 10 ? '0.3' : '1';
        };
        c.addEventListener('scroll', updateBtns);
        updateBtns();

        let down = false, sx = 0, sl = 0;
        c.addEventListener('mousedown', (e) => { down = true; c.style.cursor = 'grabbing'; sx = e.pageX; sl = c.scrollLeft; });
        c.addEventListener('mouseleave', () => { down = false; c.style.cursor = 'grab'; });
        c.addEventListener('mouseup', () => { down = false; c.style.cursor = 'grab'; });
        c.addEventListener('mousemove', (e) => { if (!down) return; e.preventDefault(); c.scrollLeft = sl - (e.pageX - sx); });
    });
</script>

<style>
    .tl-scrollbar::-webkit-scrollbar { height: 6px; }
    .tl-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 3px; }
    .tl-scrollbar::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
    .tl-scrollbar::-webkit-scrollbar-thumb:hover { background: #aaa; }
</style>
