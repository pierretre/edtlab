---
import { getCollection, getEntry } from "astro:content";
import { linkHelpers } from "@i18n/links";

interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props;

type TimelineItem = {
    date: Date;
    title: string;
    location?: string;
    slug?: string;
    timeLabel?: string;
};

const allEvents = await getCollection("news", (item) =>
    item.data.newsType === "event" && item.data.lang === lang
);

const calendarEntry = await getEntry("calendar", lang);
const calendarItems: TimelineItem[] = (calendarEntry?.data.items ?? []).map(item => ({
    date: new Date(item.date),
    title: item.title,
    location: item.location,
    timeLabel: item.timeLabel,
}));

const eventItems: TimelineItem[] = allEvents.map(e => ({
    date: e.data.date,
    title: e.data.title,
    location: e.data.location,
    slug: e.slug,
}));

const allItems = [...calendarItems, ...eventItems].sort((a, b) => a.date.getTime() - b.date.getTime());
const now = new Date();

const todayLabel = lang === "fr" ? "Aujourd'hui" : "Today";

const COLOR_ITEM = "#665BA7";       // primary brand violet — single color for all items
const COLOR_PAST = "#737373";
const COLOR_TODAY = "#ef4444";

// ---- Time-proportional axis ----------------------------------------------
const INNER_WIDTH = 4800;          // px -- ~80px per month over ~5 years
const MIN_GAP_PX = 30;             // minimum px between displayed dots

const sixMonthsAhead = new Date(now.getFullYear(), now.getMonth() + 6, now.getDate());
const itemMs = allItems.map(it => it.date.getTime());
const minMs = Math.min(now.getTime(), ...(itemMs.length ? itemMs : [now.getTime()]));
const maxMs = Math.max(sixMonthsAhead.getTime(), ...(itemMs.length ? itemMs : [sixMonthsAhead.getTime()]));
const spanMs = Math.max(1, maxMs - minMs);

function timeToX(d: Date | number): number {
    const t = typeof d === "number" ? d : d.getTime();
    return ((t - minMs) / spanMs) * INNER_WIDTH;
}

const positionedItems = allItems.map((item) => {
    const baseX = timeToX(item.date);
    return { item, baseX, x: baseX };
});
for (let i = 1; i < positionedItems.length; i++) {
    const prev = positionedItems[i - 1];
    const cur = positionedItems[i];
    if (cur.x - prev.x < MIN_GAP_PX) {
        cur.x = prev.x + MIN_GAP_PX;
    }
}

const todayX = timeToX(now);

// ---- Hierarchical date ticks --------------------------------------------
type Tick = { x: number; label: string; level: "year" | "quarter" | "month" };
const ticks: Tick[] = [];

const minDate = new Date(minMs);
const maxDate = new Date(maxMs);
const curYear = now.getFullYear();
const curMonth = now.getMonth();
const curQuarter = Math.floor(curMonth / 3) + 1;

const startYear = minDate.getFullYear();
const endYear = maxDate.getFullYear();
for (let y = startYear; y <= endYear; y++) {
    const d = new Date(y, 0, 1).getTime();
    if (d >= minMs && d <= maxMs) {
        ticks.push({ x: timeToX(d), label: String(y), level: "year" });
    }
}

const quarterPrefix = lang === "fr" ? "T" : "Q";
for (const m of [3, 6, 9]) {
    const d = new Date(curYear, m, 1).getTime();
    if (d >= minMs && d <= maxMs) {
        const qNum = m / 3 + 1;
        ticks.push({ x: timeToX(d), label: `${quarterPrefix}${qNum}`, level: "quarter" });
    }
}

const quarterStartMonth = (curQuarter - 1) * 3;
const monthFmt = new Intl.DateTimeFormat(lang === "fr" ? "fr-FR" : "en-US", { month: "short" });
for (let mOff = 1; mOff < 3; mOff++) {
    const m = quarterStartMonth + mOff;
    const d = new Date(curYear, m, 1);
    const dMs = d.getTime();
    if (dMs >= minMs && dMs <= maxMs) {
        ticks.push({ x: timeToX(dMs), label: monthFmt.format(d), level: "month" });
    }
}

function fmtDate(date: Date): string {
    return date.toLocaleDateString(lang === "fr" ? "fr-FR" : "en-US", {
        day: "numeric", month: "short", year: "numeric",
    });
}

const ABOVE_LANE_HEIGHT = 130;
const AXIS_HEIGHT = 24;
const BELOW_LANE_HEIGHT = 130;
const TOTAL_HEIGHT = ABOVE_LANE_HEIGHT + AXIS_HEIGHT + BELOW_LANE_HEIGHT;
---

<div class="timeline-wrapper relative my-8">

    <!-- Scrollable timeline content -->
    <div class="relative">
        <button id="tl-left" class="absolute left-0 top-1/2 -translate-y-1/2 z-20 w-9 h-9 bg-white/90 border border-gray-200 rounded-full shadow flex items-center justify-center hover:bg-gray-100" aria-label="Scroll left">
            <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="tl-right" class="absolute right-0 top-1/2 -translate-y-1/2 z-20 w-9 h-9 bg-white/90 border border-gray-200 rounded-full shadow flex items-center justify-center hover:bg-gray-100" aria-label="Scroll right">
            <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
        </button>

        <div id="tl-scroll" class="overflow-x-auto px-12 tl-scrollbar cursor-grab">
            <div class="relative" style={`width: ${INNER_WIDTH}px; height: ${TOTAL_HEIGHT}px;`}>

                <!-- Today marker line + badge -->
                <div
                    id="tl-today-marker"
                    class="absolute z-10 pointer-events-none"
                    style={`left: ${todayX}px; top: 0; width: 2px; height: ${TOTAL_HEIGHT}px; background-color: ${COLOR_TODAY};`}
                ></div>
                <div
                    class="absolute z-20 pointer-events-none"
                    style={`left: ${todayX}px; top: 0; transform: translateX(-50%);`}
                >
                    <span class="text-[10px] px-1 rounded text-white" style={`background-color: ${COLOR_TODAY};`}>{todayLabel}</span>
                </div>

                <!-- Above strip: items at even index (0, 2, 4, ...) -->
                <div class="absolute left-0 right-0" style={`top: 0; height: ${ABOVE_LANE_HEIGHT}px;`}>
                    {positionedItems.map(({ item, x }, idx) => {
                        if (idx % 2 !== 0) return null;
                        const past = item.date < now;
                        const titleColor = past ? COLOR_PAST : COLOR_ITEM;
                        const href = item.slug ? linkHelpers.event(lang, item.slug) : undefined;
                        return (
                            <div class="absolute" style={`left: ${x}px; bottom: 12px;`}>
                                <div class="-rotate-45 origin-bottom-left ml-2 whitespace-nowrap">
                                    <time class="text-[10px] font-mono block text-gray-500">
                                        {item.timeLabel ?? fmtDate(item.date)}
                                    </time>
                                    {href ? (
                                        <a href={href} class="text-xs font-semibold leading-tight hover:underline block" style={`color: ${titleColor}`}>
                                            {item.title}
                                        </a>
                                    ) : (
                                        <span class="text-xs font-semibold leading-tight block" style={`color: ${titleColor}`}>
                                            {item.title}
                                        </span>
                                    )}
                                    {item.location && (
                                        <span class="text-[10px] text-gray-500 block mt-0.5">{item.location}</span>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </div>

                <!-- Axis: line + ticks + dots (all items, single style) -->
                <div class="absolute left-0 right-0" style={`top: ${ABOVE_LANE_HEIGHT}px; height: ${AXIS_HEIGHT}px;`}>
                    <div class="absolute inset-x-0 top-1/2 h-0.5 bg-gradient-to-r from-gray-300 to-gray-400"></div>

                    {ticks.map((tick) => {
                        const isYear = tick.level === "year";
                        const tickColor = isYear ? "bg-gray-300" : "bg-gray-200";
                        return (
                            <>
                                <div
                                    class={`absolute ${tickColor}`}
                                    style={`left: ${tick.x}px; top: 50%; transform: translate(-50%, -50%); width: 1px; height: ${AXIS_HEIGHT}px;`}
                                ></div>
                                <div
                                    class="absolute text-[9px] text-gray-500 whitespace-nowrap"
                                    style={`left: ${tick.x}px; top: ${AXIS_HEIGHT}px; transform: translateX(-50%);`}
                                >
                                    {tick.label}
                                </div>
                            </>
                        );
                    })}

                    {positionedItems.map(({ item, x }) => {
                        const past = item.date < now;
                        const dotColor = past ? COLOR_PAST : COLOR_ITEM;
                        return (
                            <div
                                class="absolute rounded-full border-2 border-white shadow z-10"
                                style={`left: ${x}px; top: 50%; transform: translate(-50%, -50%); width: 12px; height: 12px; background-color: ${dotColor};`}
                            ></div>
                        );
                    })}
                </div>

                <!-- Below strip: items at odd index (1, 3, 5, ...) -->
                <div class="absolute left-0 right-0" style={`top: ${ABOVE_LANE_HEIGHT + AXIS_HEIGHT}px; height: ${BELOW_LANE_HEIGHT}px;`}>
                    {positionedItems.map(({ item, x }, idx) => {
                        if (idx % 2 !== 1) return null;
                        const past = item.date < now;
                        const titleColor = past ? COLOR_PAST : COLOR_ITEM;
                        const href = item.slug ? linkHelpers.event(lang, item.slug) : undefined;
                        return (
                            <div class="absolute" style={`left: ${x}px; top: 12px;`}>
                                <div class="rotate-45 origin-top-left ml-2 whitespace-nowrap">
                                    <time class="text-[10px] font-mono block text-gray-500">
                                        {item.timeLabel ?? fmtDate(item.date)}
                                    </time>
                                    {href ? (
                                        <a href={href} class="text-xs font-semibold leading-tight hover:underline block" style={`color: ${titleColor}`}>
                                            {item.title}
                                        </a>
                                    ) : (
                                        <span class="text-xs font-semibold leading-tight block" style={`color: ${titleColor}`}>
                                            {item.title}
                                        </span>
                                    )}
                                    {item.location && (
                                        <span class="text-[10px] text-gray-500 block mt-0.5">{item.location}</span>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </div>

            </div>
        </div>
    </div>

    {allItems.length === 0 && (
        <p class="text-center text-gray-500 py-8 w-full">
            {lang === "fr" ? "Aucun événement pour le moment." : "No events yet."}
        </p>
    )}
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const c = document.getElementById('tl-scroll');
        const l = document.getElementById('tl-left');
        const r = document.getElementById('tl-right');
        if (!c || !l || !r) return;

        l.addEventListener('click', () => c.scrollBy({ left: -320, behavior: 'smooth' }));
        r.addEventListener('click', () => c.scrollBy({ left: 320, behavior: 'smooth' }));

        const updateBtns = () => {
            l.style.opacity = c.scrollLeft <= 0 ? '0.3' : '1';
            r.style.opacity = c.scrollLeft >= c.scrollWidth - c.clientWidth - 10 ? '0.3' : '1';
        };
        c.addEventListener('scroll', updateBtns);
        updateBtns();

        let down = false, sx = 0, sl = 0;
        c.addEventListener('mousedown', (e) => { down = true; c.style.cursor = 'grabbing'; sx = e.pageX; sl = c.scrollLeft; });
        c.addEventListener('mouseleave', () => { down = false; c.style.cursor = 'grab'; });
        c.addEventListener('mouseup', () => { down = false; c.style.cursor = 'grab'; });
        c.addEventListener('mousemove', (e) => { if (!down) return; e.preventDefault(); c.scrollLeft = sl - (e.pageX - sx); });

        // Auto-scroll to center today on load
        requestAnimationFrame(() => {
            const todayMarker = document.getElementById('tl-today-marker');
            if (todayMarker && c) {
                const todayLeft = todayMarker.offsetLeft;
                const containerWidth = c.clientWidth;
                c.scrollLeft = Math.max(0, todayLeft - containerWidth / 2);
                updateBtns();
            }
        });
    });
</script>

<style>
    .tl-scrollbar::-webkit-scrollbar { height: 6px; }
    .tl-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 3px; }
    .tl-scrollbar::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
    .tl-scrollbar::-webkit-scrollbar-thumb:hover { background: #aaa; }
</style>
