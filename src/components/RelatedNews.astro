---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import NewsCard from "./NewsCard.astro";
import { linkHelpers } from "@i18n/links";

export interface Props {
  project?: string;
}

const { project } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);
let relatedItems: any[] = [];

if (project) {
  try {
    const news = await getCollection(
      "news",
      (item) =>
        item.data.lang === lang &&
        item.data.tags
          .map((t) => t.toLowerCase())
          ?.includes(project.toLowerCase()),
    );

    // CMS images are now in public/media/uploads - no import needed
    relatedItems = news
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3)
      .map((item) => ({
        ...item,
        coverImage: item.data.photo, // URL like "/media/uploads/photo.jpg"
      }));
  } catch (error) {
    console.warn(`Could not load news/events: ${error}`);
  }
}
---

<!-- Related News Section -->{
  relatedItems.length > 0 && (
    <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
      <h2 id="related-news-events" class="font-semibold text-gray-900 mb-4">
        {t("projects.related-news-events.title")}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relatedItems.map((item) => (
          <NewsCard
            item={item.data}
            lang={lang}
            coverImage={item.coverImage}
            t={t}
            slug={item.slug}
          />
        ))}
      </div>

      <div class="mt-4 pt-3 border-t border-gray-100">
        <a
          href={`${linkHelpers.newsIndex(lang)}?project=${project}`}
          class="text-sm text-primary-600 hover:text-primary-800 font-medium transition-colors"
        >
          {t("projects.related-news-events.view-all")} →
        </a>
      </div>
    </div>
  )
}
