---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import { linkHelpers } from "@i18n/links";

interface Props {
    lang: "en" | "fr";
    project?: string; // PC1, PC2, PC3, PC4, PC5
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);

// Get filled PhD positions for the current language and project
const filledPhDPositions = await getCollection(
    "job-offers",
    ({ data }) =>
        data.filled === true &&
        data.type === "phd" &&
        data.tags?.includes(project!),
);

// Sort by expected start date (most recent first)
const sortedPositions = filledPhDPositions.sort((a, b) => {
    // Simple string comparison for expected start dates
    // This works for most formats like "2024-09-01", "Q1 2025", "Spring 2025"
    return b.data.expectedStartDate.localeCompare(a.data.expectedStartDate);
});
---

{
    sortedPositions.length > 0 && (
            <div class="mb-6">
                <h2>{t("job-offers.filled-phd-positions")}</h2>
            </div>

            <div class="space-y-4">
                {sortedPositions.map((position) => (
                    <a 
                        href={linkHelpers.jobOffer(lang, position.slug)}
                        class="block bg-gray-50 rounded-lg p-4 border border-gray-200 hover:bg-gray-100 hover:border-gray-300 transition-colors duration-200 group"
                    >
                        <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                            <h4 class="font-medium text-gray-900 line-clamp-2 group-hover:text-primary-600 transition-colors duration-200">
                                {position.data.title}
                            </h4>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-3 text-sm text-gray-600">
                            <div class="flex items-center">
                                <svg
                                    class="w-4 h-4 mr-2 flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                </svg>
                                <span class="truncate">
                                    {position.data.location}
                                </span>
                            </div>

                            <div class="flex items-center">
                                <svg
                                    class="w-4 h-4 mr-2 flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    />
                                </svg>
                                <span class="truncate">
                                    {t("job-offers.started")}:{" "}
                                    {position.data.expectedStartDate}
                                </span>
                            </div>
                        </div>

                        {position.data.description && (
                            <p class="text-gray-700 text-sm line-clamp-2">
                                {position.data.description}
                            </p>
                        )}
                    </a>
                ))}
            </div>
    )
}
