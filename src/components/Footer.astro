---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
---

<footer role="contentinfo" class="bg-gray-50 border-t border-gray-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Program Information -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">
                    {t("site.title")}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                    {
                        lang === "en"
                            ? "Engineering Digital Twins Research Program - Advancing digital twin technologies for industrial applications."
                            : "Programme de Recherche Jumeaux Numériques d'Ingénierie - Faire progresser les technologies de jumeaux numériques pour les applications industrielles."
                    }
                </p>
            </div>

            <!-- Quick Links -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">
                    {lang === "en" ? "Quick Links" : "Liens Rapides"}
                </h3>
                <nav
                    aria-label={lang === "en"
                        ? "Footer navigation"
                        : "Navigation du pied de page"}
                >
                    <ul class="space-y-2 text-sm">
                        <li>
                            <a
                                href={`/${lang}/program`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {t("nav.program")}
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/focused-projects`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {t("nav.projects")}
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/production/publications`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {
                                    lang === "en"
                                        ? "Publications"
                                        : "Publications"
                                }
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/join-us`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {t("nav.join-us")}
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Contact Information -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">
                    {lang === "en" ? "Contact" : "Contact"}
                </h3>
                <div class="space-y-3 text-sm text-gray-600">
                    <div class="flex items-start space-x-3">
                        <svg
                            class="w-5 h-5 text-gray-400 mt-0.5 flex-shrink-0"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <div>
                            <p class="font-medium text-gray-900">
                                {lang === "en" ? "Address" : "Adresse"}
                            </p>
                            <p class="mt-1">
                                {
                                    lang === "en"
                                        ? "Research Institute\n123 University Street\n75000 Paris, France"
                                        : "Institut de Recherche\n123 Rue de l'Université\n75000 Paris, France"
                                }
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-3">
                        <svg
                            class="w-5 h-5 text-gray-400 mt-0.5 flex-shrink-0"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                            ></path>
                            <path
                                d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                            ></path>
                        </svg>
                        <div>
                            <p class="font-medium text-gray-900">Email</p>
                            <a
                                href="mailto:contact@edt-research.fr"
                                class="mt-1 text-blue-600 hover:text-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                contact@edt-research.fr
                            </a>
                        </div>
                    </div>

                    <div class="flex items-start space-x-3">
                        <svg
                            class="w-5 h-5 text-gray-400 mt-0.5 flex-shrink-0"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                            ></path>
                        </svg>
                        <div>
                            <p class="font-medium text-gray-900">
                                {lang === "en" ? "Phone" : "Téléphone"}
                            </p>
                            <a
                                href="tel:+33123456789"
                                class="mt-1 text-blue-600 hover:text-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                +33 1 23 45 67 89
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Legal and Accessibility -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">
                    {lang === "en" ? "Legal" : "Légal"}
                </h3>
                <nav
                    aria-label={lang === "en"
                        ? "Legal navigation"
                        : "Navigation légale"}
                >
                    <ul class="space-y-2 text-sm">
                        <li>
                            <a
                                href={`/${lang}/legal/privacy`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {
                                    lang === "en"
                                        ? "Privacy Policy"
                                        : "Politique de Confidentialité"
                                }
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/legal/terms`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {
                                    lang === "en"
                                        ? "Terms of Use"
                                        : "Conditions d'Utilisation"
                                }
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/legal/accessibility`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {
                                    lang === "en"
                                        ? "Accessibility Statement"
                                        : "Déclaration d'Accessibilité"
                                }
                            </a>
                        </li>
                        <li>
                            <a
                                href={`/${lang}/legal/cookies`}
                                class="text-gray-600 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                            >
                                {
                                    lang === "en"
                                        ? "Cookie Policy"
                                        : "Politique des Cookies"
                                }
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- RGAA Compliance Badge -->
                <div class="mt-6 pt-4 border-t border-gray-200">
                    <div class="flex items-center space-x-2">
                        <svg
                            class="w-5 h-5 text-green-600"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-xs text-gray-600">
                            {
                                lang === "en"
                                    ? "RGAA 4.1 AA Compliant"
                                    : "Conforme RGAA 4.1 AA"
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="mt-12 pt-8 border-t border-gray-200">
            <div
                class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
            >
                <!-- Copyright -->
                <div class="text-sm text-gray-600">
                    <p>
                        © {currentYear}
                        {t("site.title")}.
                        {
                            lang === "en"
                                ? "All rights reserved."
                                : "Tous droits réservés."
                        }
                    </p>
                </div>

                <!-- Social Links (if applicable) -->
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-600">
                        {lang === "en" ? "Follow us:" : "Suivez-nous :"}
                    </span>
                    <!-- Add social media links here if needed -->
                    <a
                        href="https://twitter.com/edt_research"
                        class="text-gray-400 hover:text-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                        aria-label={lang === "en"
                            ? "Follow us on Twitter"
                            : "Suivez-nous sur Twitter"}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg
                            class="w-5 h-5"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.073 4.073 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://linkedin.com/company/edt-research"
                        class="text-gray-400 hover:text-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded transition-colors"
                        aria-label={lang === "en"
                            ? "Follow us on LinkedIn"
                            : "Suivez-nous sur LinkedIn"}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg
                            class="w-5 h-5"
                            aria-hidden="true"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>
