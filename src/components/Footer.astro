---
import { getEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);
const menu = await getEntry("menu", lang);
---

<footer class="bg-[#e5e5e5] text-gray-800 w-full" role="contentinfo">
    <div
        class="max-w-5xl mx-auto px-6 py-10 flex flex-wrap md:flex-nowrap justify-between gap-8"
    >
        <!-- Left column -->
        <div class="flex-1 min-w-[250px]">
            <img
                src="https://www.pepr-ia.fr/wp-content/uploads/2024/03/Group-6.png"
                alt="République Française France 2030"
                class="w-72 h-auto mb-4"
            />
            <p class="text-sm text-gray-600">
                {t("footer.tagline")}
            </p>
        </div>

        <!-- Middle column -->
        <div class="flex-1 min-w-[250px]">
            <!-- Piloted by -->
            <h6 class="border-l-2 border-blue-800 pl-3 mb-3">
                {t("footer.piloted-by")}
            </h6>
            <div class="flex items-center space-x-4 mb-4 flex-wrap">
                <img
                    src="https://www.pepr-cybersecurite.fr/wp-content/uploads/2023/03/logo-pilote-cea.png"
                    alt="CEA"
                    class="h-10 w-auto"
                />
                <img
                    src="https://www.pepr-cybersecurite.fr/wp-content/uploads/2023/12/LOGO_CNRS_2023_BLEU.png"
                    alt="CNRS"
                    class="h-10 w-auto"
                />
                <img
                    src="https://www.pepr-cybersecurite.fr/wp-content/uploads/2023/08/logo_inria-1.png"
                    alt="Inria"
                    class="h-8 w-auto"
                />
            </div>

            <!-- Funded by -->
            <h6 class="border-l-2 border-blue-800 pl-3 mb-3">
                {t("footer.funded-by")}
            </h6>
            <div class="flex items-center mb-4">
                <img
                    src="https://www.pepr-cybersecurite.fr/wp-content/uploads/2023/03/logo-finance-france-2030.png"
                    alt="France 2030"
                    class="h-10 w-auto"
                />
            </div>

            <!-- Operated by -->
            <h6 class="border-l-2 border-blue-800 pl-3 mb-3">
                {t("footer.operated-by")}
            </h6>
            <div class="flex items-center">
                <img
                    src="https://www.pepr-cybersecurite.fr/wp-content/uploads/2023/03/logo-finance-anr.png"
                    alt="ANR"
                    class="h-10 w-auto"
                />
            </div>
        </div>

        <!-- Right column -->
        <div class="flex-1 min-w-[200px] hidden md:block">
            <ul class="space-y-2 text-blue-800 font-medium">
                {
                    menu &&
                        menu.data.sections &&
                        menu.data.sections.map((section) => (
                            <li>
                                <a
                                    href={`/${lang}/${section.href}`}
                                    class="hover:underline"
                                >
                                    {section.name}
                                </a>
                            </li>
                        ))
                }
            </ul>
        </div>
    </div>
</footer>
