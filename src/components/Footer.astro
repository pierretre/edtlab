---
import { Picture } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import france2030Logo from "../../public/media/uploads/France 2030.png";
import anrLogo from "../../public/media/uploads/ANR_Logo.svg.png";

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);
---

<div class="bg-[#e5e5e5] text-gray-800 w-full">
    <div class="max-w-5xl mx-auto p-6 gap-6">
        <div class="flex items-center gap-6 flex-wrap mb-6">
            <span
                class="text-sm font-medium text-gray-900"
            >
                {t("footer.supported-by")}
            </span>
            <span
                class="w-px h-14 bg-gray-800 flex-shrink-0"
                aria-hidden="true"></span>
            <Picture
                src={france2030Logo}
                alt="France 2030 - Logo officiel du programme de financement"
                class="h-20 w-auto object-contain"
                widths={[120, 240, 360]}
                sizes="120px"
                format="webp"
                quality={80}
                pictureAttributes={{
                    class: "flex-shrink-0",
                }}
            />
            <Picture
                src={anrLogo}
                alt="ANR - Agence nationale de la recherche"
                class="h-10 w-auto object-contain"
                widths={[240, 480, 720]}
                sizes="240px"
                format="webp"
                quality={80}
                pictureAttributes={{
                    class: "flex-shrink-0",
                }}
            />
            <p class="text-sm flex-1 min-w-[240px] m-0">
                {t("footer.anr-funding-statement")}
            </p>
        </div>
        <div class="text-sm">
            <h5>
                {t("footer.legal-mentions")}
            </h5>
            <p class="text-sm">
                {t("footer.analytics")}
            </p>
        </div>
    </div>
</div>
