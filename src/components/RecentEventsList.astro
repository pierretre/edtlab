---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";
import EventCard from "./EventCard.astro";

interface Props {
    lang: "en" | "fr";
    maxItems?: number;
}

const { lang, maxItems = 6 } = Astro.props;
const t = useTranslations(lang);

// Get all non-press events for the current language
const allEvents = await getCollection("events", (event) => {
    return event.data.lang === lang;
});

// Sort events by date (newest first)
const sortedEvents = allEvents.sort((a, b) => {
    return b.data.date.getTime() - a.data.date.getTime();
});

// Limit events if maxItems is specified
const displayEvents = maxItems ? sortedEvents.slice(0, maxItems) : sortedEvents;
---

<div class="py-4 mb-8">
    {
        displayEvents.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {displayEvents.map((event) => (
                    <EventCard event={event} lang={lang} />
                ))}
            </div>
        ) : (
            <div class="text-center py-8 text-gray-500">
                <svg
                    class="w-12 h-12 mx-auto mb-4 text-gray-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                </svg>
                <p class="text-lg">{t("events.no-results")}</p>
            </div>
        )
    }

    {
        maxItems &&
            displayEvents.length >= maxItems &&
            sortedEvents.length > maxItems && (
                <div class="mt-6 text-center">
                    <a
                        href={`/${lang}/news`}
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-primary-600 bg-primary-50 border border-primary-200 rounded-lg hover:bg-primary-100 hover:border-primary-300 transition-colors duration-200"
                    >
                        {t("events.view-all")}
                        <svg
                            class="w-4 h-4 ml-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                            />
                        </svg>
                    </a>
                </div>
            )
    }
</div>
