---
import fp1hero from "@assets/images/INRIA_EDT_CBLOT_PC1.png";
import fp2hero from "@assets/images/INRIA_EDT_CBLOT_PC2.png";
import fp3hero from "@assets/images/INRIA_EDT_CBLOT_PC3.png";
import fp4hero from "@assets/images/INRIA_EDT_CBLOT_PC4.png";
import fp5hero from "@assets/images/INRIA_EDT_CBLOT_PC5.png";
import { Picture } from "astro:assets";

export interface Props {
    color: string;
    title: string;
    description: string;
    projectId?: string;
    t: any;
    slug: string;
}

// Map project IDs to their corresponding new logos
const projectLogos: Record<string, any> = {
    PC1: fp1hero,
    FP1: fp1hero,
    PC2: fp2hero,
    FP2: fp2hero,
    PC3: fp3hero,
    FP3: fp3hero,
    PC4: fp4hero,
    FP4: fp4hero,
    PC5: fp5hero,
    FP5: fp5hero,
};

const colorMap: Record<string, string> = {
    "blue-bell": "header-blue-bell",
    "hit-pink": "header-hit-pink",
    marzipan: "header-marzipan",
};

const { title, slug, description, color, projectId, t } = Astro.props as Props;

const backgroundColor = colorMap[color || ""] || "bg-gray-100";
---

<a
    href={slug}
    class={`card p-0 group animate-slideInUp flex flex-col h-full ${backgroundColor}`}
    role="button"
    tabindex="0"
    aria-label={`${t("home.tiles.navigate-to")} ${title}`}
>
    {
        projectId && projectLogos[projectId] && (
            <Picture
                class="h-full w-full object-cover"
                src={projectLogos[projectId]}
                alt={title}
                sizes="(max-width: 600px) 400px, 600px"
                widths={[400, 500, 600]}
                quality={80}
                format="webp"
                loading={"eager"}
                decoding={"async"}
            />
        )
    }

    <div class="p-4">
        <p class="text-white leading-relaxed flex-grow text-center">
            {description}
        </p>

        <div
            class="flex items-center justify-center text-white group-hover:text-white/70"
        >
            <span class="text-sm font-semibold mr-2">
                {t("home.tiles.explore")}
            </span>
            <svg
                class="w-4 h-4 transform"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"></path>
            </svg>
        </div>
    </div>
</a>
