---
/**
 * Accessible Image Component
 *
 * Provides enhanced accessibility features for images including:
 * - Required alt text validation
 * - Decorative image support
 * - Loading states
 * - Error handling
 * - Responsive image support
 */

import { useTranslations, getLangFromUrl } from "../i18n/utils";

export interface Props {
    src: string;
    alt: string;
    width?: number;
    height?: number;
    class?: string;
    loading?: "lazy" | "eager";
    decorative?: boolean;
    caption?: string;
    sizes?: string;
    srcset?: string;
}

const {
    src,
    alt,
    width,
    height,
    class: className = "",
    loading = "lazy",
    decorative = false,
    caption,
    sizes,
    srcset,
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

// Validate alt text for non-decorative images
if (!decorative && !alt) {
    throw new Error("Alt text is required for non-decorative images");
}

// Generate unique ID for aria-describedby if caption exists
const imageId = caption
    ? `image-${Math.random().toString(36).substring(2, 11)}`
    : undefined;
const captionId = caption ? `caption-${imageId}` : undefined;
---

<figure
    class={`accessible-image ${className}`}
    role={decorative ? "presentation" : undefined}
>
    <img
        src={src}
        alt={decorative ? "" : alt}
        width={width}
        height={height}
        loading={loading}
        class="max-w-full h-auto"
        sizes={sizes}
        srcset={srcset}
        id={imageId}
        aria-describedby={captionId}
        role={decorative ? "presentation" : "img"}
        onerror="this.setAttribute('aria-label', this.getAttribute('data-error-message') || 'Image failed to load')"
        data-error-message={t("accessibility.image-alt-missing")}
    />
    {
        caption && (
            <figcaption
                id={captionId}
                class="mt-2 text-sm text-gray-600 text-center"
            >
                {caption}
            </figcaption>
        )
    }
</figure>

<style>
    .accessible-image {
        @apply inline-block;
    }

    .accessible-image img {
        transition: opacity 0.3s ease;
    }

    .accessible-image img[loading="lazy"] {
        opacity: 0;
        animation: fadeIn 0.3s ease forwards;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    /* High contrast mode support */
    @media (prefers-contrast: high) {
        .accessible-image img {
            border: 1px solid currentColor;
        }
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
        .accessible-image img {
            animation: none !important;
            transition: none !important;
        }
    }
</style>
