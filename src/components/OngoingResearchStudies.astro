---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { linkHelpers } from "@i18n/links";
import { formatDate } from "@utils/date";

export interface Props {
    project?: string;
}

const { project } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

let studies: any[] = [];
if (project) {
    try {
        const all = await getCollection("research-studies");
        studies = all
            .filter((s) => s.data.pc === project)
            .filter((s) => !s.data.lang || s.data.lang === lang)
            .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
    } catch (error) {
        console.warn(`Could not load research-studies: ${error}`);
    }
}
---

{
    studies.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <h2
                id="ongoing-research-studies"
                class="font-semibold text-gray-900 mb-4 mt-0"
            >
                {t("research-studies.ongoing.title")}
            </h2>

            <div class="space-y-4">
                {studies.map((s) => (
                    <a
                        href={linkHelpers.researchStudy(lang, s.id)}
                        class="block bg-gray-50 rounded-lg p-4 border border-gray-200 hover:bg-gray-100 hover:border-gray-300 transition-colors duration-200 group"
                    >
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-primary-100 text-primary-800">
                                {(t as any)(`research-studies.type.${s.data.type.toLowerCase()}`)}
                            </span>
                        </div>

                        <h3 class="font-bold tracking-tight text-gray-900 line-clamp-2 mt-0 group-hover:text-primary-600 transition-colors duration-200">
                            {s.data.title}
                        </h3>

                        <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600">
                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <span class="font-medium text-gray-800">{s.data.researcher.name}</span>
                                {s.data.supervisors && s.data.supervisors.length > 0 && (
                                    <span class="text-gray-500 ml-1">
                                        · {t("research-studies.supervised-by")}{" "}
                                        {s.data.supervisors.map((sup: any) => sup.name).join(", ")}
                                    </span>
                                )}
                            </div>

                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span>{s.data.location}</span>
                            </div>

                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>{t("research-studies.start-date")}: {formatDate(s.data.startDate, lang)}</span>
                            </div>
                        </div>

                        {s.data.description && (
                            <p class="text-gray-700 text-sm line-clamp-2 my-0">
                                {s.data.description}
                            </p>
                        )}
                    </a>
                ))}
            </div>
        </div>
    )
}
