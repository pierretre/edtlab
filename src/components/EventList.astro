---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";
import EventCard from "./EventCard.astro";
import FilterBar from "./FilterBar.astro";

interface Props {
    lang: "en" | "fr";
    showFilters?: boolean;
    maxEvents?: number;
    chronological?: boolean;
    compact?: boolean;
}

const { lang, showFilters = true, maxEvents, chronological = true, compact = false } = Astro.props;
const t = useTranslations(lang);

// Get all events for the current language
const allEvents = await getCollection("events", (event) => {
    return event.data.lang === lang;
});

// Sort events chronologically (newest first by default, or oldest first if chronological is true)
const sortedEvents = allEvents.sort((a, b) => {
    if (chronological) {
        return a.data.date.getTime() - b.data.date.getTime(); // Oldest first for chronological display
    } else {
        return b.data.date.getTime() - a.data.date.getTime(); // Newest first for news display
    }
});

// Limit events if maxEvents is specified
const displayEvents = maxEvents ? sortedEvents.slice(0, maxEvents) : sortedEvents;

// Get unique types for filters
const types = ["conference", "workshop", "seminar", "press"] as const;

// Helper function to get type translation
const getTypeTranslation = (type: string) => {
    switch (type) {
        case "conference":
            return t("events.type.conference");
        case "workshop":
            return t("events.type.workshop");
        case "seminar":
            return t("events.type.seminar");
        case "press":
            return t("events.type.press");
        default:
            return type;
    }
};

// Separate upcoming and past events
const now = new Date();
const upcomingEvents = displayEvents.filter(event => event.data.date > now);
const pastEvents = displayEvents.filter(event => event.data.date <= now);

// Prepare filter configuration
const filterConfig = [
    {
        id: "event-type-filter",
        label: t("events.filter.type"),
        type: "select" as const,
        options: [
            { value: "", label: t("events.filter.all-types") },
            ...types.map(type => ({
                value: type,
                label: getTypeTranslation(type)
            }))
        ]
    },
    {
        id: "event-date-filter",
        label: t("events.filter.date"),
        type: "select" as const,
        options: [
            { value: "", label: t("events.all") },
            { value: "upcoming", label: t("events.filter.upcoming") },
            { value: "past", label: t("events.filter.past") }
        ]
    },
    {
        id: "event-search-filter",
        label: t("events.filter.search"),
        type: "search" as const,
        placeholder: t("events.filter.search-placeholder")
    }
];
---
<div class="py-4 mb-8">
    {showFilters && (
        <FilterBar 
            lang={lang} 
            filters={filterConfig} 
            clearButtonId="clear-event-filters"
            compact={compact}
        />
    )}

    <!-- Chronological Order Notice -->
    {chronological && (
        <div class="mb-4 text-sm text-gray-600 italic">
            {t("events.chronological-order")}
        </div>
    )}

    <!-- Events Grid -->
    <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayEvents.map((event) => (
            <div
                class="event-item"
                data-type={event.data.type}
                data-date={event.data.date.toISOString()}
                data-upcoming={event.data.date > now ? "true" : "false"}
                data-search-text={`${event.data.title} ${event.data.description} ${event.data.location || ""}`.toLowerCase()}
            >
                <EventCard event={event} lang={lang} />
            </div>
        ))}
    </div>

    <!-- No Results Message -->
    <div id="no-events-results" class="hidden text-center py-8 text-gray-500">
        <p class="text-lg">
            {t("events.no-results")}
        </p>
    </div>

    <!-- Results Count -->
    <div class="mt-6 text-sm text-gray-600">
        <span 
            id="events-results-count"
            data-template={t("events.results-count")}
        >
            {t("events.results-count").replace("{count}", displayEvents.length.toString())}
        </span>
    </div>

    <!-- Summary Statistics -->
    {showFilters && (
        <div class="mt-4 flex flex-wrap gap-4 text-sm text-gray-600">
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded">
                {t("events.upcoming")}: {upcomingEvents.length}
            </span>
            <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded">
                {t("events.past")}: {pastEvents.length}
            </span>
        </div>
    )}
</div>

{showFilters && (
    <script>
        // Client-side filtering functionality
        document.addEventListener("DOMContentLoaded", function () {
            const typeFilter = document.getElementById("event-type-filter") as HTMLSelectElement;
            const dateFilter = document.getElementById("event-date-filter") as HTMLSelectElement;
            const searchFilter = document.getElementById("event-search-filter") as HTMLInputElement;
            const clearFilters = document.getElementById("clear-event-filters") as HTMLButtonElement;
            const eventsGrid = document.getElementById("events-grid") as HTMLDivElement;
            const noResults = document.getElementById("no-events-results") as HTMLDivElement;
            const resultsCount = document.getElementById("events-results-count") as HTMLSpanElement;
            const eventItems = Array.from(document.querySelectorAll(".event-item")) as HTMLDivElement[];

            function filterEvents() {
                const typeValue = typeFilter?.value || "";
                const dateValue = dateFilter?.value || "";
                const searchValue = searchFilter?.value.toLowerCase().trim() || "";

                let visibleCount = 0;
                const now = new Date();

                eventItems.forEach((item) => {
                    const itemType = item.dataset.type;
                    const itemDate = new Date(item.dataset.date || "");
                    const itemUpcoming = item.dataset.upcoming === "true";
                    const itemSearchText = item.dataset.searchText || "";

                    const typeMatch = !typeValue || itemType === typeValue;
                    const dateMatch = !dateValue || 
                        (dateValue === "upcoming" && itemUpcoming) ||
                        (dateValue === "past" && !itemUpcoming);
                    const searchMatch = !searchValue || itemSearchText.includes(searchValue);

                    const shouldShow = typeMatch && dateMatch && searchMatch;

                    if (shouldShow) {
                        item.style.display = "";
                        visibleCount++;
                    } else {
                        item.style.display = "none";
                    }
                });

                // Update results count and show/hide no results message
                if (resultsCount) {
                    const template = resultsCount.dataset.template || "Showing {count} events";
                    resultsCount.textContent = template.replace("{count}", visibleCount.toString());
                }

                if (visibleCount === 0) {
                    if (eventsGrid) eventsGrid.style.display = "none";
                    if (noResults) noResults.style.display = "block";
                } else {
                    if (eventsGrid) eventsGrid.style.display = "";
                    if (noResults) noResults.style.display = "none";
                }
            }

            function clearAllFilters() {
                if (typeFilter) typeFilter.value = "";
                if (dateFilter) dateFilter.value = "";
                if (searchFilter) searchFilter.value = "";
                filterEvents();
            }

            // Add event listeners
            if (typeFilter) typeFilter.addEventListener("change", filterEvents);
            if (dateFilter) dateFilter.addEventListener("change", filterEvents);
            if (searchFilter) searchFilter.addEventListener("input", filterEvents);
            if (clearFilters) clearFilters.addEventListener("click", clearAllFilters);
        });
    </script>
)}

<style>
    .event-item {
        transition: opacity 0.2s ease;
    }
</style>