---
import json from "../content/partners.json";
import { Picture } from "astro:assets";
import type { Partner } from "@models/Partner.model";

export interface Props {
    partners: string[];
}

const { partners } = Astro.props;
const logos = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/partners/*.{svg,jpg,png,gif,webp}",
);

// Resolve partner entries and load their logo image metadata.
// Use Promise.all so `partnersData` is an array of resolved objects (not Promises).
const partnersData: (Partner & { image: ImageMetadata })[] = await Promise.all(
    partners.map(async (shortname) => {
        const jsonKey = shortname as keyof typeof json;
        const meta = json[jsonKey] as Partner | undefined;

        if (!meta) {
            throw new Error(`Partner not found in JSON: ${shortname}`);
        }

        try {
            const image = (await logos[meta.logo]()).default;
            return { ...meta, image };
        } catch (err) {
            throw new Error(
                `Could not load logo for partner "${meta.shortname}". Path attempted: ${meta.logo}. Original error: ${err}`,
            );
        }
    }),
);
---

<div class="w-full py-8">
    <div class="mx-auto max-w-7xl px-4">
        <div
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 place-items-center"
        >
            {
                partnersData.map((p) => (
                    <div
                        class="flex flex-col items-center group"
                        title={p.fullname}
                    >
                        <Picture
                            src={p.image}
                            alt={p.fullname ?? ""}
                            class="h-12 w-auto object-contain"
                            loading="lazy"
                        />

                        {/* {p.children && p.children.length > 0 && (
                            <div class="mt-2 hidden group-hover:block text-xs text-gray-500 text-center">
                                {p.children.join(", ")}
                            </div>
                        )} */}
                    </div>
                ))
            }
        </div>
    </div>
</div>
