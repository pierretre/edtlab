---
import json from "../content/partners.json";
import { Picture } from "astro:assets";
import type { Partner } from "@models/Partner.model";

export interface Props {
    partners: string[];
    largeLogos?: boolean;
}

const { partners, largeLogos = false } = Astro.props;
const logos = import.meta.glob<{ default: ImageMetadata }>(
    "/public/media/uploads/*.{svg,jpg,png,gif,webp}",
);

// Resolve partner entries and load their logo image metadata.
// Use Promise.all so `partnersData` is an array of resolved objects (not Promises).
const partnersData: (Partner & { image: ImageMetadata })[] = await Promise.all(
    partners.map(async (shortname) => {
        const jsonKey = shortname as keyof typeof json;
        const meta = json[jsonKey] as Partner | undefined;

        if (!meta) {
            throw new Error(`Partner not found in JSON: ${shortname}`);
        }

        try {
            const image = (await logos[`/public${meta.logo}`]()).default;
            return { ...meta, image };
        } catch (err) {
            throw new Error(
                `Could not load logo for partner "${meta.shortname}". Path attempted: ${meta.logo}. Original error: ${err}`,
            );
        }
    }),
);
---

<div class="max-w-7xl px-4 py-8">
    <div class="mx-auto flex flex-row gap-16 justify-items-center flex-wrap">
        {
            partnersData.map((p) => (
                <div
                    class="flex-1 flex flex-col items-center group w-full"
                    title={p.fullname}
                >
                    <Picture
                        src={p.image}
                        alt={p.fullname ?? ""}
                        class={`w-auto h-auto object-contain mx-auto ${largeLogos ? "max-w-48 max-h-20" : "max-w-36 max-h-16"}`}
                        loading="lazy"
                    />
                </div>
            ))
        }
    </div>
</div>
