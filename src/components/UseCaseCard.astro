---
import { formatDate } from "@utils/./";
import { getContentLink } from "@i18n/links";
import Badge from "@components/Badge.astro";

export interface Props {
    item: any;
    body?: string;
    lang: "en" | "fr";
    t: any;
    slug: string;
}

const { item, body, lang, t, slug } = Astro.props;
const link = `/${lang}${getContentLink(lang, "use-cases", slug, true)}`;
const coverSrc = item.photo || "/media/use-cases/uc-default.svg";

// Build search text for client-side filtering — includes body markdown
const searchText = [
    item.title,
    item.summary,
    item.id,
    item.domain,
    ...(item.tags || []),
    ...(item.contacts || []).map((c: any) => `${c.name} ${c.org || ""}`),
    body || "",
]
    .join(" ")
    .toLowerCase();

// originType label mapping
const originTypeLabels: Record<string, Record<string, string>> = {
    en: {
        natural: "Natural",
        anthropic: "Anthropic",
        engineered: "Engineered",
        infrastructure: "Infrastructure",
        process: "Process",
    },
    fr: {
        natural: "Naturel",
        anthropic: "Anthropique",
        engineered: "Ingéniéré",
        infrastructure: "Infrastructure",
        process: "Processus",
    },
};

// usageLevel label mapping
const usageLevelLabels: Record<string, Record<string, string>> = {
    en: { reduced: "Reduced", consortium: "Consortium", public: "Public" },
    fr: { reduced: "Réduit", consortium: "Consortium", public: "Public" },
};

const originTypeLabel = item.originType
    ? (originTypeLabels[lang]?.[item.originType] ?? item.originType)
    : null;
const showUsageLevel = item.maturity === "operational" && item.usageLevel;
const usageLevelLabel = showUsageLevel
    ? (usageLevelLabels[lang]?.[item.usageLevel] ?? item.usageLevel)
    : null;
---

<div
    class="use-case-item card hover:shadow-lg relative p-0 bg-white border border-gray-200 rounded-lg shadow max-w-sm w-full mx-auto h-full flex flex-col"
    data-date={item.publishedDate.getTime()}
    data-tags={item.tags?.join(",")}
    data-domain={item.domain || ""}
    data-maturity={item.maturity || ""}
    data-title={item.title}
    data-search-text={searchText}
>
    <a
        href={link}
        class="relative block h-48 overflow-hidden group rounded-t-lg flex-shrink-0"
    >
        <img
            class="h-full w-full object-contain transition-transform duration-200 ease-out group-hover:scale-105"
            src={coverSrc}
            alt={item.title}
            loading="lazy"
            decoding="async"
        />
        <div
            class="absolute inset-0 bg-black bg-opacity-0 transition duration-200 group-hover:bg-opacity-30"
        >
        </div>
    </a>

    <div class="p-4 flex-grow flex flex-col">
        <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-medium text-primary-600 uppercase"
                >{item.id}</span
            >
            <div class="flex items-center gap-2 text-xs text-gray-500">
                {item.version && <span>r{item.version}</span>}
                {item.maturity && <Badge key={item.maturity} t={t} />}
            </div>
        </div>

        <h4 class="text-base font-semibold mb-1">
            <a
                href={link}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.title}
            </a>
        </h4>

        {
            item.provider && (
                <p class="text-xs text-gray-500 mb-2 italic">{item.provider}</p>
            )
        }

        <p class="text-sm text-gray-600 line-clamp-3 flex-grow">
            {item.summary}
        </p>

        {/* New identity fields — max 2-3, compact */}
        <div class="flex flex-wrap gap-1 mt-2">
            {
                originTypeLabel && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-purple-100 text-purple-800 text-xs font-medium">
                        {originTypeLabel}
                    </span>
                )
            }
            {
                showUsageLevel && usageLevelLabel && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-green-100 text-green-800 text-xs font-medium">
                        {usageLevelLabel}
                    </span>
                )
            }
            {
                item.since && (
                    <span class="text-xs text-gray-400 self-center">
                        {lang === "fr" ? "depuis" : "since"}{" "}
                        {formatDate(
                            item.since instanceof Date
                                ? item.since
                                : new Date(item.since),
                            lang,
                            { year: "numeric" },
                        )}
                    </span>
                )
            }
        </div>

        {
            item.contacts?.length > 0 && (
                <p class="text-xs text-gray-400 mt-3">
                    {[
                        ...new Set(
                            item.contacts
                                .map((c: any) => c.org)
                                .filter(Boolean),
                        ),
                    ].join(", ")}
                </p>
            )
        }
    </div>
</div>
