---
import { formatDate } from "@utils/./";
import { getContentLink } from "@i18n/links";
import Badge from "@components/Badge.astro";

export interface Props {
    item: any;
    body?: string;
    lang: "en" | "fr";
    t: any;
    slug: string;
}

const { item, body, lang, t, slug } = Astro.props;
const link = `/${lang}${getContentLink(lang, "use-cases", slug, true)}`;
const coverSrc = item.photo || "/media/use-cases/uc-default.svg";

// Build search text for client-side filtering — includes body markdown
const searchText = [
    item.title,
    item.summary,
    item.id,
    item.domain,
    ...(item.tags || []),
    ...(item.contacts || []).map((c: any) => `${c.name} ${c.org || ""}`),
    body || "",
]
    .join(" ")
    .toLowerCase();
---

<div
    class="use-case-item card hover:shadow-lg relative p-0 bg-white border border-gray-200 rounded-lg shadow max-w-sm w-full mx-auto h-full flex flex-col"
    data-date={item.publishedDate.getTime()}
    data-tags={item.tags?.join(",")}
    data-domain={item.domain || ""}
    data-maturity={item.maturity || ""}
    data-title={item.title}
    data-search-text={searchText}
>
    <a
        href={link}
        class="relative block h-48 overflow-hidden group rounded-t-lg flex-shrink-0 bg-gray-50"
    >
        <img
            class="h-full w-full object-contain transition-transform duration-200 ease-out group-hover:scale-105"
            src={coverSrc}
            alt={item.title}
            loading="lazy"
            decoding="async"
        />
    </a>

    <div class="p-4 flex-grow flex flex-col">
        <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-medium text-primary-600 uppercase"
                >{item.id}</span
            >
            <div class="flex items-center gap-2 text-xs text-gray-500">
                {item.maturity && <Badge key={item.maturity} t={t} />}
            </div>
        </div>

        {item.domain && (
            <p class="text-xs text-gray-500 mb-1">
                <span class="font-medium">{lang === 'fr' ? 'Domaine' : 'Domain'} :</span> {item.domain}
            </p>
        )}

        <h4 class="text-base font-semibold mb-1">
            <a
                href={link}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.title}
            </a>
        </h4>

        {item.provider && (
            <p class="text-xs text-gray-500 mb-2 italic">{item.provider}</p>
        )}

        <p class="text-sm text-gray-600 line-clamp-3 flex-grow">
            {item.summary}
        </p>

        {item.since && (
            <p class="text-xs text-gray-400 mt-2">
                {lang === "fr" ? "depuis" : "since"}{" "}
                {formatDate(
                    item.since instanceof Date ? item.since : new Date(item.since),
                    lang,
                    { year: "numeric" },
                )}
            </p>
        )}
    </div>
</div>
