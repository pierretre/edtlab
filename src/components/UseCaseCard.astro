---
import { formatDate } from "@utils/./";
import { getContentLink } from "@i18n/links";
import Badge from "@components/Badge.astro";

export interface Props {
    item: any;
    lang: "en" | "fr";
    t: any;
    slug: string;
}

const { item, lang, t, slug } = Astro.props;
const link = `/${lang}${getContentLink(lang, "use-cases", slug, true)}`;
const coverSrc = item.photo || '/media/use-cases/uc-default.svg';
---

<div
    class="use-case-item card hover:shadow-lg relative p-0 bg-white border border-gray-200 rounded-lg shadow max-w-sm w-full mx-auto h-full flex flex-col"
    data-date={item.publishedDate.getTime()}
    data-tags={item.tags?.join(",")}
>
    <!-- Tags -->
    <div class="absolute top-2 left-2 z-10 gap-2 flex flex-wrap">
        {item.tags?.map((tag: string) => <Badge key={tag} t={t} />)}
    </div>

    <a
        href={link}
        class="relative block h-48 overflow-hidden group rounded-t-lg flex-shrink-0"
    >
        <img
            class="h-full w-full object-cover transition-transform duration-200 ease-out group-hover:scale-105"
            src={coverSrc}
            alt={item.title}
            loading="lazy"
            decoding="async"
        />
        <div class="absolute inset-0 bg-black bg-opacity-0 transition duration-200 group-hover:bg-opacity-30"></div>
    </a>

    <div class="p-4 flex-grow flex flex-col">
        <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-medium text-primary-600 uppercase">{item.id}</span>
            <div class="flex items-center gap-2 text-xs text-gray-500">
                {item.version && <span>v{item.version}</span>}
                {item.maturity && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-medium">
                        {item.maturity}
                    </span>
                )}
            </div>
        </div>

        <h4 class="text-base font-semibold mb-2">
            <a
                href={link}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.title}
            </a>
        </h4>

        <p class="text-sm text-gray-600 line-clamp-3 flex-grow">
            {item.summary}
        </p>

        {item.contacts?.length > 0 && (
            <p class="text-xs text-gray-400 mt-3">
                {[...new Set(item.contacts.map((c: any) => c.org).filter(Boolean))].join(", ")}
            </p>
        )}
    </div>
</div>
