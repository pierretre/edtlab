---
/**
 * ImagePreloader - Preloads critical images for better performance
 * Use this for above-the-fold images that should load immediately
 */
import type { ImageMetadata } from "astro";

export interface Props {
    src: ImageMetadata;
    formats?: Array<"avif" | "webp" | "png" | "jpg" | "jpeg">;
}

const { src, formats = ["avif", "webp"] } = Astro.props;

// Generate preload links for different formats
const preloadLinks = formats.map((format) => {
    // This is a simplified approach - in a real implementation,
    // you'd want to generate the actual optimized image URLs
    return {
        format,
        href: src.src, // This would be the optimized image URL
    };
});
---

<!-- Preload critical images -->{
    preloadLinks.map((link) => (
        <link
            rel="preload"
            as="image"
            href={link.href}
            type={`image/${link.format}`}
        />
    ))
}
