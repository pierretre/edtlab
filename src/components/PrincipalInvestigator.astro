---
export interface Props {
    name: string;
    headline: string;
    picture?: string;
}
const { name, headline, picture } = Astro.props as Props;
---

<div
    class="card bg-white shadow-sm border flex flex-col sm:flex-row gap-6 items-start mb-6"
>
    {
        picture && (
            <img
                src={picture}
                alt={name}
                class="w-48 h-48 bg-gray-200 rounded-full flex-shrink-0 object-cover"
                loading="lazy"
                decoding="async"
            />
        )
    }
    <div class="flex-1 space-y-3">
        <h3 class="text-2xl font-bold text-gray-800">{name}</h3>
        <p class="text-primary-700 font-bold text-xl">
            {headline}
        </p>
        <p class="text-gray-600">
            <slot />
        </p>
    </div>
</div>
