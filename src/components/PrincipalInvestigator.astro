---
import { Picture } from "astro:assets";

export interface Props {
    name: string;
    headline: string;
    picture?: string;
}
const { name, headline, picture } = Astro.props as Props;
let avatar: ImageMetadata | undefined;
if (picture) {
    try {
        const images = import.meta.glob<{ default: ImageMetadata }>(
            "/src/assets/images/investigators/*.{eg,jpg,png,gif,webp}",
        );
        console.log(
            "Available images for PrincipalInvestigator:",
            Object.keys(images),
        );
        avatar = (await images[picture]()).default;
    } catch (error) {
        console.warn(`Could not load image: ${picture}`);
    }
}
---

<div
    class="card bg-white shadow-sm border flex flex-col sm:flex-row gap-6 items-start mb-6"
>
    {
        picture && (
            <Picture
                class="h-full w-full object-cover"
                src={avatar!}
                alt={name}
                class="w-32 h-32 bg-gray-200 rounded-full flex-shrink-0"
            />
        )
    }
    <div class="flex-1 space-y-3">
        <h3 class="text-xl font-medium text-gray-800">{name}</h3>
        <p class="text-gray-700">
            {headline}
        </p>
        <p class="text-gray-600">
            <slot />
        </p>
    </div>
</div>
