---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "../i18n/utils";
import { linkHelpers } from "../i18n/links";
import {
    formatDate,
    isUpcoming,
    isToday,
    isSoon,
    getEventTypeColor,
} from "../utils";

interface Props {
    event: CollectionEntry<"events">;
    lang: "en" | "fr";
}

const { event, lang } = Astro.props;
const t = useTranslations(lang);
---

<article
    class="event-card max-w-sm bg-white border border-gray-200 rounded-lg shadow hover:shadow-lg transition-shadow duration-300"
    role="article"
    aria-labelledby={`event-title-${event.slug}`}
>
    <div class="p-5">
        <!-- Header with badges -->
        <div class="flex flex-wrap gap-2 mb-3">
            <span
                class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getEventTypeColor(event.data.type)}`}
            >
                {t(`events.type.${event.data.type}`)}
            </span>
            {
                isToday(event.data.date) && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        {t("events.today")}
                    </span>
                )
            }
            {
                isSoon(event.data.date) && !isToday(event.data.date) && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                        {t("events.soon")}
                    </span>
                )
            }
            {
                !isUpcoming(event.data.date) && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        {t("events.past")}
                    </span>
                )
            }
        </div>

        <!-- Title -->
        <h3
            id={`event-title-${event.slug}`}
            class="mb-2 text-xl font-bold tracking-tight text-gray-900 line-clamp-2"
        >
            {event.data.title}
        </h3>

        <!-- Description -->
        <p class="mb-3 text-gray-700 text-sm line-clamp-3">
            {event.data.description}
        </p>

        <!-- Date and Location -->
        <div class="mb-4 space-y-2">
            <div class="flex items-center text-sm text-gray-600">
                <svg
                    class="w-4 h-4 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <span
                    class={isUpcoming(event.data.date)
                        ? "text-primary-600 font-medium"
                        : ""}
                >
                    {formatDate(event.data.date, lang)}
                </span>
            </div>
            {
                event.data.location && (
                    <div class="flex items-center text-sm text-gray-600">
                        <svg
                            class="w-4 h-4 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                        </svg>
                        {event.data.location}
                    </div>
                )
            }
        </div>

        <!-- Action buttons -->
        <div class="flex flex-col gap-2">
            <a
                href={linkHelpers.event(lang, event.slug)}
                class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 transition-colors duration-200"
                aria-label={`${t("events.view-details")} - ${event.data.title}`}
            >
                {t("events.view-details")}
                <svg
                    class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
                    aria-hidden="true"
                    fill="none"
                    viewBox="0 0 14 10"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9"></path>
                </svg>
            </a>
            {
                event.data.url && (
                    <a
                        href={event.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors duration-200"
                        aria-label={`${t("news.external-link")} - ${event.data.title}`}
                    >
                        {isUpcoming(event.data.date)
                            ? t("events.register")
                            : t("news.external-link")}
                        <svg
                            class="w-4 h-4 ml-1"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                        </svg>
                    </a>
                )
            }
        </div>
    </div>
</article>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
