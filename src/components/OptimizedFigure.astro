---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
    src: string;
    alt: string;
    caption?: string;
    class?: string;
    loading?: "lazy" | "eager";
    quality?: number;
    widths?: number[];
    sizes?: string;
    align?: "left" | "center" | "right";
    maxWidth?: number;
}

const {
    src,
    alt,
    caption,
    class: className = "",
    loading = "eager",
    quality = 60,
    widths = [400, 800, 1200],
    sizes = "(max-width: 768px) 100vw, (max-width: 1024px) 80vw, 1200px",
    align = "center",
    maxWidth,
} = Astro.props;

// Handle image import
let image: ImageMetadata | undefined;
try {
    const images = import.meta.glob<{ default: ImageMetadata }>(
        "/src/assets/images/*.{jpeg,jpg,png,gif,webp}",
    );

    image = (await images[src]()).default;
} catch (error) {
    console.warn(`Could not load image: ${src}`);
}

// Convert maxWidth input into usable CSS
const resolvedMaxWidth = maxWidth ? `${maxWidth}px` : "100%";

const alignmentStyle =
    align === "left"
        ? "0"
        : align === "right"
          ? "auto"
          : "auto; margin-right: auto";
---

<figure
    class={`mb-6 ${className}`}
    style={`max-width: ${resolvedMaxWidth}; margin-left: ${alignmentStyle};`}
>
    <Picture
        src={image!}
        formats={["avif", "webp", "jpeg", "png"]}
        alt={alt}
        loading={loading}
        quality={quality}
        widths={widths}
        sizes={sizes}
        decoding="async"
        style="display: block; width: 100%; height: auto;"
    />
    {
        caption && (
            <figcaption class="mt-2 text-sm text-gray-700 dark:text-gray-300 text-center italic">
                {caption}
            </figcaption>
        )
    }
</figure>
