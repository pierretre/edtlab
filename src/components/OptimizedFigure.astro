---
/**
 * OptimizedFigure - An optimized wrapper around Astro's Picture component for content editors
 *
 * Usage in MDX files:
 * ```
 * import OptimizedFigure from '@components/OptimizedFigure.astro';
 * import myImage from '@assets/images/my-image.png';
 *
 * <OptimizedFigure
 *   src={myImage}
 *   alt="Description of the image"
 *   caption="Optional caption text"
 *   loading="lazy" // or "eager" for above-the-fold images
 * />
 * ```
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
    src: ImageMetadata;
    alt: string;
    caption?: string;
    class?: string;
    loading?: "lazy" | "eager";
    formats?: Array<"avif" | "webp" | "png" | "jpg" | "jpeg">;
    quality?: number;
    widths?: number[];
    sizes?: string;
}

const {
    src,
    alt,
    caption,
    class: className = "",
    loading = "eager",
    formats = ["avif", "webp"],
    quality = 60,
    widths = [400, 800, 1200],
    sizes = "(max-width: 768px) 100vw, (max-width: 1024px) 80vw, 1200px",
    ...rest
} = Astro.props;
---

<figure class={`mb-6 ${className}`}>
    <Picture
        src={src}
        formats={formats}
        alt={alt}
        class="w-full h-auto"
        loading={loading}
        quality={quality}
        widths={widths}
        sizes={sizes}
        decoding="async"
        {...rest}
    />
    {
        caption && (
            <figcaption class="mt-2 text-sm text-gray-700 dark:text-gray-300 text-center italic">
                {caption}
            </figcaption>
        )
    }
</figure>
