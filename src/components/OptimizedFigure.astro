---
export interface Props {
    src: string;
    alt: string;
    caption?: string;
    class?: string;
    loading?: "lazy" | "eager";
    quality?: number;
    widths?: number[];
    sizes?: string;
    align?: "left" | "center" | "right";
    maxWidth?: number;
}

const {
    src,
    alt,
    caption,
    class: className = "",
    loading = "eager",
    align = "center",
    maxWidth,
} = Astro.props;

// Convert maxWidth input into usable CSS
const resolvedMaxWidth = maxWidth ? `${maxWidth}px` : "100%";

const alignmentStyle =
    align === "left"
        ? "0"
        : align === "right"
          ? "auto"
          : "auto; margin-right: auto";
---

<figure
    class={`mb-6 ${className}`}
    style={`max-width: ${resolvedMaxWidth}; margin-left: ${alignmentStyle};`}
>
    <!-- CMS images from public/ - use plain img tag for reliable preview -->
    <img
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        style="display: block; width: 100%; height: auto;"
    />
    {
        caption && (
            <figcaption class="mt-2 text-sm text-gray-700 dark:text-gray-300 text-center italic">
                {caption}
            </figcaption>
        )
    }
</figure>
