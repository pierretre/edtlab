---
import { Picture } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import fp1hero from "@assets/images/INRIA_EDT_CBLOT_PC1.png";
import fp2hero from "@assets/images/INRIA_EDT_CBLOT_PC2.png";
import fp3hero from "@assets/images/INRIA_EDT_CBLOT_PC3.png";
import fp4hero from "@assets/images/INRIA_EDT_CBLOT_PC4.png";
import fp5hero from "@assets/images/INRIA_EDT_CBLOT_PC5.png";

export interface Props {
    color: string;
    title: string;
    description: string;
    projectId?: string;
}

const { color, title, description, projectId } = Astro.props;

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

// Map project IDs to their corresponding new logos
const projectLogos: Record<string, any> = {
    PC1: fp1hero,
    FP1: fp1hero,
    PC2: fp2hero,
    FP2: fp2hero,
    PC3: fp3hero,
    FP3: fp3hero,
    PC4: fp4hero,
    FP4: fp4hero,
    PC5: fp5hero,
    FP5: fp5hero,
};

const colorMap: Record<string, string> = {
    "blue-bell": "header-blue-bell",
    "hit-pink": "header-hit-pink",
    marzipan: "header-marzipan",
};

const currentColor =
    colorMap[color] || "bg-gradient-to-br from-gray-300 to-gray-500";
---

<section class={`${currentColor} py-8 lg:py-16`}>
    <div
        class="grid w-full max-w-screen-xl mx-auto px-4 md:grid-cols-12 lg:grid-cols-12 md:gap-8 lg:gap-8 xl:gap-0"
    >
        <!-- Text content section (left) -->
        <div
            class="mr-auto place-self-center md:col-span-6 lg:col-span-5 animate-slideInLeft"
        >
            <h1
                class="max-w-2xl mb-4 text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl xl:text-5xl"
            >
                {title}
            </h1>
            <p
                class="max-w-2xl mb-6 font-light text-white lg:mb-8 md:text-lg lg:text-xl"
            >
                {description}
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a
                    href="#related-publications"
                    class="btn-primary-light text-white bg-white/20 backdrop-blur-sm hover:text-white/70 hover:bg-white/30 focus:ring-white/25"
                >
                    {t("project-hero.related-publications-button")}
                    <svg
                        class="w-5 h-5 ml-2 -mr-1"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                        ><path
                            fill-rule="evenodd"
                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path></svg
                    >
                </a>
            </div>
        </div>

        <!-- Image section (right) -->
        {
            projectId && projectLogos[projectId] && (
                <div class="flex md:col-span-6 lg:col-span-7 lg:p-0 lg:mt-0 items-center justify-center">
                    <Picture
                        class="w-full h-auto max-w-[800px]"
                        src={projectLogos[projectId]}
                        alt={title}
                        loading="eager"
                        quality={80}
                        widths={[400, 600, 800]}
                        sizes="(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 50vw"
                        decoding="async"
                    />
                </div>
            )
        }
    </div>
</section>
