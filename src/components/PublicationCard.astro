---
import type { Publication } from "../models/Publication.model";
import ProjectTag from "./ProjectTag.astro";

export interface Props {
    publication: Publication;
}

const { publication } = Astro.props as Props;
---

<div
    class="publication-row border-l-4 border-primary-200 pl-3"
    data-type={publication.type}
    data-year={publication.year.toString()}
    data-search-text={`${publication.title} ${publication.authors.join(" ")} ${publication.venue || ""}`.toLowerCase()}
    data-project={publication.project}
    role="row"
>
    <h3 class="flex font-medium justify-between text-gray-900 leading-tight">
        {
            publication.url ? (
                <a
                    href={publication.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary-600 hover:text-primary-800 transition-colors"
                >
                    {publication.title}
                </a>
            ) : (
                <span>{publication.title}</span>
            )
        }

        <ProjectTag project={publication.project} />
    </h3>
    <p class="text-xs text-gray-600 mt-1">
        {publication.authors.join(", ")} • {publication.year}
    </p>
    <p class="text-xs text-gray-500">{publication.venue}</p>
</div>
