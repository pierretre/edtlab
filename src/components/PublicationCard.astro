---
import type { Publication } from "@models/Publication.model";
import Badge from "./Badge.astro";

export interface Props {
    publication: Publication;
    t: any;
}
const { publication, t } = Astro.props as Props;
---

<div
    class="publication-item hover:bg-gray-100 transition-colors duration-300 border-l-4 border-primary-200 pl-3"
    data-type={publication.type}
    data-year={publication.year.toString()}
    data-search-text={`${JSON.stringify(publication)}`.toLowerCase()}
    data-tags={(publication.tags ?? []).join(" ").toLowerCase()}
    role="row"
>
    <h3
        class="flex items-baseline font-medium justify-between text-gray-900 leading-tight"
    >
        {
            publication.url ? (
                <a
                    href={publication.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary-600 hover:text-primary-800 transition-colors"
                >
                    {publication.title}
                </a>
            ) : (
                <span>{publication.title}</span>
            )
        }

        <div class="flex gap-1 flex-wrap justify-end">
            {
                (publication.tags || [])
                    .filter((tag) => tag && tag.trim())
                    .map((tag) => <Badge key={tag} t={t} />)
            }
        </div>
    </h3>
    <p class="text-xs text-gray-600 mt-1">
        {publication.authors.join(", ")} • {publication.year}
    </p>
    <p class="text-xs text-gray-500">{publication.venue}</p>
</div>
