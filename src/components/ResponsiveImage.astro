---
export interface Props {
    src: string;
    alt: string;
    caption?: string;
    width?: number;
    height?: number;
    class?: string;
    loading?: "lazy" | "eager";
}

const {
    src,
    alt,
    caption,
    width,
    height,
    class: className = "",
    loading = "lazy",
} = Astro.props;
---

<figure class={`responsive-image ${className}`}>
    <img
        src={`/${src}`}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        class="w-full h-auto"
    />
    {
        caption && (
            <figcaption class="mt-2 text-sm text-gray-600 text-center italic">
                {caption}
            </figcaption>
        )
    }
</figure>

<style>
    .responsive-image {
        @apply mb-6;
    }

    .responsive-image img {
        @apply transition-transform duration-300;
    }

    /* Ensure proper contrast for captions */
    .responsive-image figcaption {
        @apply text-gray-700 dark:text-gray-300;
    }

    /* Focus styles for accessibility */
    .responsive-image img:focus {
        @apply outline-2 outline-offset-2 outline-primary-500;
    }
</style>
