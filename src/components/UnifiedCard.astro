---
import { formatDate } from "../utils";
import { linkHelpers } from "../i18n/links";
const { item, lang, t } = Astro.props;
---

<div
    class="news-item card relative max-w-sm p-0 bg-white border border-gray-200 rounded-lg shadow"
    data-type={item.type}
    data-title={item.data.title.toLowerCase()}
    data-date={item.data.date.getTime()}
    data-location={item.type === "event"
        ? ((item.data as any).location?.toLowerCase() ?? "")
        : ""}
    data-project={(item.data as any).project ?? ""}
>
    <!-- Badge -->
    <div class="absolute top-2 left-2 z-10">
        <span
            class={`badge text-white ${item.type === "news" ? "bg-slate-900" : "bg-emerald-700"}`}
        >
            {item.type === "news" ? t("badge.news") : t("badge.event")}
        </span>
    </div>
    <a
        href={item.type === "news"
            ? linkHelpers.press(lang, item.slug)
            : linkHelpers.event(lang, item.slug)}
        class="relative block h-48 overflow-hidden group rounded-t-lg"
    >
        <img
            class="h-full w-full object-cover transform transition duration-500 group-hover:scale-105"
            src={item.data.photo}
            alt={item.data.title}
        />
        <div
            class="absolute inset-0 bg-black bg-opacity-0 transition duration-500 group-hover:bg-opacity-30"
        >
        </div>
    </a>
    <div class="p-3">
        <div class="flex justify-between">
            <p class="text-sm">
                {formatDate(item.data.date, lang)}
            </p>
            <p class="text-sm">
                {item.type === "event" ? (item.data as any).location : ""}
            </p>
        </div>

        <h4 class="text-base">
            <a
                href={item.type === "news"
                    ? linkHelpers.press(lang, item.slug)
                    : linkHelpers.event(lang, item.slug)}
                class="hover:text-primary-600 text-gray-800 transition-colors duration-200"
            >
                {item.data.title}
            </a>
        </h4>
    </div>
</div>
