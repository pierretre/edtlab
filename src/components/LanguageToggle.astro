---
/**
 * Smart Language Toggle Component
 *
 * Features:
 * - Smart redirecting to corresponding translated pages
 * - Fallback to home page if no translation exists
 * - Accessible with proper ARIA labels and keyboard navigation
 * - Light mode optimized design
 * - Smooth transitions and hover effects
 */
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { languages } from "@i18n/ui";
import { getCorrespondingPage } from "@i18n/page-mapping";

const lang = getLangFromUrl(Astro.url) as "en" | "fr";
const t = useTranslations(lang);

// Extract current href from URL (without language prefix)
const currentHref = Astro.url.pathname
    .split("/")
    .filter((part) => part.length > 0)
    .slice(1) // Remove language prefix
    .join("/");
---

<div class="flex items-center space-x-2 text-sm font-medium text-gray-900">
    {
        Object.keys(languages).map((locale, index) => {
            const isActive = locale === lang;

            // Get the corresponding page in the target language
            const targetLang = locale as "en" | "fr";
            const correspondingHref = getCorrespondingPage(
                currentHref,
                lang,
                targetLang,
            );
            const targetUrl = correspondingHref
                ? `/${targetLang}/${correspondingHref}`
                : `/${targetLang}/`;

            return (
                <>
                    <a
                        href={targetUrl}
                        class={`transition-colors duration-150 ${
                            isActive
                                ? "text-primary-600 font-semibold underline underline-offset-4"
                                : "text-gray-700 hover:text-primary-500"
                        }`}
                        title={
                            isActive
                                ? t("language.current")
                                : t("language.switch-to").replace(
                                      "{lang}",
                                      locale.toUpperCase(),
                                  )
                        }
                    >
                        {locale.toUpperCase()}
                    </a>

                    {index < Object.keys(languages).length - 1 && (
                        <span class="text-gray-400 select-none">|</span>
                    )}
                </>
            );
        })
    }
</div>
