---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";
import JobOfferCard from "./JobOfferCard.astro";

interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get all job offers for the current language
const allJobOffers = await getCollection("job-offers", ({ data }) => {
    return data.lang === lang;
});

// Sort job offers by deadline (closest first) and then by title
const sortedJobOffers = allJobOffers.sort((a, b) => {
    // First, sort by deadline status (active deadlines first)
    const now = new Date();
    const aActive = a.data.deadline >= now;
    const bActive = b.data.deadline >= now;

    if (aActive && !bActive) return -1;
    if (!aActive && bActive) return 1;

    // Then by deadline date
    if (a.data.deadline.getTime() !== b.data.deadline.getTime()) {
        return a.data.deadline.getTime() - b.data.deadline.getTime();
    }

    // Finally by title
    return a.data.title.localeCompare(b.data.title);
});

// Get unique projects and types for filters
const projects = ["PC1", "PC2", "PC3", "PC4", "PC5", "General"] as const;
const types = ["postdoc", "phd", "engineer", "intern"] as const;

// Helper function to get type translation
const getTypeTranslation = (type: string) => {
    return t(`job-offers.type.${type}` as any);
};

// Helper function to get project translation
const getProjectTranslation = (project: string) => {
    if (project === "General") {
        return t("job-offers.project.general");
    }
    return project;
};

// Count active job offers
const activeJobOffers = sortedJobOffers.filter(
    (job) => job.data.deadline >= new Date(),
);
const expiredJobOffers = sortedJobOffers.filter(
    (job) => job.data.deadline < new Date(),
);
---

<div class="job-offers-container">
    <!-- Header with statistics -->
    <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between"
        >
            <div>
                <h2 class="text-lg font-semibold text-blue-900 mb-1">
                    {t("job-offers.current-opportunities")}
                </h2>
                <p class="text-blue-700 text-sm">
                    {
                        t("job-offers.active-count").replace(
                            "{count}",
                            activeJobOffers.length.toString(),
                        )
                    }
                    {
                        expiredJobOffers.length > 0 && (
                            <span class="ml-2 text-blue-600">
                                •{" "}
                                {t("job-offers.expired-count").replace(
                                    "{count}",
                                    expiredJobOffers.length.toString(),
                                )}
                            </span>
                        )
                    }
                </p>
            </div>
            <div class="mt-3 sm:mt-0">
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800"
                >
                    {
                        t("job-offers.total-positions").replace(
                            "{count}",
                            sortedJobOffers.length.toString(),
                        )
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="mb-6 p-4 bg-gray-50 rounded-lg border">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Project Filter -->
            <div>
                <label
                    for="project-filter"
                    class="block mb-2 text-sm font-medium text-gray-900"
                >
                    {t("job-offers.filter.project")}
                </label>
                <select
                    id="project-filter"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                >
                    <option value=""
                        >{t("job-offers.filter.all-projects")}</option
                    >
                    {
                        projects.map((project) => (
                            <option value={project}>
                                {getProjectTranslation(project)}
                            </option>
                        ))
                    }
                </select>
            </div>

            <!-- Type Filter -->
            <div>
                <label
                    for="type-filter"
                    class="block mb-2 text-sm font-medium text-gray-900"
                >
                    {t("job-offers.filter.type")}
                </label>
                <select
                    id="type-filter"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                >
                    <option value="">{t("job-offers.filter.all-types")}</option>
                    {
                        types.map((type) => (
                            <option value={type}>
                                {getTypeTranslation(type)}
                            </option>
                        ))
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div>
                <label
                    for="status-filter"
                    class="block mb-2 text-sm font-medium text-gray-900"
                >
                    {t("job-offers.filter.status")}
                </label>
                <select
                    id="status-filter"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                >
                    <option value="">{t("job-offers.filter.all-status")}</option
                    >
                    <option value="active"
                        >{t("job-offers.filter.active")}</option
                    >
                    <option value="expired"
                        >{t("job-offers.filter.expired")}</option
                    >
                </select>
            </div>

            <!-- Search Filter -->
            <div>
                <label
                    for="search-filter"
                    class="block mb-2 text-sm font-medium text-gray-900"
                >
                    {t("job-offers.filter.search")}
                </label>
                <input
                    type="text"
                    id="search-filter"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                    placeholder={t("job-offers.filter.search-placeholder")}
                />
            </div>
        </div>

        <!-- Clear Filters Button -->
        <div class="mt-4">
            <button
                id="clear-filters"
                class="text-blue-600 hover:text-blue-800 text-sm font-medium"
            >
                {t("job-offers.filter.clear")}
            </button>
        </div>
    </div>

    <!-- Job Offers Grid -->
    <div
        id="job-offers-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
        {
            sortedJobOffers.map((jobOffer) => {
                const isExpired = jobOffer.data.deadline < new Date();
                return (
                    <div
                        class="job-offer-item"
                        data-project={jobOffer.data.project}
                        data-type={jobOffer.data.type}
                        data-status={isExpired ? "expired" : "active"}
                        data-search-text={`${jobOffer.data.title} ${jobOffer.data.description} ${jobOffer.data.location} ${jobOffer.data.requirements.join(" ")}`.toLowerCase()}
                    >
                        <JobOfferCard jobOffer={jobOffer} lang={lang} />
                    </div>
                );
            })
        }
    </div>

    <!-- No Results Message -->
    <div id="no-results" class="hidden text-center py-12">
        <div class="max-w-md mx-auto">
            <svg
                class="mx-auto h-12 w-12 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2h8zM8 14v.01M12 14v.01M16 14v.01"
                ></path>
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">
                {t("job-offers.no-results")}
            </h3>
            <p class="mt-2 text-gray-500">
                {t("job-offers.no-results-description")}
            </p>
        </div>
    </div>

    <!-- Results Count -->
    <div class="mt-6 text-sm text-gray-600 text-center">
        <span id="results-count" data-template={t("job-offers.results-count")}>
            {
                t("job-offers.results-count").replace(
                    "{count}",
                    sortedJobOffers.length.toString(),
                )
            }
        </span>
    </div>
</div>

<script>
    // Client-side filtering functionality
    document.addEventListener("DOMContentLoaded", function () {
        const projectFilter = document.getElementById(
            "project-filter",
        ) as HTMLSelectElement;
        const typeFilter = document.getElementById(
            "type-filter",
        ) as HTMLSelectElement;
        const statusFilter = document.getElementById(
            "status-filter",
        ) as HTMLSelectElement;
        const searchFilter = document.getElementById(
            "search-filter",
        ) as HTMLInputElement;
        const clearFilters = document.getElementById(
            "clear-filters",
        ) as HTMLButtonElement;
        const grid = document.getElementById(
            "job-offers-grid",
        ) as HTMLDivElement;
        const noResults = document.getElementById(
            "no-results",
        ) as HTMLDivElement;
        const resultsCount = document.getElementById(
            "results-count",
        ) as HTMLSpanElement;
        const items = Array.from(
            document.querySelectorAll(".job-offer-item"),
        ) as HTMLDivElement[];

        function filterJobOffers() {
            const projectValue = projectFilter.value;
            const typeValue = typeFilter.value;
            const statusValue = statusFilter.value;
            const searchValue = searchFilter.value.toLowerCase().trim();

            let visibleCount = 0;

            items.forEach((item) => {
                const itemProject = item.dataset.project;
                const itemType = item.dataset.type;
                const itemStatus = item.dataset.status;
                const itemSearchText = item.dataset.searchText || "";

                const projectMatch =
                    !projectValue || itemProject === projectValue;
                const typeMatch = !typeValue || itemType === typeValue;
                const statusMatch = !statusValue || itemStatus === statusValue;
                const searchMatch =
                    !searchValue || itemSearchText.includes(searchValue);

                const shouldShow =
                    projectMatch && typeMatch && statusMatch && searchMatch;

                if (shouldShow) {
                    item.style.display = "";
                    visibleCount++;
                } else {
                    item.style.display = "none";
                }
            });

            // Update results count and show/hide no results message
            const template =
                resultsCount.dataset.template || "Showing {count} job offers";
            resultsCount.textContent = template.replace(
                "{count}",
                visibleCount.toString(),
            );

            if (visibleCount === 0) {
                grid.style.display = "none";
                noResults.style.display = "block";
            } else {
                grid.style.display = "";
                noResults.style.display = "none";
            }
        }

        function clearAllFilters() {
            projectFilter.value = "";
            typeFilter.value = "";
            statusFilter.value = "";
            searchFilter.value = "";
            filterJobOffers();
        }

        // Add event listeners
        projectFilter.addEventListener("change", filterJobOffers);
        typeFilter.addEventListener("change", filterJobOffers);
        statusFilter.addEventListener("change", filterJobOffers);
        searchFilter.addEventListener("input", filterJobOffers);
        clearFilters.addEventListener("click", clearAllFilters);
    });
</script>

<style>
    .job-offers-container {
        @apply w-full;
    }

    .job-offer-item {
        transition: opacity 0.2s ease;
    }

    #job-offers-grid {
        min-height: 200px;
    }
</style>
