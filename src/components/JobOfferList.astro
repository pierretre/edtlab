---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
import JobOfferCard from "./JobOfferCard.astro";
import FilterSidebar from "./FilterSidebar.astro";
import { jobOffersFilterConfig } from "@utils/filter-configs";

interface Props {
    lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get all job offers for the current language
const allJobOffers = await getCollection(
    "job-offers",
    ({ data }) => data.lang === lang,
);

// Sort job offers by availability status, then by expected start date (chronological)
const sortedJobOffers = allJobOffers.sort((a, b) => {
    // For positions with same availability, sort by expected start date (chronological)
    if (a.data.publishedDate.getTime() !== b.data.publishedDate.getTime()) {
        return b.data.publishedDate.getTime() - a.data.publishedDate.getTime();
    }

    // Finally by title
    return a.data.title.localeCompare(b.data.title);
});

// Count available and filled job offers
const availableJobOffers = sortedJobOffers.filter((job) => !job.data.filled);
const filledJobOffers = sortedJobOffers.filter((job) => job.data.filled);
---

<div class="w-full mb-12">
    <!-- Header with statistics -->
    <div class="mb-6 p-4 bg-primary-50 rounded-lg border border-primary-200">
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between"
        >
            <div>
                <h2 class="text-lg font-semibold text-primary-800 mb-1">
                    {t("job-offers.current-opportunities")}
                </h2>
                <p class="text-primary-600 text-sm font-bold mb-0">
                    {
                        t("job-offers.available-count").replace(
                            "{count}",
                            availableJobOffers.length.toString(),
                        )
                    }
                    {
                        filledJobOffers.length > 0 && (
                            <span class="ml-2 font-normal">
                                •{" "}
                                {t("job-offers.filled-count").replace(
                                    "{count}",
                                    filledJobOffers.length.toString(),
                                )}
                            </span>
                        )
                    }
                </p>
            </div>
            <div class="mt-3 sm:mt-0">
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-100 text-primary-600"
                >
                    {
                        t("job-offers.total-positions").replace(
                            "{count}",
                            sortedJobOffers.length.toString(),
                        )
                    }
                </span>
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Filter Sidebar -->
        <FilterSidebar
            filters={jobOffersFilterConfig.filters}
            lang={lang}
            clearButtonText={t("filter.clear")}
        />

        <main class="flex-1">
            <!-- Results Count -->
            <div class="mb-6 text-sm text-gray-600 text-center">
                <span
                    id="results-count"
                    data-template={t("job-offers.results-count")}
                >
                    {
                        t("job-offers.results-count").replace(
                            "{count}",
                            sortedJobOffers.length.toString(),
                        )
                    }
                </span>
            </div>

            <!-- Job Offers Grid -->
            <div id="job-offers-grid" class="grid grid-cols-1 gap-6 min-h-48">
                {
                    sortedJobOffers.map((jobOffer) => (
                        <JobOfferCard
                            item={jobOffer.data}
                            lang={lang}
                            t={t}
                            slug={jobOffer.slug}
                        />
                    ))
                }
            </div>
        </main>

        <!-- No Results Message -->
        <div id="no-results" class="hidden text-center py-32">
            <div class="max-w-md mx-auto">
                <h3 class="mt-4 text-lg font-medium text-gray-900">
                    {t("job-offers.no-results")}
                </h3>
                <p class="mt-2 text-gray-500">
                    {t("job-offers.no-results-description")}
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    import { FilterManagerImpl } from "@utils/filtering";
    import { jobOffersFilterConfig } from "@utils/filter-configs";

    // Initialize filter manager when DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
        const filterManager = new FilterManagerImpl(jobOffersFilterConfig);
        filterManager.initialize();
    });
</script>

<style>
    .job-offer-item {
        transition: opacity 0.2s ease;
    }

    .job-offer-item.hidden {
        display: none;
    }
</style>
