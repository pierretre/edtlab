---
export interface Props {
    project: string;
}

const PROJECT_COLORS = {
    PC1: "bg-blue-bell-200 text-blue-bell-900",
    PC2: "bg-blue-bell-200 text-blue-bell-900",
    PC3: "bg-blue-bell-200 text-blue-bell-900",
    PC4: "bg-hit-pink-200 text-hit-pink-900",
    PC5: "bg-marzipan-200 text-marzipan-900",
    default: "bg-gray-200 text-gray-900 border-gray-400",
} as const;

const { project } = Astro.props as Props;

const color =
    PROJECT_COLORS[project as keyof typeof PROJECT_COLORS] ||
    PROJECT_COLORS.default;
---

<span
    class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${color}`}
>
    {project}
</span>
