---
import { formatDate } from "@utils/date";
import PageLayout from "./PageLayout.astro";
import type { NewsItem } from "@models/NewsItem.model";
import { linkHelpers, useTranslations } from "@i18n/utils";
import Badge from "@components/Badge.astro";
import AddToCalendarButton from "@components/AddToCalendarButton.astro";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
    frontmatter: NewsItem;
}

const { frontmatter } = Astro.props;
const lang = frontmatter.lang as "en" | "fr";
const t = useTranslations(lang);

// Load cover image if provided
let coverImage: ImageMetadata | undefined;
if (frontmatter.photo) {
    try {
        const images = import.meta.glob<{ default: ImageMetadata }>(
            "/public/media/uploads/*.{jpeg,jpg,png,gif,webp}",
        );
        coverImage = (await images[`/public${frontmatter.photo}`]()).default;
    } catch (error) {
        console.warn(`Could not load cover image: ${frontmatter.photo}`);
    }
}

const badges = [
    frontmatter.newsType,
    ...(frontmatter.tags || []).filter((tag) => tag && tag.trim()),
];
---

<PageLayout
    title={frontmatter.title}
    description={frontmatter.description || t("site.description")}
    lang={lang as "en" | "fr"}
    showBreadcrumb={true}
    showToc={true}
>
    <!-- Back to News link -->
    <div class="mb-6">
        <a
            href={linkHelpers.page(lang, "news")}
            class="inline-flex items-center text-primary-600 hover:text-primary-800 text-sm font-medium"
        >
            <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            {t("news-item.back-to-news")}
        </a>
    </div>

    <!-- newsHeader -->
    <header class="mb-8 space-y-4">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2">
            {badges.map((badge) => <Badge key={badge} t={t} />)}
        </div>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-900">
            {frontmatter.title}
        </h1>

        <!-- Meta Information -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6 bg-gray-50 rounded-lg border"
        >
            {
                frontmatter.newsType === "event" && frontmatter.location ? (
                    <div class="flex items-center text-gray-700">
                        <svg
                            class="w-5 h-5 mr-3 text-gray-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                        </svg>
                        <div>
                            <span class="text-sm font-medium text-gray-500">
                                {t("news-item.location")}
                            </span>
                            <p class="font-medium my-0">
                                {frontmatter.location}
                            </p>
                        </div>
                    </div>
                ) : null
            }
            <div class="flex items-center text-gray-700">
                <svg
                    class="w-5 h-5 mr-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <div>
                    <span class="text-sm font-medium text-gray-500"
                        >{t("news-item.date")}</span
                    >
                    <p class="font-medium my-0">
                        {formatDate(frontmatter.date, lang)}
                    </p>
                </div>
            </div>
        </div>

        <!-- Add to Calendar button -->
        {
            frontmatter.newsType === "event" && (frontmatter as any).icsPath ? (
                <div class="flex justify-start mt-2">
                    <AddToCalendarButton
                        icsPath={(frontmatter as any).icsPath}
                        label={t("news-item.add-to-calendar")}
                    />
                </div>
            ) : null
        }

        <!-- Cover Image -->
        {
            coverImage && (
                <figure class="mb-8 flex justify-center">
                    <Picture
                        src={coverImage}
                        format="webp"
                        alt={frontmatter.title}
                        loading="eager"
                        quality={80}
                        widths={[400, 800, 1200]}
                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 80vw, 1200px"
                        class="max-h-[400px] w-auto rounded-lg shadow-sm"
                    />
                </figure>
            )
        }
    </header>

    <!-- News Content -->
    <article class="news-content max-w-none">
        <slot />
    </article>
</PageLayout>
