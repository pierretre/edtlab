---
import { getCollection } from "astro:content";
import EventList from "../components/EventList.astro";
import { linkHelpers, useTranslations } from "../i18n/utils";
import { formatDate } from "../utils";
import PressReleaseCard from "../components/PressReleaseCard.astro";

const lang = Astro.props.lang || "en";
const t = useTranslations(lang);

// Load content
const events = (await getCollection("events")).filter(
    (event) => event.data.lang === lang,
);
const pressReleaseItems = (await getCollection("press-releases"))
    .filter((pressRelease) => pressRelease.data.lang === lang)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="container mx-auto max-w-7xl">
    <section class="mb-12">
        <!-- News Section -->
        <h2>News</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                pressReleaseItems.map((item) => (
                    <PressReleaseCard item={item} lang={lang} />
                ))
            }
        </div>
    </section>
    <section class="mb-12">
        <!-- Events Section -->
        <h2>Events</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                events.map((event) => (
                    <div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow hover:shadow-lg transition duration-300">
                        <img
                            class="rounded-t-lg h-48 w-full object-cover"
                            src={event.data.photo}
                            alt={event.data.title}
                        />
                        <div class="p-5">
                            <h5 class="text-xl font-bold mb-2">
                                {event.data.title}
                            </h5>
                            <p class="text-gray-700 mb-1">{event.data.date}</p>
                            <p class="text-gray-700 mb-3">
                                {event.data.location}
                            </p>
                            <p class="mt-2 text-gray-600">
                                {event.data.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
    <EventList
        lang={Astro.props.type === "news" ? "en" : "fr"}
        chronological={false}
        compact={false}
    />
</div>
