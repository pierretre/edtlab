---
import PageLayout from "./PageLayout.astro";
import { useTranslations } from "@i18n/utils";
import { getPortfolioGraph } from "@utils/portfolio-graph";
import PortfolioGraphViz from "@components/PortfolioGraphViz.astro";

export interface Props {
    frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
const lang = Astro.currentLocale as "en" | "fr";
const t = useTranslations(lang);
const graph = await getPortfolioGraph(lang);
---

<PageLayout
    title={frontmatter.title}
    description={frontmatter.description || t("site.description")}
    lang={lang}
    showBreadcrumb={true}
    showToc={false}
>
    <h1 class="text-4xl font-bold text-gray-900 mb-4">{frontmatter.title}</h1>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 mb-6">
        <slot />
    </div>

    <PortfolioGraphViz graph={graph} lang={lang} />
</PageLayout>
