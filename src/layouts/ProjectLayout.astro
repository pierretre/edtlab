---
import ProjectHero from "@components/ProjectHero.astro";
import TableOfContent from "@components/TableOfContent.astro";
import RelatedPublications from "@components/RelatedPublications.astro";
import RelatedJobOffers from "@components/RelatedJobOffers.astro";
import RelatedNews from "@components/RelatedNews.astro";
import FilledPhDComponent from "@components/FilledPhDComponent.astro";
import PrincipalInvestigatorWrapper from "@components/PrincipalInvestigatorWrapper.astro";
import PartnersGridWrapper from "@components/PartnersGridWrapper.astro";
import type { Project } from "@models/Project.model";
import { getLangFromUrl } from "@i18n/utils";

export interface Props {
    frontmatter: Project;
    headings?: { depth: number; slug: string; text: string }[];
    [key: string]: any;
}

const { frontmatter, headings } = Astro.props as Props;

const color = frontmatter?.color || "primary";
const illustration = frontmatter?.illustration || "";
const showToc = frontmatter?.toc;
const lang = getLangFromUrl(Astro.url) as "en" | "fr";

// Handle image import
let projectImage: ImageMetadata | undefined;
try {
    const images = import.meta.glob<{ default: ImageMetadata }>(
        "/src/assets/images/*.{eg,jpg,png,gif,webp}",
    );

    projectImage = (await images[illustration]()).default;
} catch (error) {
    console.warn(`Could not load image: ${illustration}`);
}

// Extract project ID from title (e.g., "PC1: Model Hybridization" -> "PC1")
const projectId =
    frontmatter?.projectId || frontmatter?.title?.match(/^(PC\d+|FP\d+)/)?.[1];
---

<div class="min-h-screen mb-16">
    <ProjectHero
        color={color}
        image={projectImage}
        imageAlt={frontmatter?.title || "Project Illustration"}
        title={frontmatter?.title || "Project"}
        description={frontmatter?.description || ""}
        projectId={projectId}
    />

    <div class="container mx-auto p-4 max-w-6xl">
        <!-- Main Content Area -->
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Table of Contents Sidebar -->
            {
                showToc && (
                    <TableOfContent projectId={projectId} headings={headings} />
                )
            }

            <!-- Main Content -->
            <main class="flex-1 min-w-0">
                <article
                    class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline"
                >
                    <slot />

                    <!-- Related Publications Section -->
                    <div class="mt-8 space-y-6">
                        <RelatedPublications project={projectId} />

                        <!-- Related Job Offers -->
                        <RelatedJobOffers project={projectId} />

                        <!-- Related News & Events -->
                        <RelatedNews project={projectId} />

                        <!-- Filled PhD Positions Section -->
                        <FilledPhDComponent lang={lang} project={projectId} />
                    </div>
                </article>
            </main>
        </div>
    </div>
</div>
