---
import ProjectHero from "../components/ProjectHero.astro";
import TableOfContent from "../components/TableOfContent.astro";
import RelatedPublications from "../components/RelatedPublications.astro";
import { useTranslations } from "../i18n/utils";

export interface Props {
    frontmatter?: {
        title: string;
        href: string;
        lang: string;
        description: string;
        toc: boolean;
        color: string;
        illustration: string;
        projectId?: string;
    };
    headings?: { depth: number; slug: string; text: string }[];
    [key: string]: any;
}

const t = useTranslations(
    (Astro.props.frontmatter?.lang as "en" | "fr") || "en",
);

const { frontmatter, headings } = Astro.props as Props;
const color = frontmatter?.color || "primary";
const illustration = frontmatter?.illustration || "";
const showToc = frontmatter?.toc;

// Handle image import
let projectImage: ImageMetadata | undefined;
try {
    const images = import.meta.glob<{ default: ImageMetadata }>(
        "/src/assets/images/*.{eg,jpg,png,gif,webp}",
    );

    projectImage = (await images[illustration]()).default;
} catch (error) {
    console.warn(`Could not load image: ${illustration}`);
}

// Extract project ID from title (e.g., "PC1: Model Hybridization" -> "PC1")
const projectId =
    frontmatter?.projectId || frontmatter?.title?.match(/^(PC\d+|FP\d+)/)?.[1];
---

<div class="min-h-screen bg-gray-50">
    <ProjectHero
        color={color}
        image={projectImage}
        imageAlt={frontmatter?.title || "Project Illustration"}
        title={frontmatter?.title || "Project"}
        description={frontmatter?.description || ""}
        projectId={projectId}
    />

    <div class="container mx-auto px-4 py-6 max-w-6xl">
        <!-- Main Content Area -->
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Main Content -->
            <main class="flex-1 min-w-0">
                <article>
                    <slot
                        class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline"
                    />

                    <!-- Related Publications Section -->
                    <div class="mt-8">
                        <RelatedPublications project={projectId} />
                    </div>

                    <!-- Project Resources Section -->
                    <div
                        class="bg-white rounded-lg shadow-sm p-6 border border-gray-200 mt-8"
                    >
                        <h2 class="font-semibold text-gray-900 mb-6">
                            {t("projects.project-resources.title")}
                        </h2>

                        <!-- Cards container -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <!-- Card 1 -->
                            <a
                                href={`/${frontmatter?.lang}/join-us`}
                                class="flex flex-col items-center justify-center bg-gray-50 hover:bg-gray-100 transition-all border border-gray-200 rounded-lg p-6"
                            >
                                <svg
                                    class="w-12 h-12 text-primary-600 mb-3"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                    ></path>
                                </svg>
                                <h3 class="text-primary-700">
                                    {
                                        t(
                                            "projects.project-resources.open-positions",
                                        )
                                    }
                                </h3>
                            </a>

                            <!-- Card 2 -->
                            <a
                                href={`/${frontmatter?.lang}/resources`}
                                class="flex flex-col items-center justify-center bg-gray-50 hover:bg-gray-100 transition-all border border-gray-200 rounded-lg p-6"
                            >
                                <svg
                                    class="w-12 h-12 text-primary-600 mb-3"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                    ></path>
                                </svg>
                                <h3 class="text-primary-700">
                                    {
                                        t(
                                            "projects.project-resources.tools-and-resources",
                                        )
                                    }
                                </h3>
                            </a>

                            <!-- Card 3 -->
                            <a
                                href={`/${frontmatter?.lang}/demo-center`}
                                class="flex flex-col items-center justify-center bg-gray-50 hover:bg-gray-100 transition-all border border-gray-200 rounded-lg p-6"
                            >
                                <svg
                                    class="w-12 h-12 text-primary-600 mb-3"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                                <h3 class="text-primary-700">
                                    {
                                        t(
                                            "projects.project-resources.demonstrators",
                                        )
                                    }
                                </h3>
                            </a>
                        </div>
                    </div>
                </article>
            </main>

            <!-- Table of Contents Sidebar -->
            {showToc && <TableOfContent headings={headings} />}
        </div>
    </div>
</div>
