---
import BaseLayout from "./BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Breadcrumb from "../components/Breadcrumb.astro";
import TableOfContent from "../components/TableOfContent.astro";

export interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
    lang?: "en" | "fr";
    showBreadcrumb?: boolean;
    showToc?: boolean;
}

const {
    title,
    description,
    image,
    canonical,
    noindex = false,
    lang: propLang,
    showBreadcrumb = true,
    showToc = false,
} = Astro.props;

// Get language from URL or use prop
const lang = propLang || (getLangFromUrl(Astro.url) as "en" | "fr");
const t = useTranslations(lang);
let finalBreadcrumbItems: Array<{ name: string; href?: string }> = [];

if (showBreadcrumb) {
    const currentPath = Astro.url.pathname;
    const pathSegments = currentPath
        .split("/")
        .filter((segment) => segment && segment !== lang);

    finalBreadcrumbItems = [{ name: t("nav.home"), href: `/${lang}/` }];

    // Build breadcrumb from path segments
    let currentHref = `/${lang}`;
    for (let i = 0; i < pathSegments.length; i++) {
        const segment = pathSegments[i];
        currentHref += `/${segment}`;

        // Get translated name for common segments
        const segmentKey = `breadcrumb.${segment}` as keyof typeof t;
        const segmentName =
            t(segmentKey) ||
            segment.charAt(0).toUpperCase() +
                segment.slice(1).replace("-", " ");

        const isLastItem = i === pathSegments.length - 1;
        // Don't add href for the last item (current page)
        finalBreadcrumbItems.push({
            name: isLastItem ? title : segmentName,
            href: isLastItem ? undefined : currentHref,
        });
    }
}

// Extract headings for TOC if enabled
let tocItems: Array<{ id: string; text: string; level: number }> = [];
if (showToc) {
    // This will be populated by the TOC component after content is rendered
    // For now, we'll pass the showToc flag to enable TOC generation
}
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonical={canonical}
    noindex={noindex}
    lang={lang}
>
    <div class="container mx-auto px-4 py-6 max-w-6xl">
        <!-- Breadcrumb Navigation -->
        {showBreadcrumb && <Breadcrumb items={finalBreadcrumbItems} />}

        <!-- Main Content Area -->
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Main Content -->
            <main class="flex-1 min-w-0">
                <article
                    class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline"
                >
                    <slot />
                </article>
            </main>

            <!-- Table of Contents Sidebar -->
            {showToc && <TableOfContent />}
        </div>
    </div>
</BaseLayout>
