---
import BaseLayout from "./BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Breadcrumb from "../components/Breadcrumb.astro";
import TableOfContent from "../components/TableOfContent.astro";
import {
    generateBreadcrumbStructuredData,
    type StructuredData,
} from "../utils/seo";

export interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
    lang?: "en" | "fr";
    showBreadcrumb?: boolean;
    showToc?: boolean;
    keywords?: string[];
    author?: string;
    publishedTime?: string;
    modifiedTime?: string;
    articleSection?: string;
    articleTag?: string[];
}

const {
    title,
    description,
    image,
    canonical,
    noindex = false,
    lang: propLang,
    showBreadcrumb = true,
    showToc = false,
    keywords = [],
    author,
    publishedTime,
    modifiedTime,
    articleSection,
    articleTag = [],
} = Astro.props;

// Get language from URL or use prop
const lang = propLang || (getLangFromUrl(Astro.url) as "en" | "fr");
const t = useTranslations(lang);
let finalBreadcrumbItems: Array<{ name: string; href?: string }> = [];
let structuredData: StructuredData[] = [];

if (showBreadcrumb) {
    const currentPath = Astro.url.pathname;
    const pathSegments = currentPath
        .split("/")
        .filter((segment) => segment && segment !== lang);

    finalBreadcrumbItems = [{ name: t("nav.home"), href: `/${lang}/` }];

    // Build breadcrumb from path segments
    let currentHref = `/${lang}`;
    for (let i = 0; i < pathSegments.length; i++) {
        const segment = pathSegments[i];
        currentHref += `/${segment}`;

        // Get translated name for common segments
        const segmentKey = `breadcrumb.${segment}` as keyof typeof t;
        const segmentName =
            t(segmentKey) ||
            segment.charAt(0).toUpperCase() +
                segment.slice(1).replace("-", " ");

        const isLastItem = i === pathSegments.length - 1;
        // Don't add href for the last item (current page)
        finalBreadcrumbItems.push({
            name: isLastItem ? title : segmentName,
            href: isLastItem ? undefined : currentHref,
        });
    }

    // Generate breadcrumb structured data
    const baseUrl =
        Astro.site?.toString().replace(/\/$/, "") || "http://localhost:4321";
    const breadcrumbItems = finalBreadcrumbItems
        .filter((item) => item.href)
        .map((item) => ({
            name: item.name,
            url: `${baseUrl}${item.href}`,
        }));

    if (breadcrumbItems.length > 0) {
        structuredData.push(generateBreadcrumbStructuredData(breadcrumbItems));
    }
}

// TOC will be generated by the TableOfContent component if showToc is enabled
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonical={canonical}
    noindex={noindex}
    lang={lang}
    structuredData={structuredData}
    keywords={keywords}
    author={author}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    articleSection={articleSection}
    articleTag={articleTag}
>
    <div class="container mx-auto px-4 py-6 max-w-6xl">
        <!-- Breadcrumb Navigation -->
        {showBreadcrumb && <Breadcrumb items={finalBreadcrumbItems} />}

        <!-- Main Content Area -->
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Main Content -->
            <main class="flex-1 min-w-0">
                <article
                    class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline"
                >
                    <slot />
                </article>
            </main>

            <!-- Table of Contents Sidebar -->
            {showToc && <TableOfContent />}
        </div>
    </div>
</BaseLayout>
