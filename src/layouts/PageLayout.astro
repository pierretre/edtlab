---
import TableOfContent from "@components/TableOfContent.astro";

// Import all components that can be used via directives
import PrincipalInvestigator from "@components/PrincipalInvestigator.astro";
import PartnersGrid from "@components/PartnersGrid.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import ColorTable from "@components/ColorTable.astro";
import ContactForm from "@components/ContactForm.astro";
import JobOfferList from "@components/JobOfferList.astro";
import NewsList from "@components/NewsList.astro";
import PublicationList from "@components/PublicationList.astro";
import OptimizedFigure from "@components/OptimizedFigure.astro";
import OutlinedCard from "@components/OutlinedCard.astro";
import Badge from "@components/Badge.astro";

export interface Props {
    frontmatter?: {
        title: string;
        href: string;
        lang: string;
        description: string;
        toc: boolean;
        color: string;
        illustration: string;
        projectId?: string;
    };
    headings?: { depth: number; slug: string; text: string }[];
    [key: string]: any;
}

const { frontmatter } = Astro.props;
const showToc = frontmatter?.toc;

// Component mapping for directive resolution
// Maps directive names (e.g., "PI") to actual Astro components
const components = {
    PI: PrincipalInvestigator,
    PartnersGrid,
    ProjectGrid,
    ColorTable,
    ContactForm,
    JobOfferList,
    NewsList,
    PublicationList,
    OptimizedFigure,
    OutlinedCard,
    Badge,
};

// TOC will be generated by the TableOfContent component if showToc is enabled
---

<div class="container mx-auto px-8 lg:px-4 max-w-6xl mb-16">
    <!-- Main Content Area -->
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Table of Contents Sidebar -->
        {showToc && <TableOfContent />}

        <!-- Main Content -->
        <main class="flex-1 min-w-0">
            <article
                class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline"
            >
                <slot {components} />
            </article>
        </main>
    </div>
</div>
