---
import BaseLayout from "./BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { linkHelpers } from "@i18n/links";
import { getCollection } from "astro:content";
import ProjectGrid from "@components/ProjectGrid.astro";
import Badge from "@components/Badge.astro";
import { Picture } from "astro:assets";
import { getPublicationTypeTranslation } from "@utils/translation";
import heroBackground from "@assets/images/INRIA_EDT_CBLOT_fond_herosection.jpg";
import heroIllustration from "@assets/images/INRIA_EDT_CBLOT_Illu_Herosection.png";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
    lang?: "en" | "fr";
}

const {
    title,
    description,
    image,
    canonical,
    noindex = false,
    lang: propLang,
} = Astro.props;

// Get language from URL or use prop
const lang = propLang || (getLangFromUrl(Astro.url) as "en" | "fr");
const t = useTranslations(lang);

// Get dynamic content from collections for enhanced front page
const news = await getCollection("news", ({ data }) => data.lang === lang);
const recentEvents = news.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const allPublications = await getCollection("publications", ({ data }) => data.origin === 'edt');
const recentPublications = allPublications.sort(
    (a, b) => b.data.year - a.data.year,
);

const allJobOffers = await getCollection(
    "job-offers",
    ({ data }) => !data.filled,
);
const activeJobOffers = allJobOffers;

// Count distinct published use cases (each use case can have en/fr entries
// sharing the same data.id, so dedupe by id like generateUseCasesStaticPaths does)
const publishedUseCases = await getCollection(
    "use-cases",
    ({ data }) => data.status === "published",
);
const useCasesCount = new Set(publishedUseCases.map((uc) => uc.data.id)).size;
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonical={canonical}
    noindex={noindex}
    lang={lang}
    showBreadcrumb={false}
>
    <!-- Enhanced Hero Section with Layered Digital Twin Visualization -->
    <section class="relative bg-[#313565] overflow-hidden">
        <!-- Background Pattern -->
        <div
            class="absolute lg:inset-y-0 lg:right-0 lg:w-2/3 opacity-90
        max-lg:inset-x-0
        max-lg:top-1/2
        max-lg:bottom-0
        max-lg:w-full
        max-lg:h-1/2"
        >
            <Picture
                src={heroBackground}
                alt=""
                class="h-full object-cover object-center max-lg:rotate-90 max-lg:scale-[2]"
                widths={[2400, 1920, 1280, 768]}
                sizes="(max-width: 2400px) 100vw, 100vw"
                quality={80}
                format="webp"
                loading="eager"
                decoding="sync"
            />
        </div>
        <div
            class="relative mx-auto max-w-[1600px] grid lg:grid-cols-5 gap-4 items-center min-h-[350px] lg:min-h-[400px]"
        >
            <div
                class="text-white z-10 lg:col-span-3 py-8 text-center lg:text-left p-4"
            >
                <h1
                    class="mb-6 text-5xl font-extrabold tracking-tight leading-none md:text-6xl lg:text-6xl text-white"
                >
                    {t("home.hero.title")}
                </h1>
                <p class="mb-10 text-xl font-normal text-gray-100 lg:text-2xl">
                    {t("home.hero.subtitle")}
                </p>

                <!-- Hero Action Button -->
                <div class="flex justify-center lg:justify-start">
                    <a
                        href={linkHelpers.page(lang, "program")}
                        class="inline-flex justify-center items-center py-3 px-4 text-lg font-medium text-center hover:text-[#313565] text-primary-700 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 transition-colors"
                    >
                        {t("home.hero.learn-more")}
                        <svg
                            class="ml-2 -mr-1 w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div
                class="relative z-10 flex items-center justify-center lg:justify-end lg:col-span-2 h-full"
            >
                <Picture
                    src={heroIllustration}
                    alt="Digital Twin Concept - Physical and Digital Layers"
                    class="h-full w-full"
                    pictureAttributes={{
                        class: "h-full w-full object-contain",
                    }}
                    widths={[1200, 1000, 800]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 70vw, 1200px"
                    quality={90}
                    format="webp"
                    loading="eager"
                    decoding="sync"
                />
            </div>
        </div>
    </section>

    <section class="bg-gray-50">
        <!-- Hero Statistics -->
        <div
            class="pt-12 px-4 mx-auto text-center md:max-w-screen-md lg:max-w-screen-lg lg:px-36 flex flex-wrap justify-center items-center text-gray-500 sm:justify-between"
        >
            <div class="mr-5 mb-5 lg:mb-0">
                <a
                    href={linkHelpers.page(lang, "focused-projects")}
                    class="text-2xl font-bold text-primary-600">5</a
                >
                <p class="text-sm">
                    {t("home.stats.focused-projects")}
                </p>
            </div>
            <div class="mr-5 mb-5 lg:mb-0">
                <a
                    href={linkHelpers.page(lang, "platform")}
                    class="text-2xl font-bold text-primary-600">1</a
                >
                <p class="text-sm">{t("home.stats.platform")}</p>
            </div>
            <div class="mr-5 mb-5 lg:mb-0">
                <a
                    href={linkHelpers.page(lang, "use-cases")}
                    class="text-2xl font-bold text-primary-600"
                    >{useCasesCount}</a
                >
                <p class="text-sm">{t("home.stats.use-cases")}</p>
            </div>
            <div class="mr-5 mb-5 lg:mb-0">
                <a
                    href={linkHelpers.page(lang, "publications")}
                    class="text-2xl font-bold text-primary-600"
                    >{recentPublications.length}</a
                >
                <p class="text-sm">{t("home.stats.publications")}</p>
            </div>
            <div class="mr-5 mb-5 lg:mb-0">
                <a
                    href={linkHelpers.page(lang, "join-us")}
                    class="text-2xl font-bold text-primary-600"
                    >{activeJobOffers.length}</a
                >
                <p class="text-sm">{t("home.stats.open-positions")}</p>
            </div>
        </div>

        <!-- Enhanced Navigation Tiles Section with Flowbite Cards -->
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
                <h2
                    class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900"
                >
                    {t("home.tiles.title")}
                </h2>
                <p class="font-light text-gray-500 lg:mb-16 sm:text-xl">
                    {t("home.tiles.subtitle")}
                </p>
            </div>

            <!-- Enhanced Tile Grid with Flowbite Card styling -->
            <ProjectGrid lang={lang} />
        </div>

        <!-- Dynamic Content Showcase Section -->
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
                <h2
                    class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900"
                >
                    {t("home.updates.title")}
                </h2>
                <p class="font-light text-gray-500 lg:mb-16 sm:text-xl">
                    {t("home.updates.subtitle")}
                </p>
            </div>

            <div
                class="grid gap-8 lg:grid-cols-3"
                style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))"
            >
                <!-- Recent Events -->
                {
                    recentEvents.length > 0 && (
                        <div class="bg-gray-50 rounded-lg p-6">
                            <div class="flex items-center mb-4">
                                <svg
                                    class="w-6 h-6 text-[#434672] mr-2"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    />
                                </svg>
                                <h3 class="text-xl font-bold text-gray-900">
                                    {t("home.updates.recent-events")}
                                </h3>
                            </div>
                            <div class="space-y-4">
                                {recentEvents.slice(0, 3).map((event) => (
                                    <div class="border-l-4 border-[#434672] pl-4">
                                        <h4 class="font-semibold text-gray-900 text-sm">
                                            {event.data.title}
                                        </h4>
                                        <p class="text-xs text-gray-500 mt-1">
                                            {new Date(
                                                event.data.date,
                                            ).toLocaleDateString(
                                                lang === "en"
                                                    ? "en-US"
                                                    : "fr-FR",
                                                {
                                                    year: "numeric",
                                                    month: "long",
                                                    day: "numeric",
                                                },
                                            )}
                                        </p>
                                        <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                                            {event.data.description}
                                        </p>
                                    </div>
                                ))}
                            </div>
                            <div class="mt-6">
                                <a
                                    href={linkHelpers.newsIndex(lang)}
                                    class="inline-flex items-center text-[#434672] hover:text-[#434672] font-medium text-sm transition-colors"
                                >
                                    {t("home.updates.view-all-events")}
                                    <svg
                                        class="ml-1 w-4 h-4"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    )
                }

                <!-- Recent Publications -->
                {
                    recentPublications.length > 0 && (
                        <div class="bg-gray-50 rounded-lg p-6">
                            <div class="flex items-center mb-4">
                                <svg
                                    class="w-6 h-6 text-[#434672] mr-2"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                    />
                                </svg>
                                <h3 class="text-xl font-bold text-gray-900">
                                    {t("home.updates.recent-publications")}
                                </h3>
                            </div>
                            <div class="space-y-4">
                                {recentPublications
                                    .slice(0, 3)
                                    .map((publication) => (
                                        <div class="border-l-4 border-[#434672] pl-4">
                                            <h4 class="font-semibold text-gray-900 text-sm">
                                                {publication.data.title}
                                            </h4>
                                            <p class="text-xs text-gray-500 mt-1">
                                                {publication.data.authors
                                                    .slice(0, 2)
                                                    .join(", ")}
                                                {publication.data.authors
                                                    .length > 2 &&
                                                    ` et al.`}{" "}
                                                • {publication.data.year}
                                            </p>
                                            <p class="text-xs text-[#434672] mt-1 capitalize">
                                                {getPublicationTypeTranslation(
                                                    publication.data.type,
                                                    lang,
                                                )}
                                                {publication.data.venue &&
                                                    ` • ${publication.data.venue}`}
                                            </p>
                                        </div>
                                    ))}
                            </div>
                            <div class="mt-6">
                                <a
                                    href={linkHelpers.page(
                                        lang,
                                        "publications",
                                    )}
                                    class="inline-flex items-center text-[#434672] hover:text-[#434672] font-medium text-sm transition-colors"
                                >
                                    {t("home.updates.view-all-publications")}
                                    <svg
                                        class="ml-1 w-4 h-4"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    )
                }

                <!-- Active Job Offers -->
                {
                    activeJobOffers.length > 0 && (
                        <div class="bg-gray-50 rounded-lg p-6">
                            <div class="flex items-center mb-4">
                                <svg
                                    class="w-6 h-6 text-[#434672] mr-2"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                    />
                                </svg>
                                <h3 class="text-xl font-bold text-gray-900">
                                    {t("home.updates.open-positions")}
                                </h3>
                            </div>
                            <div class="space-y-4">
                                {activeJobOffers.slice(0, 3).map((job) => (
                                    <div class="border-l-4 border-[#434672] pl-4">
                                        <h4 class="font-semibold text-gray-900 text-sm">
                                            {job.data.title}
                                        </h4>
                                        <div class="flex items-center gap-2 mt-1 flex-wrap">
                                            {(job.data.tags || [])
                                                .filter(
                                                    (tag) => tag && tag.trim(),
                                                )
                                                .map((tag) => (
                                                    <Badge key={tag} t={t} />
                                                ))}
                                            <Badge
                                                key={`job-offers.type.${job.data.type}`}
                                                t={t}
                                            />
                                        </div>
                                        <p class="text-xs text-gray-500 mt-1">
                                            {job.data.location} •{" "}
                                            {t("job-offers.expected-start")}:{" "}
                                            {job.data.expectedStartDate}
                                        </p>
                                    </div>
                                ))}
                            </div>
                            <div class="mt-6">
                                <a
                                    href={linkHelpers.careers(lang)}
                                    class="inline-flex items-center text-[#434672] hover:text-[#434672] font-medium text-sm transition-colors"
                                >
                                    {t("home.updates.view-all-positions")}
                                    <svg
                                        class="ml-1 w-4 h-4"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </section>
</BaseLayout>
