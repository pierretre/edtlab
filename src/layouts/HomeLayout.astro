---
import BaseLayout from "./BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { linkHelpers } from "../i18n/links";
import { getCollection } from "astro:content";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
    lang?: "en" | "fr";
}

const {
    title,
    description,
    image,
    canonical,
    noindex = false,
    lang: propLang,
} = Astro.props;

// Get language from URL or use prop
const lang = propLang || (getLangFromUrl(Astro.url) as "en" | "fr");
const t = useTranslations(lang);

// Get dynamic content from collections for enhanced front page
const allEvents = await getCollection("events", ({ data }) => data.lang === lang);
const recentEvents = allEvents
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3);

const allPublications = await getCollection("publications");
const recentPublications = allPublications
    .sort((a, b) => b.data.year - a.data.year)
    .slice(0, 3);

const allJobOffers = await getCollection("job-offers", ({ data }) => {
    return data.lang === lang && new Date(data.deadline) > new Date();
});
const activeJobOffers = allJobOffers.slice(0, 3);

const pages = await getCollection("pages", ({ data }) => data.lang === lang);
const projects = pages
    .filter(page => page.filePath?.includes('focused-projects/fp'))
    .sort((a, b) => a.data.href.localeCompare(b.data.href));
    
const colorMap: Record<string, string> = {
    'blue-bell': 'header-blue-bell',
    'hit-pink': 'header-hit-pink',
    'marzipan': 'header-marzipan',
};

const tiles = projects.map(project => {
    return {
        name: project.data.title,
        slug: project.data.href,
        description: project.data.description,
        backgroundColor: project.data.color ? colorMap[project.data.color] || 'bg-gray-100' : 'bg-gray-100'
    };
});
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonical={canonical}
    noindex={noindex}
    lang={lang}
    showBreadcrumb={false}
>
    <!-- Enhanced Hero Section with Flowbite Hero styling -->
    <section class="bg-white">
        <div class="py-8 px-4 mx-auto max-w-screen-xl text-center lg:py-16 lg:px-12">
          
            <!-- Main Hero Content -->
            <h1 class="mb-4 text-4xl font-extrabold tracking-tight leading-none text-gray-900 md:text-5xl lg:text-6xl">
                {t('site.title')}
            </h1>
            <p class="mb-8 text-lg font-normal text-gray-500 lg:text-xl sm:px-16 xl:px-48">
                {t('home.hero.subtitle')}
            </p>
            
            <!-- Hero Action Buttons -->
            <div class="flex flex-col mb-8 lg:mb-16 space-y-4 sm:flex-row sm:justify-center sm:space-y-0 sm:space-x-4">
                <a href={linkHelpers.page(lang, 'program')} class="inline-flex justify-center btn-primary text-base font-medium rounded-lg">
                    {t('home.hero.learn-more')}
                    <svg class="ml-2 -mr-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                </a>
            </div>
            
            <!-- Hero Statistics -->
            <div class="px-4 mx-auto text-center md:max-w-screen-md lg:max-w-screen-lg lg:px-36">
                <div class="flex flex-wrap justify-center items-center mt-8 text-gray-500 sm:justify-between">
                    <div class="mr-5 mb-5 lg:mb-0 hover:text-gray-800 transition-colors">
                        <span class="text-2xl font-bold text-primary-600">5</span>
                        <p class="text-sm">{t('home.stats.focused-projects')}</p>
                    </div>
                    <div class="mr-5 mb-5 lg:mb-0 hover:text-gray-800 transition-colors">
                        <span class="text-2xl font-bold text-primary-600">40+</span>
                        <p class="text-sm">{t('home.stats.use-cases')}</p>
                    </div>
                    <div class="mr-5 mb-5 lg:mb-0 hover:text-gray-800 transition-colors">
                        <span class="text-2xl font-bold text-primary-600">{activeJobOffers.length}</span>
                        <p class="text-sm">{t('home.stats.open-positions')}</p>
                    </div>
                    <div class="mr-5 mb-5 lg:mb-0 hover:text-gray-800 transition-colors">
                        <span class="text-2xl font-bold text-primary-600">{recentPublications.length}+</span>
                        <p class="text-sm">{t('home.stats.publications')}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Enhanced Navigation Tiles Section with Flowbite Cards -->
    <section class="bg-gray-50">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
                <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900">
                    {t('home.tiles.title')}
                </h2>
                <p class="font-light text-gray-500 lg:mb-16 sm:text-xl">
                    {t('home.tiles.subtitle')}
                </p>
            </div>

            <!-- Enhanced Tile Grid with Flowbite Card styling -->
            <div class="grid gap-6 mb-6 lg:mb-16 md:grid-cols-2 lg:grid-cols-3">
                {tiles.map((tile, index) => (
                    <div class="group tile-card" data-index={index}>
                        <a 
                            href={linkHelpers.page(lang, tile.slug)}
                            class={`card block h-full p-6 ${tile.backgroundColor}`}
                            role="button"
                            tabindex="0"
                            aria-label={`${t('home.tiles.navigate-to')} ${tile.name}`}
                        >
                            <div class={"flex flex-col items-center text-center h-full"}>
                               
                                <!-- Enhanced Title -->
                                <h3 class="mb-3 text-xl font-bold text-white group-hover:text-primary-100 transition-colors duration-300">
                                    {tile.name}
                                </h3>
                                
                                <!-- Enhanced Description -->
                                <p class="text-white leading-relaxed flex-grow text-center">
                                    {tile.description}
                                </p>
                                
                                <!-- Enhanced Call-to-action -->
                                <div class="mt-6 flex items-center justify-center text-white group-hover:text-primary-100 transition-all duration-300">
                                    <span class="text-sm font-semibold mr-2 group-hover:mr-3 transition-all duration-300">
                                        {t('home.tiles.explore')}
                                    </span>
                                    <svg 
                                        class="w-5 h-5 transform group-hover:translate-x-2 transition-transform duration-300" 
                                        fill="currentColor" 
                                        viewBox="0 0 20 20" 
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path 
                                            fill-rule="evenodd" 
                                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" 
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </div>
                            </div>
                        </a>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Dynamic Content Showcase Section -->
    <section class="bg-white">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
                <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900">
                    {t('home.updates.title')}
                </h2>
                <p class="font-light text-gray-500 lg:mb-16 sm:text-xl">
                    {t('home.updates.subtitle')}
                </p>
            </div>

            <div class="grid gap-8 lg:grid-cols-3">
                <!-- Recent Events -->
                {recentEvents.length > 0 && (
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="flex items-center mb-4">
                            <svg class="w-6 h-6 text-primary-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <h3 class="text-xl font-bold text-gray-900">
                                {t('home.updates.recent-events')}
                            </h3>
                        </div>
                        <div class="space-y-4">
                            {recentEvents.map((event) => (
                                <div class="border-l-4 border-primary-500 pl-4">
                                    <h4 class="font-semibold text-gray-900 text-sm">
                                        {event.data.title}
                                    </h4>
                                    <p class="text-xs text-gray-500 mt-1">
                                        {new Date(event.data.date).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-FR', {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric'
                                        })}
                                    </p>
                                    <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                                        {event.data.description}
                                    </p>
                                </div>
                            ))}
                        </div>
                        <div class="mt-6">
                            <a href={linkHelpers.newsIndex(lang)} class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium text-sm transition-colors">
                                {t('home.updates.view-all-events')}
                                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                )}

                <!-- Recent Publications -->
                {recentPublications.length > 0 && (
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="flex items-center mb-4">
                            <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                            </svg>
                            <h3 class="text-xl font-bold text-gray-900">
                                {t('home.updates.recent-publications')}
                            </h3>
                        </div>
                        <div class="space-y-4">
                            {recentPublications.map((publication) => (
                                <div class="border-l-4 border-green-500 pl-4">
                                    <h4 class="font-semibold text-gray-900 text-sm">
                                        {publication.data.title}
                                    </h4>
                                    <p class="text-xs text-gray-500 mt-1">
                                        {publication.data.authors.slice(0, 2).join(', ')}
                                        {publication.data.authors.length > 2 && ` et al.`} • {publication.data.year}
                                    </p>
                                    <p class="text-xs text-primary-600 mt-1 capitalize">
                                        {publication.data.type}
                                        {publication.data.venue && ` • ${publication.data.venue}`}
                                    </p>
                                </div>
                            ))}
                        </div>
                        <div class="mt-6">
                            <a href={linkHelpers.page(lang, 'production/publications')} class="inline-flex items-center text-green-600 hover:text-green-700 font-medium text-sm transition-colors">
                                {t('home.updates.view-all-publications')}
                                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                )}

                <!-- Active Job Offers -->
                {activeJobOffers.length > 0 && (
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="flex items-center mb-4">
                            <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <h3 class="text-xl font-bold text-gray-900">
                                {t('home.updates.open-positions')}
                            </h3>
                        </div>
                        <div class="space-y-4">
                            {activeJobOffers.map((job) => (
                                <div class="border-l-4 border-purple-500 pl-4">
                                    <h4 class="font-semibold text-gray-900 text-sm">
                                        {job.data.title}
                                    </h4>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary-100 text-primary-600">
                                            {job.data.project}
                                        </span>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 capitalize">
                                            {job.data.type}
                                        </span>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-1">
                                        {job.data.location} • {t('job-offers.deadline')}: {new Date(job.data.deadline).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-FR')}
                                    </p>
                                </div>
                            ))}
                        </div>
                        <div class="mt-6">
                            <a href={linkHelpers.careers(lang)} class="inline-flex items-center text-purple-600 hover:text-purple-700 font-medium text-sm transition-colors">
                                {t('home.updates.view-all-positions')}
                                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                )}
            </div>
        </div>
    </section>

    <!-- Enhanced interaction styles with Flowbite compatibility -->
    <style>
        /* Smooth animations for reduced motion users */
        @media (prefers-reduced-motion: reduce) {
            .tile-card a {
                transform: none !important;
                transition: none !important;
            }
            
            .tile-card svg {
                transform: none !important;
                transition: none !important;
            }
            
            .tile-card {
                animation: none !important;
            }
        }
        
        
        /* High contrast mode support */
        @media (prefers-contrast: high) {
            .tile-card a {
                border-width: 3px;
            }
            
            .tile-card a:hover {
                border-color: #1D4ED8;
                background-color: #F8FAFC;
            }
            

        }
        
        /* Animation keyframes for tile entrance */
        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .tile-card {
            animation: slideInUp 0.6s ease-out forwards;
            opacity: 0;
        }
        
        /* Staggered animation delays */
        .tile-card[data-index="0"] { animation-delay: 0.1s; }
        .tile-card[data-index="1"] { animation-delay: 0.2s; }
        .tile-card[data-index="2"] { animation-delay: 0.3s; }
        .tile-card[data-index="3"] { animation-delay: 0.4s; }
        .tile-card[data-index="4"] { animation-delay: 0.5s; }
        .tile-card[data-index="5"] { animation-delay: 0.6s; }
        .tile-card[data-index="6"] { animation-delay: 0.7s; }
        .tile-card[data-index="7"] { animation-delay: 0.8s; }
        
        /* Line clamp utility for consistent text truncation */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        
        /* Responsive grid adjustments */
        @media (max-width: 768px) {
            .tile-card {
                animation-delay: 0.1s !important;
            }
        }
        
        /* Print styles */
        @media print {
            .tile-card a {
                transform: none !important;
                box-shadow: none !important;
                border: 1px solid #000 !important;
            }
        }
        
        /* Loading state for dynamic content */
        .content-loading {
            opacity: 0.6;
            pointer-events: none;
        }
        
        .content-loaded {
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.3s ease;
        }
    </style>

    <!-- Enhanced JavaScript for interactions and accessibility -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            // Enhanced keyboard navigation for tile cards
            const tileLinks = document.querySelectorAll('.tile-card a');
            const heroButtons = document.querySelectorAll('section a[href]');
            const dynamicContentLinks = document.querySelectorAll('.bg-gray-50 a[href]');
            
            // Tile interaction enhancements
            tileLinks.forEach((link, index) => {
                // Enhanced keyboard interaction feedback
                link.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        // Add visual feedback with scale animation
                        this.style.transform = 'translateY(-4px) scale(1.02)';
                        this.style.boxShadow = '0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)';
                        
                        setTimeout(() => {
                            this.style.transform = '';
                            this.style.boxShadow = '';
                            // Navigate to the link
                            window.location.href = this.href;
                        }, 200);
                    }
                });
                
                // Enhanced focus management
                link.addEventListener('focus', function() {
                    this.setAttribute('aria-describedby', `tile-description-${index}`);
                    // Announce to screen readers
                    const announcement = document.createElement('div');
                    announcement.setAttribute('aria-live', 'polite');
                    announcement.setAttribute('aria-atomic', 'true');
                    announcement.className = 'sr-only';
                    announcement.textContent = `Focused on ${this.getAttribute('aria-label')}`;
                    document.body.appendChild(announcement);
                    setTimeout(() => document.body.removeChild(announcement), 1000);
                });
                
                link.addEventListener('blur', function() {
                    this.removeAttribute('aria-describedby');
                });
                
                // Mouse interaction enhancements
                link.addEventListener('mouseenter', function() {
                    // Preload the target page for faster navigation
                    if ('requestIdleCallback' in window) {
                        requestIdleCallback(() => {
                            const linkElement = document.createElement('link');
                            linkElement.rel = 'prefetch';
                            linkElement.href = this.href;
                            document.head.appendChild(linkElement);
                        });
                    }
                });
            });
            
            // Hero button enhancements
            heroButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    // Add ripple effect
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;
                    
                    ripple.style.cssText = `
                        position: absolute;
                        width: ${size}px;
                        height: ${size}px;
                        left: ${x}px;
                        top: ${y}px;
                        background: rgba(255, 255, 255, 0.3);
                        border-radius: 50%;
                        transform: scale(0);
                        animation: ripple 0.6s linear;
                        pointer-events: none;
                    `;
                    
                    this.style.position = 'relative';
                    this.style.overflow = 'hidden';
                    this.appendChild(ripple);
                    
                    setTimeout(() => {
                        if (ripple.parentNode) {
                            ripple.parentNode.removeChild(ripple);
                        }
                    }, 600);
                });
            });
            
            // Intersection Observer for scroll animations
            if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -100px 0px'
                };
                
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('content-loaded');
                            entry.target.classList.remove('content-loading');
                        }
                    });
                }, observerOptions);
                
                // Observe dynamic content sections
                document.querySelectorAll('.bg-gray-50').forEach(section => {
                    section.classList.add('content-loading');
                    observer.observe(section);
                });
            }
            
            // Enhanced accessibility announcements
            const announcePageLoad = () => {
                const announcement = document.createElement('div');
                announcement.setAttribute('aria-live', 'polite');
                announcement.setAttribute('aria-atomic', 'true');
                announcement.className = 'sr-only';
                announcement.textContent = document.querySelector('h1').textContent + ' page loaded successfully';
                document.body.appendChild(announcement);
                setTimeout(() => {
                    if (announcement.parentNode) {
                        document.body.removeChild(announcement);
                    }
                }, 2000);
            };
            
            // Announce page load for screen readers
            setTimeout(announcePageLoad, 500);
            

            // Analytics tracking placeholder (will be implemented in task 21)
            const trackInteraction = (element, action) => {
                // Future analytics implementation
                console.log(`Interaction tracked: ${action} on ${element.href || element.textContent}`);
            };
            
            // Track tile clicks
            tileLinks.forEach(link => {
                link.addEventListener('click', () => trackInteraction(link, 'tile_click'));
            });
            
            // Track hero button clicks
            heroButtons.forEach(button => {
                button.addEventListener('click', () => trackInteraction(button, 'hero_button_click'));
            });
            
            // Track dynamic content link clicks
            dynamicContentLinks.forEach(link => {
                link.addEventListener('click', () => trackInteraction(link, 'dynamic_content_click'));
            });
        });
        
        // Add ripple animation CSS
        const style = document.createElement('style');
        style.textContent = `
            @keyframes ripple {
                to {
                    transform: scale(4);
                    opacity: 0;
                }
            }
            
            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }
            
            .sr-only:focus {
                position: static;
                width: auto;
                height: auto;
                padding: inherit;
                margin: inherit;
                overflow: visible;
                clip: auto;
                white-space: normal;
            }
        `;
        document.head.appendChild(style);
    </script>
</BaseLayout>