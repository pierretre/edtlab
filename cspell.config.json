{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en,fr",
    "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
    "dictionaries": ["fr-fr", "en_US", "project-terms"],
    "dictionaryDefinitions": [
        {
            "name": "project-terms",
            "path": ".cspell/project-terms.txt",
            "addWords": true
        }
    ],
    "ignorePaths": [
        "node_modules",
        "dist",
        ".astro",
        "coverage",
        "*.config.*",
        "*.lock",
        "src/test/**"
    ],
    "overrides": [
        {
            "filename": "**/*.mdx",
            "languageId": "mdx"
        }
    ],
    "ignoreRegExpList": [
        "/\"[a-z][a-z0-9]*(?:-[a-z0-9]+){2,}\"/g"
    ]
}
