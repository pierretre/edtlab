# Matomo Database Configuration
MYSQL_ROOT_PASSWORD=secure_root_password_change_me
MYSQL_DATABASE=matomo
MYSQL_USER=matomo
MYSQL_PASSWORD=secure_matomo_password_change_me

# Matomo Configuration
MATOMO_URL=https://analytics.yourdomain.com
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=your_auth_token_here

# GDPR Compliance
MATOMO_RESPECT_DNT=1
MATOMO_HONOR_DNT=1
MATOMO_ANONYMIZE_IP=1

# Development settings (set to 0 in production)
MATOMO_DEV_MODE=0