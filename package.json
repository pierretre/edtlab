{
  "name": "edtlab-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "npm-run-all --parallel dev proxy",
    "proxy": "npx decap-server",
    "build": "astro build",
    "build:prod": "NODE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts --max-warnings=0",
    "test": "vitest --run",
    "test:ci": "vitest --run --exclude src/test/content/spelling.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:ci": "vitest --run --coverage --exclude src/test/content/spelling.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/node": "^11.1.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.3",
    "@getbrevo/brevo": "^3.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.2.2",
    "dotenv": "^17.3.1",
    "flowbite": "^3.1.2",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.16",
    "baseline-browser-mapping": "^2.9.19",
    "cspell": "^9.7.0",
    "decap-server": "^3.1.3",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.49.1",
    "react": "^19.2.4",
    "sass-embedded": "^1.93.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
