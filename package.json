{
  "name": "edtlab-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "npm-run-all --parallel dev proxy",
    "proxy": "npx decap-server",
    "build": "astro build",
    "build:prod": "NODE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/mdx": "^4.3.8",
    "@astrojs/node": "^9.5.2",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^5.1.1",
    "@getbrevo/brevo": "^3.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.14.3",
    "flowbite": "^3.1.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^4.0.16",
    "decap-server": "^3.1.3",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.49.1",
    "sass-embedded": "^1.93.2",
    "vitest": "^4.0.16"
  }
}