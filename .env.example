# Application Environment
APP_ENV=production

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
LIST_INBOX=contact@edtlab.fr
SENDER_EMAIL=noreply@edtlab.fr
SENDER_NAME=EDT Research Program
BREVO_EXTERNAL_LIST_ID=your_brevo_external_list_id
BREVO_INTERNAL_LIST_ID=your_brevo_internal_list_id

# PhD Club contact form
PHD_CLUB_INBOX=your_phd_club_recipient_email

# GitHub OAuth for Decap CMS
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Matomo Analytics
MATOMO_URL=https://edtlab.fr/matomo/
MATOMO_SITE_ID=1
MATOMO_DB_ROOT_PASSWORD=your_secure_root_password
MATOMO_DB_PASSWORD=your_secure_matomo_password

# Site Configuration
SITE_URL=https://edtlab.fr

# MongoDB (HAL publications sync)
MONGODB_URI=mongodb://mongo:27017/edtlab
# The HAL sync runs as a script inside the container, not over the network.
# Trigger daily via crontab on the host, e.g.:
# 0 3 * * * docker exec edtlab_web node dist/scripts/sync-hal.mjs >> /var/log/hal-sync.log 2>&1
