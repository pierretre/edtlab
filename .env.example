# EDT Research Website Environment Configuration

# Matomo Analytics Configuration
MATOMO_URL=https://analytics.yourdomain.com
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=your_auth_token_here

# Anonymous Analytics Settings (No cookies used)
MATOMO_RESPECT_DNT=1
MATOMO_ANONYMIZE_IP=1
MATOMO_DISABLE_COOKIES=1

# Development Settings (set to 1 to enable analytics in development)
MATOMO_DEV_MODE=0

# Site Configuration
SITE_URL=https://yourdomain.com
SITE_NAME="EDT Research Program"

# Build Configuration
NODE_ENV=production