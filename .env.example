# Environment Configuration Template
# Copy this file to .env.production or .env.development and fill in your values

# Matomo Analytics Settings
MATOMO_URL=https://your-domain.com/matomo/
MATOMO_SITE_ID=1
MATOMO_ENABLE_COOKIES=false
MATOMO_RESPECT_DNT=false
MATOMO_ENABLE_HEARTBEAT=true
MATOMO_HEARTBEAT_TIMER=15

# Matomo Database Settings
MATOMO_DB_ROOT_PASSWORD=REDACTED_here
MATOMO_DB_PASSWORD=your_secure_db_password_here

# API Settings (Brevo Email Service)
BREVO_API_KEY=your_brevo_api_key_here
LIST_INBOX=contact@your-domain.com
SENDER_EMAIL=contact@your-domain.com
SENDER_NAME=EDT Research Program

# API URL for contact form (used by frontend)
PUBLIC_API_URL=http://localhost:8080